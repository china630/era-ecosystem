# syntax=docker/dockerfile:1
# Shared workspace packages — build once, reuse in satellites.
#   docker build -f docker/Dockerfile.packages -t era-ecosystem/packages:local .
FROM node:22-alpine AS builder
# Docker Desktop on this host often MITM-breaks Alpine/npm TLS.
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
WORKDIR /workspace
COPY packages/i18n-common packages/i18n-common
COPY packages/era-contracts packages/era-contracts
COPY packages/era-storage packages/era-storage
COPY packages/era-fiscal packages/era-fiscal
COPY packages/satellite-kit packages/satellite-kit
COPY packages/clinic-domain packages/clinic-domain
RUN npm config set strict-ssl false \
  && cd packages/i18n-common && for i in 1 2 3 4 5; do rm -rf node_modules && npm install && npm run build && break || sleep 15; done \
  && cd ../era-contracts && for i in 1 2 3 4 5; do rm -rf node_modules && npm install && npm run build && break || sleep 15; done \
  && cd ../era-storage && for i in 1 2 3 4 5; do rm -rf node_modules && npm install && npm run build && break || sleep 15; done \
  && cd ../era-fiscal && for i in 1 2 3 4 5; do rm -rf node_modules && npm install && npm run build && break || sleep 15; done \
  && cd ../satellite-kit && for i in 1 2 3 4 5; do rm -rf node_modules && npm install && npm run build && break || sleep 15; done \
  && cd ../clinic-domain && for i in 1 2 3 4 5; do rm -rf node_modules && npm install && npm run build && break || sleep 15; done

FROM node:22-alpine
WORKDIR /workspace/packages
COPY --from=builder /workspace/packages /workspace/packages
