# syntax=docker/dockerfile:1
# Requires: docker build -f docker/Dockerfile.packages -t era-ecosystem/packages:local .
#   docker build -f docker/Dockerfile.satellite --build-arg SATELLITE_DIR=era-logistics --build-arg SATELLITE_PORT=3205 .
ARG SATELLITE_DIR
ARG SATELLITE_PORT=3200

ARG PACKAGE_IMAGE=era-ecosystem/packages:local
FROM ${PACKAGE_IMAGE} AS pkg-build

FROM node:22-alpine AS base
# HTTPS apk can fail on Windows Docker Desktop ("TLS: server certificate not trusted").
RUN apk add --no-cache libc6-compat openssl wget \
  || (sed -i 's|https://|http://|g' /etc/apk/repositories && apk add --no-cache libc6-compat openssl wget)
WORKDIR /workspace

FROM base AS app-deps
ARG SATELLITE_DIR
COPY --from=pkg-build /workspace/packages ./packages
COPY ${SATELLITE_DIR}/package.json ${SATELLITE_DIR}/package-lock.json* ./${SATELLITE_DIR}/
WORKDIR /workspace/${SATELLITE_DIR}
# Docker Desktop on this host often MITM-breaks npm TLS (UNABLE_TO_VERIFY_LEAF_SIGNATURE).
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
RUN npm config set strict-ssl false \
  && for i in 1 2 3 4 5; do rm -rf node_modules && npm install --ignore-scripts && break || sleep 15; done

FROM base AS builder
ARG SATELLITE_DIR
COPY --from=pkg-build /workspace/packages ./packages
# Overlay current workspace packages so `compose build clinic` picks up kit
# changes without a separate packages-image rebuild.
COPY packages ./packages
# .dockerignore drops dist. Rebuild file: deps so satellite-kit sees current exports.
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
RUN npm config set strict-ssl false \
  && for pkg in era-contracts era-fiscal i18n-common era-storage satellite-kit; do \
       cd /workspace/packages/$pkg && npm install && npm run build || exit 1; \
     done
WORKDIR /workspace
COPY --from=app-deps /workspace/${SATELLITE_DIR}/node_modules ./${SATELLITE_DIR}/node_modules
COPY ${SATELLITE_DIR} ./${SATELLITE_DIR}
WORKDIR /workspace/${SATELLITE_DIR}
ARG NEXT_PUBLIC_FINANCE_WEB_URL
# Next inlines NEXT_PUBLIC_* at build. CI passes the public finance origin; without
# this ARG the hotel image drops it and City Ledger lookup fails at runtime.
ENV NEXT_PUBLIC_FINANCE_WEB_URL=${NEXT_PUBLIC_FINANCE_WEB_URL}
ENV NEXT_TELEMETRY_DISABLED=1
ENV NODE_TLS_REJECT_UNAUTHORIZED=0
# Dummy URL: generate + migrate diff use the datamodel, not a live DB.
ENV DATABASE_URL=postgresql://prisma:prisma@127.0.0.1:5432/prisma
RUN for i in 1 2 3 4 5; do ./node_modules/.bin/prisma generate && break || sleep 15; done \
  && ./node_modules/.bin/prisma migrate diff --from-empty --to-schema-datamodel prisma/schema.prisma --script > prisma/baseline.sql \
  && grep -q CREATE prisma/baseline.sql \
  && npm run build
# Nest cutover images pack the API runtime. Other satellites leave this empty
# and keep serving /api from Next on the public port.
RUN mkdir -p /opt/nest-runtime \
  && if [ -f nest/main.ts ]; then \
       mkdir -p /opt/nest-runtime/app \
       && cp -a nest src tsconfig.json package.json node_modules /opt/nest-runtime/app/ \
       && touch /opt/nest-runtime/enabled; \
     fi

FROM node:22-alpine AS runner
ARG SATELLITE_DIR
ARG SATELLITE_PORT
WORKDIR /app
ENV NODE_ENV=production
ENV ERA_IN_DOCKER=1
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=${SATELLITE_PORT}
RUN apk add --no-cache postgresql-client \
  || (sed -i 's|https://|http://|g' /etc/apk/repositories && apk add --no-cache postgresql-client)
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /workspace/${SATELLITE_DIR}/public ./public
COPY --from=builder /workspace/${SATELLITE_DIR}/.next/standalone ./
COPY --from=builder /workspace/${SATELLITE_DIR}/.next/static ./.next/static
COPY --from=builder /workspace/${SATELLITE_DIR}/prisma ./prisma
COPY docker/scripts/docker-migrate-deploy.mjs ./scripts/docker-migrate-deploy.mjs
COPY docker/scripts/satellite-entrypoint.sh /app/docker-entrypoint.sh
COPY docker/scripts/satellite-serve.sh /app/satellite-serve.sh
COPY docker/scripts/satellite-front.mjs /app/satellite-front.mjs
COPY --from=builder /opt/nest-runtime /opt/nest-runtime
COPY --from=builder /workspace/${SATELLITE_DIR}/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /workspace/${SATELLITE_DIR}/package.json ./package.json
COPY --from=builder /workspace/packages /packages
RUN mkdir -p ./node_modules/@era \
  && ln -sfn /packages/satellite-kit ./node_modules/@era/satellite-kit \
  && if [ -d /opt/nest-runtime/app/node_modules/@era ]; then \
       for link in /opt/nest-runtime/app/node_modules/@era/*; do \
         name=$(basename "$link"); \
         if [ -e "/packages/$name" ]; then ln -sfn "/packages/$name" "$link"; fi; \
       done; \
     fi \
  && sed -i 's/\r$//' /app/docker-entrypoint.sh /app/satellite-serve.sh \
  && chmod +x /app/docker-entrypoint.sh /app/satellite-serve.sh \
  && chown -R nextjs:nodejs /app /packages /opt/nest-runtime
USER nextjs
EXPOSE ${SATELLITE_PORT}
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT}/api/health || exit 1
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["/app/satellite-serve.sh"]
