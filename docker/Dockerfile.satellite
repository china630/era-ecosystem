# syntax=docker/dockerfile:1
# Requires: docker build -f docker/Dockerfile.packages -t era-ecosystem/packages:local .
#   docker build -f docker/Dockerfile.satellite --build-arg SATELLITE_DIR=era-logistics --build-arg SATELLITE_PORT=3205 .
ARG SATELLITE_DIR
ARG SATELLITE_PORT=3200

FROM era-ecosystem/packages:local AS pkg-build

FROM node:22-alpine AS base
RUN apk add --no-cache libc6-compat openssl wget
WORKDIR /workspace

FROM base AS app-deps
ARG SATELLITE_DIR
COPY --from=pkg-build /workspace/packages ./packages
COPY ${SATELLITE_DIR}/package.json ${SATELLITE_DIR}/package-lock.json* ./${SATELLITE_DIR}/
WORKDIR /workspace/${SATELLITE_DIR}
RUN npm install --ignore-scripts

FROM base AS builder
ARG SATELLITE_DIR
COPY --from=pkg-build /workspace/packages ./packages
COPY --from=app-deps /workspace/${SATELLITE_DIR}/node_modules ./${SATELLITE_DIR}/node_modules
COPY ${SATELLITE_DIR} ./${SATELLITE_DIR}
WORKDIR /workspace/${SATELLITE_DIR}
ENV NEXT_TELEMETRY_DISABLED=1
RUN for i in 1 2 3 4 5; do ./node_modules/.bin/prisma generate && break || sleep 15; done \
  && npm run build

FROM node:22-alpine AS runner
ARG SATELLITE_DIR
ARG SATELLITE_PORT
WORKDIR /app
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV HOSTNAME=0.0.0.0
ENV PORT=${SATELLITE_PORT}
RUN apk add --no-cache postgresql-client
RUN addgroup --system --gid 1001 nodejs && adduser --system --uid 1001 nextjs
COPY --from=builder /workspace/${SATELLITE_DIR}/public ./public
COPY --from=builder /workspace/${SATELLITE_DIR}/.next/standalone ./
COPY --from=builder /workspace/${SATELLITE_DIR}/.next/static ./.next/static
COPY --from=builder /workspace/${SATELLITE_DIR}/prisma ./prisma
COPY --from=builder /workspace/${SATELLITE_DIR}/scripts/docker-migrate-deploy.mjs ./scripts/docker-migrate-deploy.mjs
COPY --from=builder /workspace/${SATELLITE_DIR}/node_modules/.prisma ./node_modules/.prisma
COPY --from=builder /workspace/${SATELLITE_DIR}/package.json ./package.json
COPY --from=builder /workspace/${SATELLITE_DIR}/docker-entrypoint.sh /app/docker-entrypoint.sh
RUN sed -i 's/\r$//' /app/docker-entrypoint.sh && chmod +x /app/docker-entrypoint.sh \
  && chown -R nextjs:nodejs /app
USER nextjs
EXPOSE ${SATELLITE_PORT}
HEALTHCHECK --interval=30s --timeout=5s --start-period=90s --retries=3 \
  CMD wget -qO- http://127.0.0.1:${PORT}/api/health || exit 1
ENTRYPOINT ["/app/docker-entrypoint.sh"]
CMD ["node", "server.js"]
