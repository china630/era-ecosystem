generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  createdAt      DateTime @default(now())
  outlets        Outlet[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

enum ShiftStatus {
  OPEN
  CLOSED
}

enum ReceiptStatus {
  OPEN
  PAID
  VOID
}

enum ReceiptLineStatus {
  ACTIVE
  VOID
}

model Outlet {
  id             String     @id @default(cuid())
  organizationId String
  tenantId       String
  code           String
  name           String
  preset         String?
  tenant         Tenant     @relation(fields: [tenantId], references: [id])
  createdAt      DateTime   @default(now())
  registers      Register[]
  receipts       Receipt[]

  @@unique([tenantId, code])
  @@index([organizationId])
}

model Register {
  id             String    @id @default(cuid())
  organizationId String
  outletId       String
  code           String
  name           String
  outlet         Outlet    @relation(fields: [outletId], references: [id])
  shifts         Shift[]
  receipts       Receipt[]
  createdAt      DateTime  @default(now())

  @@unique([outletId, code])
  @@index([organizationId])
}

model Shift {
  id             String      @id @default(cuid())
  organizationId String
  registerId     String
  status         ShiftStatus @default(OPEN)
  openedAt       DateTime    @default(now())
  closedAt       DateTime?
  fiscalDeviceId String?     @map("fiscal_device_id")
  bankTerminalId String?     @map("bank_terminal_id")
  register       Register    @relation(fields: [registerId], references: [id])
  receipts       Receipt[]

  @@index([registerId, status])
  @@index([organizationId])
}

model Receipt {
  id                String        @id @default(cuid())
  organizationId    String
  outletId          String
  registerId        String
  shiftId           String
  status            ReceiptStatus @default(OPEN)
  amountNet         Decimal       @default(0) @db.Decimal(12, 2)
  subtotalAmount    Decimal       @default(0) @db.Decimal(12, 2)
  promoCode         String?
  discountPercent   Decimal?      @db.Decimal(5, 2)
  discountAmount    Decimal       @default(0) @db.Decimal(12, 2)
  customerPhone     String?
  loyaltyRef        String?
  fulfillmentType   String?
  pickupSlotKey     String?
  bopisScheduledAt  DateTime?
  paymentMethod     String?
  fiscalNumber      String?
  paidAt            DateTime?
  reservationId     String?
  roomNumber        String?
  settlementChannel String?
  originalReceiptId String?
  outlet            Outlet        @relation(fields: [outletId], references: [id])
  register          Register      @relation(fields: [registerId], references: [id])
  shift             Shift         @relation(fields: [shiftId], references: [id])
  originalReceipt   Receipt?      @relation("ReceiptReturn", fields: [originalReceiptId], references: [id])
  returnReceipts    Receipt[]     @relation("ReceiptReturn")
  lines             ReceiptLine[]
  createdAt         DateTime      @default(now())

  @@index([shiftId])
  @@index([originalReceiptId])
  @@index([organizationId])
}

model ReceiptLine {
  id             String            @id @default(cuid())
  organizationId String
  receiptId      String
  description    String
  qty            Int               @default(1)
  unitPrice      Decimal           @db.Decimal(12, 2)
  lineTotal      Decimal           @db.Decimal(12, 2)
  plu            String?
  barcode        String?
  isWeighted     Boolean           @default(false)
  weightKg       Decimal?          @db.Decimal(10, 3)
  size           String?
  color          String?
  serial         String?
  batch          String?
  rxRequired     Boolean           @default(false)
  rxApprovedBy   String?
  lineStatus     ReceiptLineStatus @default(ACTIVE)
  receipt        Receipt           @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
  @@index([organizationId])
}

model Role {
  id              String   @id @default(cuid())
  organizationId  String
  code            String
  name            String
  permissionsJson String   @default("[]")
  /// System package seeded by `ensureSystemRoles`; cannot be renamed or deleted.
  isSystem                 Boolean @default(false) @map("is_system")
  cloneFromCode            String? @map("clone_from_code")
  /// 0 = pre-matrix row; its `[]` is the column default and takes a template once.
  permissionCatalogVersion Int     @default(0) @map("permission_catalog_version")
  users           User[]

  @@unique([organizationId, code])
  @@index([organizationId])
}

model SatelliteAuditLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @map("user_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  changesJson    String   @default("{}") @map("changes_json")
  ipAddress      String?  @map("ip_address")
  integrityHash  String?  @map("integrity_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("satellite_audit_logs")
}

model User {
  id                String    @id @default(cuid())
  organizationId    String
  login             String
  email             String?
  phone             String?
  fullName          String
  passwordHash      String
  department        String?
  /** Job title cached from workforce provision (`positionTitle`). */
  positionTitle     String?
  roleId            String
  role              Role      @relation(fields: [roleId], references: [id])
  status            String    @default("ACTIVE")
  isCrossSystem     Boolean   @default(false) @map("is_cross_system")
  globalPersonId    String?   @map("global_person_id")
  financeEmployeeId String?   @unique @map("finance_employee_id")
  cpEmploymentId    String?   @unique @map("cp_employment_id")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")
  updatedAt         DateTime  @updatedAt @map("updated_at")
  logins            UserLogin[]

  @@unique([organizationId, login])
  @@unique([organizationId, phone])
  @@index([organizationId])
}

model UserLogin {
  id             String   @id @default(cuid())
  organizationId String
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  login          String
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, createdAt])
  @@index([userId])
  @@map("user_logins")
}

model OfflineReceiptQueue {
  id             String    @id @default(cuid())
  organizationId String
  clientId       String
  payloadJson    String
  status         String    @default("PENDING")
  syncedAt       DateTime?
  createdAt      DateTime  @default(now())

  @@index([status, createdAt])
  @@index([organizationId])
}

model MarketplaceWebhookEvent {
  id             String    @id @default(cuid())
  organizationId String
  channel        String
  externalRef    String
  payloadJson    String
  processedAt    DateTime?
  createdAt      DateTime  @default(now())

  @@index([channel, externalRef])
  @@index([organizationId])
}

model ProductCache {
  id             String   @id @default(cuid())
  organizationId String
  sku            String
  barcode        String?
  description    String
  unitPrice      Decimal  @db.Decimal(12, 2)
  syncedAt       DateTime @default(now())

  @@unique([organizationId, sku])
  @@index([barcode])
  @@index([sku])
  @@index([organizationId])
}
