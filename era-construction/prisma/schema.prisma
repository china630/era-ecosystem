generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  organizationId String @map("organization_id")
  code String
  name      String
  createdAt DateTime @default(now())
  outlets   Outlet[]
  @@unique([organizationId, code])
  @@index([organizationId])
}

model Outlet {
  id        String   @id @default(cuid())
  organizationId String @map("organization_id")
  tenantId  String
  code      String
  name      String
  preset    String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
  @@index([organizationId])
}

model Project {
  id                   String                @id @default(cuid())
  organizationId String @map("organization_id")
  code String
  name                 String
  progressActs         ProgressAct[]
  materialRequisitions MaterialRequisition[]
  boqLines             BoqLine[]
  dailyLogs            DailyLog[]
  punchListItems       PunchListItem[]
  subcontractorClaims  SubcontractorClaim[]
  projectTasks         ProjectTask[]
  equipmentLogs        EquipmentLog[]
  drawingRevisions     DrawingRevision[]
  timesheetEntries     TimesheetEntry[]
  createdAt            DateTime              @default(now())
  @@unique([organizationId, code])
  @@index([organizationId])
}

model ProjectTask {
  id          String    @id @default(cuid())
  organizationId String @map("organization_id")
  projectId   String
  name        String
  startDate   DateTime  @db.Date
  endDate     DateTime  @db.Date
  dependsOnId String?
  progressPct Int       @default(0)
  project     Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([organizationId])
}

model EquipmentLog {
  id           String   @id @default(cuid())
  organizationId String @map("organization_id")
  projectId    String
  equipmentCode String
  hours        Decimal  @db.Decimal(10, 2)
  logDate      DateTime @db.Date
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  @@index([projectId, logDate])
  @@index([organizationId])
}

model DrawingRevision {
  id          String   @id @default(cuid())
  organizationId String @map("organization_id")
  projectId   String
  drawingCode String
  revision    String
  fileName    String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([projectId, drawingCode])
  @@index([organizationId])
}

model TimesheetEntry {
  id              String   @id @default(cuid())
  organizationId String @map("organization_id")
  projectId       String
  workerRef       String
  cpEmploymentId  String?  @map("cp_employment_id")
  hours           Decimal  @db.Decimal(10, 2)
  workDate        DateTime @db.Date
  source          String   @default("CSV")
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())

  @@index([projectId, workDate])
  @@index([organizationId])
}

model DailyLog {
  id         String   @id @default(cuid())
  organizationId String @map("organization_id")
  projectId  String
  logDate    DateTime @db.Date
  weather    String?
  crewCount  Int?
  notes      String?
  reportedBy String?
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([projectId, logDate])
  @@index([organizationId])
}

model PunchListItem {
  id          String   @id @default(cuid())
  organizationId String @map("organization_id")
  projectId   String
  location    String
  description String
  status      String   @default("OPEN")
  photoUrl    String?
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([projectId, status])
  @@index([organizationId])
}

model SubcontractorClaim {
  id                String   @id @default(cuid())
  organizationId String @map("organization_id")
  projectId         String
  subcontractorName String
  amountNet         Decimal  @default(0) @db.Decimal(12, 2)
  status            String   @default("DRAFT")
  notes             String?
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())

  @@index([projectId, status])
  @@index([organizationId])
}

model BoqLine {
  id               String   @id @default(cuid())
  organizationId String @map("organization_id")
  projectId        String
  itemCode         String
  description      String
  plannedQty       Decimal  @db.Decimal(12, 3)
  plannedAmountNet Decimal  @default(0) @db.Decimal(12, 2)
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdAt        DateTime @default(now())

  @@unique([projectId, itemCode])
  @@index([projectId])
  @@index([organizationId])
}

model MaterialRequisition {
  id          String   @id @default(cuid())
  organizationId String @map("organization_id")
  projectId   String
  itemCode    String
  description String
  qty         Decimal  @db.Decimal(12, 3)
  status      String   @default("DRAFT")
  project     Project  @relation(fields: [projectId], references: [id])
  createdAt   DateTime @default(now())

  @@index([projectId, status])
  @@index([organizationId])
}

model ProgressAct {
  id         String    @id @default(cuid())
  organizationId String @map("organization_id")
  projectId  String
  periodKey  String?
  amountNet  Decimal   @db.Decimal(12, 2)
  status     String    @default("DRAFT")
  approvedAt DateTime?
  project    Project   @relation(fields: [projectId], references: [id])
  createdAt  DateTime  @default(now())

  @@index([projectId])
  @@index([organizationId])
}

model Role {
  id              String   @id @default(cuid())
  organizationId String @map("organization_id")
  code String
  name            String
  permissionsJson String   @default("[]")
  users           User[]
  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id              String    @id @default(cuid())
  organizationId String @map("organization_id")
  login String
  email           String?
  phone           String?   
  fullName        String
  passwordHash    String
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  status          String    @default("ACTIVE")
  isCrossSystem   Boolean   @default(false) @map("is_cross_system")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  @@unique([organizationId, login])
  @@unique([organizationId, phone])
  @@index([organizationId])
}
