{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "plugins": []
  },
  "include": ["nest/**/*.ts", "src/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
