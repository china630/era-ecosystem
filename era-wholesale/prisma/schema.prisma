generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  outlets   Outlet[]
}

enum B2BOrderStatus {
  DRAFT
  CONFIRMED
  SHIPPED
  CANCELLED
}

enum OrderChannel {
  B2B
  COUNTER
}

model Outlet {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  preset    String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
}

model B2BOrder {
  id                  String         @id @default(cuid())
  orderNumber         String         @unique
  buyerCounterpartyId String
  channel             OrderChannel   @default(B2B)
  status              B2BOrderStatus @default(DRAFT)
  amountNet           Decimal        @default(0) @db.Decimal(12, 2)
  lineCount           Int            @default(0)
  paymentMethod       String?
  paymentTermDays     Int?
  dueDate             DateTime?      @db.Date
  fiscalNumber        String?
  paidAt              DateTime?
  confirmedAt         DateTime?
  ttnNumber           String?
  ttnIssuedAt         DateTime?
  pickList            PickList?
  createdAt           DateTime       @default(now())
}

enum ImportPurchaseOrderStatus {
  DRAFT
  CONFIRMED
  CANCELLED
}

model ImportPurchaseOrder {
  id                      String                    @id @default(cuid())
  externalRef             String                    @unique
  supplierCounterpartyId  String?
  supplierVoen            String?
  currencyCode            String                    @default("USD")
  amountForeign           Decimal                   @db.Decimal(12, 2)
  paymentTermDays         Int                       @default(30)
  dueDate                 DateTime?                 @db.Date
  status                  ImportPurchaseOrderStatus @default(DRAFT)
  financePurchaseRef      String?
  lines                   ImportPurchaseOrderLine[]
  createdAt               DateTime                  @default(now())
  confirmedAt             DateTime?
}

model ImportPurchaseOrderLine {
  id              String              @id @default(cuid())
  importOrderId   String
  sku             String
  quantity        Decimal             @db.Decimal(12, 3)
  unitPriceForeign Decimal?           @db.Decimal(12, 2)
  importOrder     ImportPurchaseOrder @relation(fields: [importOrderId], references: [id], onDelete: Cascade)

  @@index([importOrderId])
}

model PickList {
  id        String         @id @default(cuid())
  orderId   String         @unique
  waveCode  String?
  status    String         @default("OPEN")
  order     B2BOrder       @relation(fields: [orderId], references: [id])
  lines     PickListLine[]
  createdAt DateTime       @default(now())

  @@index([waveCode])
}

model PickListLine {
  id         String   @id @default(cuid())
  pickListId String
  skuCode    String
  qtyOrdered Int
  qtyPicked  Int      @default(0)
  pickList   PickList @relation(fields: [pickListId], references: [id], onDelete: Cascade)

  @@index([pickListId])
}

model Role {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  permissionsJson String   @default("[]")
  users           User[]
}

model User {
  id              String    @id @default(cuid())
  login           String    @unique
  email           String?
  phone           String?   @unique
  fullName        String
  passwordHash    String
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  status          String    @default("ACTIVE")
  isCrossSystem   Boolean   @default(false) @map("is_cross_system")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
}
