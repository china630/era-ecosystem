// ERA MDM — global natural persons, legal entities, consent stubs (option B database).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum PersonAccessRequestStatus {
  PENDING
  GRANTED
  DENIED
}

enum PersonIdentifierType {
  AZ_FIN
  PASSPORT
  RESIDENCE_PERMIT
  NATIONAL_ID
  ERA_SURROGATE
}

enum IdentifierTrust {
  SELF_DECLARED
  DOCUMENT_SCANNED
  GOVERNMENT_VERIFIED
}

enum PersonSegment {
  CITIZEN
  FOREIGNER
  UNVERIFIED
}

enum BloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

enum MaritalStatus {
  SINGLE
  MARRIED
  DIVORCED
  WIDOWED
  OTHER
}

enum PersonAddressKind {
  REGISTRATION
  ACTUAL
}

enum StatisticalCategory {
  REFUGEE
  IDP
  MARTYR_FAMILY
  VETERAN
}

model GlobalNaturalPerson {
  id                String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  /// Legacy FIN blind index — kept for back-compat; canonical identifiers live in PersonIdentifier.
  finBlindIndex     String?             @unique @map("fin_blind_index")
  finCipher         String?             @map("fin_cipher")
  fullNameCipher    String?             @map("full_name_cipher")
  phoneCipher       String?             @map("phone_cipher")
  nationality       String?             @default("AZ")
  personSegment     PersonSegment       @default(UNVERIFIED) @map("person_segment")
  mergedIntoPersonId String?            @map("merged_into_person_id") @db.Uuid
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")
  identifiers       PersonIdentifier[]
  accessRequests    PersonAccessRequest[]
  accessGrants      PersonAccessGrant[]
  accessLogs        PersonAccessLog[]
  hrProfile         PersonHrProfile?
  addresses         PersonAddress[]
  mergedInto        GlobalNaturalPerson?  @relation("PersonMerge", fields: [mergedIntoPersonId], references: [id], onDelete: SetNull)
  mergedFrom        GlobalNaturalPerson[] @relation("PersonMerge")

  @@index([mergedIntoPersonId])
  @@map("global_natural_persons")
}

/// HR-only PII attributes (blood, marital, education, stats, photo). Finance reads via MDM API only.
model PersonHrProfile {
  id                      String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId                String                @unique @map("person_id") @db.Uuid
  bloodGroup              BloodGroup            @default(UNKNOWN) @map("blood_group")
  maritalStatus           MaritalStatus?        @map("marital_status")
  educationCipher         String?               @map("education_cipher")
  specialtyCipher         String?               @map("specialty_cipher")
  statisticalCategories   StatisticalCategory[] @default([]) @map("statistical_categories")
  photoStorageKey         String?               @map("photo_storage_key")
  createdAt               DateTime              @default(now()) @map("created_at")
  updatedAt               DateTime              @updatedAt @map("updated_at")
  person                  GlobalNaturalPerson   @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@map("person_hr_profiles")
}

model PersonAddress {
  id            String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId      String              @map("person_id") @db.Uuid
  kind          PersonAddressKind
  lineCipher    String              @map("line_cipher")
  cityCipher    String?             @map("city_cipher")
  regionCipher  String?             @map("region_cipher")
  postalCipher  String?             @map("postal_cipher")
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")
  person        GlobalNaturalPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, kind])
  @@index([personId])
  @@map("person_addresses")
}

model PersonIdentifier {
  id              String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId        String               @map("person_id") @db.Uuid
  type            PersonIdentifierType
  issuingCountry  String               @default("AZ") @map("issuing_country")
  valueCipher     String               @map("value_cipher")
  blindIndex      String               @map("blind_index")
  trust           IdentifierTrust      @default(SELF_DECLARED)
  isPrimary       Boolean              @default(false) @map("is_primary")
  createdAt       DateTime             @default(now()) @map("created_at")
  person          GlobalNaturalPerson  @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([type, issuingCountry, blindIndex])
  @@index([personId])
  @@map("person_identifiers")
}

model GlobalLegalEntity {
  id              String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  taxIdBlindIndex String   @unique @map("tax_id_blind_index")
  taxIdCipher     String   @map("tax_id_cipher")
  nameCipher      String   @map("name_cipher")
  organizationId  String?  @unique @map("organization_id") @db.Uuid
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@map("global_legal_entities")
}

model PersonAccessRequest {
  id               String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId         String                    @map("person_id") @db.Uuid
  requesterOrgId   String                    @map("requester_org_id") @db.Uuid
  purpose          String
  status           PersonAccessRequestStatus @default(PENDING)
  createdAt        DateTime                  @default(now()) @map("created_at")
  decidedAt        DateTime?                 @map("decided_at")
  person           GlobalNaturalPerson       @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([requesterOrgId, status])
  @@map("person_access_requests")
}

model PersonAccessGrant {
  id             String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId       String              @map("person_id") @db.Uuid
  granteeOrgId   String              @map("grantee_org_id") @db.Uuid
  grantedAt      DateTime            @default(now()) @map("granted_at")
  expiresAt      DateTime?           @map("expires_at")
  person         GlobalNaturalPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@unique([personId, granteeOrgId])
  @@map("person_access_grants")
}

model PersonAccessLog {
  id         String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  personId   String              @map("person_id") @db.Uuid
  actorOrgId String              @map("actor_org_id") @db.Uuid
  action     String
  metaJson   String?             @map("meta_json")
  createdAt  DateTime            @default(now()) @map("created_at")
  person     GlobalNaturalPerson @relation(fields: [personId], references: [id], onDelete: Cascade)

  @@index([personId, createdAt])
  @@map("person_access_logs")
}
