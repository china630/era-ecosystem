{
  "name": "@era365/database",
  "version": "0.0.1",
  "private": true,
  "main": "./index.cjs",
  "types": "./index.ts",
  "exports": {
    ".": {
      "types": "./index.ts",
      "require": "./index.cjs",
      "default": "./index.cjs"
    },
    "./generated/client": {
      "types": "./generated/client/index.d.ts",
      "default": "./generated/client/index.js"
    }
  },
  "scripts": {
    "build": "npx prisma generate && tsc -p tsconfig.runtime.json && node -e \"const fs=require('fs'),p=require('path');for(const f of fs.readdirSync('runtime-cjs/core').filter(x=>x.endsWith('.js'))){const fp=p.join('runtime-cjs/core',f);fs.writeFileSync(fp,fs.readFileSync(fp,'utf8').replaceAll('../../../generated/client','../../generated/client'));}\"",
    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.6.1",
    "pg": "^8.16.3",
    "prisma": "^7.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.15.21",
    "typescript": "^5.7.3"
  }
}
