/// Shared organizations table (ownerId for BUSINESS_OWNER / billing).
/// Operating mode of an organization: a standalone legal entity (own VOEN,
/// own fiscalization + accounting) or a department billed under a parent
/// (hotel) org. Operational data always stays owned by the org's own DB —
/// only money routing (fiscal/revenue) may be delegated to the parent.
enum OrgOperatingMode {
  STANDALONE
  DEPARTMENT
}

/// Where a given financial concern is settled: under the org itself (OWN) or
/// routed to the parent org (PARENT, e.g. hotel folio / hotel accounting).
enum OrgRouting {
  OWN
  PARENT
}

/// Holding report-access roles (distinct from OrganizationMembership UserRole).
enum HoldingAccessRole {
  OWNER
  ADMIN
  ACCOUNTANT
  VIEWER
}

model Organization {
  id                 String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name               String
  ownerId            String?       @map("owner_id") @db.Uuid
  taxIdBlindIndex    String?       @unique @map("tax_id_blind_index")
  taxIdCipher        String?       @map("tax_id_cipher")
  subscriptionPlan   String?       @map("subscription_plan")
  billingStatus      BillingStatus @default(ACTIVE) @map("billing_status")
  operatingMode      OrgOperatingMode @default(STANDALONE) @map("operating_mode")
  parentOrgId        String?       @map("parent_org_id") @db.Uuid
  /// Holding grouping for multi-entity consolidation — distinct from parentOrgId/DEPARTMENT money routing.
  holdingId          String?       @map("holding_id") @db.Uuid
  fiscalRouting      OrgRouting    @default(OWN) @map("fiscal_routing")
  revenueRouting     OrgRouting    @default(OWN) @map("revenue_routing")
  activeModules      String[]      @default([]) @map("active_modules")
  storageUsedBytes   BigInt        @default(0) @map("storage_used_bytes")
  currentCreditTier  TariffTier?   @map("current_credit_tier")
  accumulatedBalance Decimal       @default(0) @map("accumulated_balance") @db.Decimal(12, 2)
  billingPeriodKey   String?       @map("billing_period_key") @db.VarChar(7)
  whatsappAlertsUsed Int           @default(0) @map("whatsapp_alerts_used")
  ocrPagesUsed       Int           @default(0) @map("ocr_pages_used")
  currency           String        @default("AZN")
  settings           Json          @default("{}")
  drakarisClientId   String?       @unique @map("drakaris_client_id")
  deletedAt          DateTime?     @map("deleted_at") @db.Timestamptz(6)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")
  usageMeterEvents   UsageMeterEvent[]
  earlyAccessEvents  EarlyAccessEvent[]
  earlyAccessSignups EarlyAccessSignup[]
  auditLogs          AuditLog[]
  subscription       OrganizationSubscription?
  paymentOrders      PaymentOrder[]
  memberships        OrganizationMembership[]
  billingInvoiceItems BillingInvoiceItem[]
  notificationTemplates NotificationTemplate[]
  notificationOutboxEntries NotificationOutbox[]
  notificationDeliveryLogs NotificationDeliveryLog[]
  platformPaymentLinks PlatformPaymentLink[]
  platformPortalLinks PlatformPortalLink[]
  bookableResources BookableResource[]
  bookingSlots BookingSlot[]
  bookingAppointments BookingAppointment[]
  platformPromotions PlatformPromotion[]
  platformCustomDomains PlatformCustomDomain[]
  platformShipments PlatformShipment[]
  platformAuditLogs PlatformAuditLog[]
  platformIdempotencyRecords PlatformIdempotencyRecord[]
  platformLoyaltyLedger PlatformLoyaltyLedger[]
  satelliteEndpoints SatelliteEndpoint[]
  satelliteEntitlements OrganizationSatelliteEntitlement[]
  workforceAssignments WorkforceAssignment[]
  workforceEmployments WorkforceEmployment[]
  orgUnitCommercialLinks OrgUnitCommercialLink[]
  owner              User?         @relation("OrganizationOwner", fields: [ownerId], references: [id])
  parentOrg          Organization?  @relation("OrgParent", fields: [parentOrgId], references: [id])
  departments        Organization[] @relation("OrgParent")
  holding            Holding?       @relation(fields: [holdingId], references: [id], onDelete: SetNull)

  @@index([ownerId])
  @@index([parentOrgId])
  @@index([holdingId])
  @@map("organizations")
}

/// Platform identity (shared `users` table during control-plane migration).
