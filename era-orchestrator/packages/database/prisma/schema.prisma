// ERA 365 Control Plane — billing, identity RBAC, tenancy limits.
// Shares PostgreSQL with era-finance-core during migration (same table names / @@map).

generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum TariffTier {
  TIER_0
  TIER_1
  TIER_2
  TIER_3
}

enum BillingStatus {
  ACTIVE
  SOFT_BLOCK
  HARD_BLOCK
}

enum SubscriptionInvoiceStatus {
  DRAFT
  ISSUED
  PAID
  OVERDUE
  CANCELLED
}

enum PricingKind {
  FOUNDATION
  MODULE
  QUOTA
}

/** Commercial catalog row kind — satellite gate vs billable module vs platform add-on. */
enum PricingCatalogKind {
  SATELLITE
  MODULE
  ADDON
}

enum PaymentOrderStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum ReferralCommissionStatus {
  ACCRUED
  PAID
  CANCELLED
}

enum AccessRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum InviteStatus {
  PENDING
  ACCEPTED
  DECLINED
}

enum UserRole {
  OWNER
  ADMIN
  ACCOUNTANT
  USER
  PROCUREMENT
  AUDITOR
  WAREHOUSE_KEEPER
  HR_OFFICER
  HR_MANAGER
  DEPARTMENT_HEAD
  DIRECTOR
  PARTNER
}

enum DisputeStatus {
  EVIDENCE_REQUIRED
  EVIDENCE_REVIEW
  INCUMBENT_NOTIFIED
  COOLDOWN
  APPROVED
  REJECTED
  EXECUTED
  REVERTED
}

enum DisputeSeverity {
  SOFT
  HARD
}

enum SecurityMode {
  NORMAL
  DISPUTE
  POST_TRANSFER_LOCK
  ROLLBACK_IN_PROGRESS
  HARD_BLOCK_PLATFORM
}

enum NotificationMessageClass {
  FINANCIAL
  TRANSACTIONAL
  LIFECYCLE
  MARKETING
}

enum NotificationChannel {
  EMAIL
  WHATSAPP
  SMS
}

enum NotificationOutboxStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum PlatformPaymentLinkStatus {
  PENDING
  PAID
  EXPIRED
  CANCELLED
}

enum PlatformPortalLinkStatus {
  ACTIVE
  REVOKED
  EXPIRED
}

enum BookingAppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PlatformPromotionDiscountType {
  PERCENT
  FIXED_AZN
}

enum PlatformPromotionStatus {
  ACTIVE
  DISABLED
}

enum PlatformCustomDomainStatus {
  PENDING_DNS
  ACTIVE
  DISABLED
}

enum PlatformShipmentStatus {
  CREATED
  IN_TRANSIT
  DELIVERED
  CANCELLED
}

enum PermissionCategory {
  CORE
  BILLING
  ACCOUNTING
  SALES
  PURCHASES
  INVENTORY
  HR
  PSA
  CUSTOMS
  ADMIN
  REPORTING
  INTEGRATIONS
}

/// Per-tenant billing state (migrated from organizations.billing_status).
model TenantBilling {
  organizationId       String        @id @map("organization_id") @db.Uuid
  billingStatus        BillingStatus @default(ACTIVE) @map("billing_status")
  subscriptionPlan     String?       @map("subscription_plan")
  activeModules        String[]      @default([]) @map("active_modules")
  billingPeriodKey     String?       @map("billing_period_key") @db.VarChar(7)
  whatsappAlertsUsed   Int           @default(0) @map("whatsapp_alerts_used")
  ocrPagesUsed         Int           @default(0) @map("ocr_pages_used")
  accumulatedBalance   Decimal       @default(0) @map("accumulated_balance") @db.Decimal(12, 2)
  currentCreditTier    TariffTier?   @map("current_credit_tier")
  updatedAt            DateTime      @updatedAt @map("updated_at")

  @@map("tenant_billing")
}

model OrganizationSubscription {
  id                      String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId          String     @unique @map("organization_id") @db.Uuid
  currentTier             TariffTier @default(TIER_0) @map("current_tier")
  isTrial                 Boolean    @default(true) @map("is_trial")
  trialExpiresAt          DateTime?  @map("trial_expires_at") @db.Timestamptz(6)
  activatedPremiumModules String[]   @default([]) @map("activated_premium_modules")
  billingPeriodKey        String?    @map("billing_period_key") @db.VarChar(7)
  expiresAt               DateTime?  @map("expires_at") @db.Timestamptz(6)
  activeModules           String[]   @default([]) @map("active_modules")
  quotaOverrides          Json?      @map("quota_overrides")
  createdAt               DateTime   @default(now()) @map("created_at")
  updatedAt               DateTime   @updatedAt @map("updated_at")
  isBlocked               Boolean    @default(false) @map("is_blocked")
  customConfig            Json?      @map("custom_config")
  organization            Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("organization_subscriptions")
}

model SubscriptionInvoice {
  id             String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId         String                    @map("user_id") @db.Uuid
  amount         Decimal                   @db.Decimal(12, 2)
  status         SubscriptionInvoiceStatus
  date           DateTime                  @db.Date
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  periodStart    DateTime?                 @map("period_start") @db.Timestamptz(6)
  periodEnd      DateTime?                 @map("period_end") @db.Timestamptz(6)
  billingPeriod  String?                   @map("billing_period")
  pdfLink        String?                   @map("pdf_link")
  paymentOrderId String?                   @unique @map("payment_order_id") @db.Uuid
  items          BillingInvoiceItem[]
  paymentOrder   PaymentOrder?             @relation(fields: [paymentOrderId], references: [id])
  referralCommissions ReferralCommission[]

  @@index([userId])
  @@index([userId, date])
  @@index([userId, billingPeriod])
  @@map("subscription_invoices")
}

model BillingInvoiceItem {
  id                    String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  subscriptionInvoiceId String              @map("subscription_invoice_id") @db.Uuid
  organizationId        String              @map("organization_id") @db.Uuid
  description           String
  amount                Decimal             @db.Decimal(12, 2)
  subscriptionInvoice   SubscriptionInvoice @relation(fields: [subscriptionInvoiceId], references: [id], onDelete: Cascade)
  organization          Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([subscriptionInvoiceId])
  @@index([organizationId])
  @@map("billing_invoice_items")
}

model UsageMeterEvent {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  actionType     String       @map("action_type") @db.VarChar(64)
  quantity       Int          @default(1)
  unitCostAzn    Decimal      @map("unit_cost_azn") @db.Decimal(12, 4)
  balanceAfter   Decimal      @map("balance_after") @db.Decimal(12, 2)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("usage_meter_events")
}

model OrganizationModule {
  organizationId      String    @map("organization_id") @db.Uuid
  moduleKey           String    @map("module_key")
  priceSnapshot       Decimal   @map("price_snapshot") @db.Decimal(12, 2)
  activatedAt         DateTime  @default(now()) @map("activated_at")
  pendingDeactivation Boolean   @default(false) @map("pending_deactivation")
  cancelledAt         DateTime? @map("cancelled_at")
  accessUntil         DateTime? @map("access_until") @db.Timestamptz(6)
  trialExpiresAt      DateTime? @map("trial_expires_at") @db.Timestamptz(6)
  trialOverridden     Boolean   @default(false) @map("trial_overridden")

  @@id([organizationId, moduleKey])
  @@map("organization_modules")
}

model OrganizationBundle {
  organizationId      String   @map("organization_id") @db.Uuid
  bundleId            String   @map("bundle_id") @db.Uuid
  priceSnapshot       Decimal  @map("price_snapshot") @db.Decimal(12, 2)
  activatedAt         DateTime @default(now()) @map("activated_at")
  pendingDeactivation Boolean  @default(false) @map("pending_deactivation")
  cancelledAt         DateTime? @map("cancelled_at")
  accessUntil         DateTime? @map("access_until") @db.Timestamptz(6)
  bundle              PricingBundle @relation(fields: [bundleId], references: [id], onDelete: Restrict)

  @@id([organizationId, bundleId])
  @@map("organization_bundles")
}

model Pricing {
  id        String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key       String      @unique
  kind      PricingKind
  name      String
  amountAzn Decimal     @map("amount_azn") @db.Decimal(12, 2)
  unitSize  Int?        @map("unit_size")
  sortOrder Int         @default(0) @map("sort_order")
  createdAt DateTime    @default(now()) @map("created_at")
  updatedAt DateTime    @updatedAt @map("updated_at")

  @@map("pricing")
}

model PricingModule {
  id            String              @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  key           String              @unique
  name          String
  pricePerMonth Decimal             @map("price_per_month") @db.Decimal(12, 2)
  isPremium     Boolean             @default(false) @map("is_premium")
  sortOrder     Int                 @default(0) @map("sort_order")
  catalogKind   PricingCatalogKind  @default(MODULE) @map("catalog_kind")
  satelliteKey           String?             @map("satellite_key")
  trialEligibleInTrial   Boolean             @default(false) @map("trial_eligible_in_trial")
  satellite              Satellite?          @relation(fields: [satelliteKey], references: [key], onDelete: SetNull)
  createdAt     DateTime            @default(now()) @map("created_at")
  updatedAt     DateTime            @updatedAt @map("updated_at")

  @@index([catalogKind])
  @@index([satelliteKey])
  @@map("pricing_modules")
}

/** Industry satellite metadata (app gate keys `industry_*`). */
model Satellite {
  key         String          @id
  name        String
  verticalSlug String         @map("vertical_slug")
  sortOrder   Int             @default(0) @map("sort_order")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  modules     PricingModule[]
  endpoints   SatelliteEndpoint[]
  entitlements OrganizationSatelliteEntitlement[]

  @@map("satellites")
}

/// Owner-connected satellite trial row (materialized on Connect).
model OrganizationSatelliteEntitlement {
  organizationId  String       @map("organization_id") @db.Uuid
  satelliteKey    String       @map("satellite_key")
  trialExpiresAt  DateTime?    @map("trial_expires_at") @db.Timestamptz(6)
  trialOverridden Boolean      @default(false) @map("trial_overridden")
  connectedAt     DateTime     @default(now()) @map("connected_at") @db.Timestamptz(6)
  isTrial         Boolean      @default(true) @map("is_trial")
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  satellite       Satellite    @relation(fields: [satelliteKey], references: [key], onDelete: Restrict)

  @@id([organizationId, satelliteKey])
  @@index([organizationId])
  @@map("organization_satellite_entitlements")
}

/** Per-organization satellite instance URL + bridge secret for event fan-out. */
model SatelliteEndpoint {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  satelliteKey   String       @map("satellite_key")
  baseUrl        String       @map("base_url")
  secretCipher   String?      @map("secret_cipher")
  enabled        Boolean      @default(true)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  satellite      Satellite?   @relation(fields: [satelliteKey], references: [key], onDelete: SetNull)

  @@unique([organizationId, satelliteKey])
  @@index([organizationId])
  @@map("satellite_endpoints")
}

enum WorkforceAssignmentStatus {
  ACTIVE
  INACTIVE
}

/// Cross-org workforce registry — no PII, only MDM person reference.
model WorkforceAssignment {
  id                String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  globalPersonId    String                    @map("global_person_id") @db.Uuid
  organizationId    String                    @map("organization_id") @db.Uuid
  satelliteKey      String                    @map("satellite_key")
  satelliteUserId   String?                   @map("satellite_user_id")
  cpEmploymentId    String?                   @map("cp_employment_id") @db.Uuid
  financeEmployeeId String?                   @map("finance_employee_id") @db.Uuid
  role              String
  status            WorkforceAssignmentStatus @default(ACTIVE)
  createdAt         DateTime                  @default(now()) @map("created_at")
  updatedAt         DateTime                  @updatedAt @map("updated_at")
  organization      Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, satelliteKey, cpEmploymentId])
  @@index([globalPersonId])
  @@index([organizationId, status])
  @@map("workforce_assignments")
}

enum WorkforceEmploymentStatus {
  ACTIVE
  TERMINATED
}

enum WorkforceAbsenceKind {
  VACATION
  SICK
  UNPAID
}

enum WorkforceAbsenceStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
}

enum WorkforceTimesheetEntryStatus {
  DRAFT
  APPROVED
}

enum WorkforceVacationPlanStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum WorkforcePersonnelOrderType {
  HIRE
  TRANSFER
  TERMINATE
}

enum WorkforcePersonnelOrderStatus {
  DRAFT
  ISSUED
  CANCELLED
}

enum StaffScheduleRevisionStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
}

enum OrgUnitStatus {
  ACTIVE
  ARCHIVED
}

enum OrgCommercialLinkMode {
  SCOPE_ROOT
  SUBTREE
}

enum RoleBindingSource {
  TEMPLATE
  MANUAL_GRANT
  HIRE_DEFAULT
}

enum RoleBindingStatus {
  ACTIVE
  REVOKED
}

/// Anchor for HR org tree (usually parent STANDALONE commercial org).
model WorkforceScope {
  id                   String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  anchorOrganizationId String                  @unique @map("anchor_organization_id") @db.Uuid
  name                 String
  createdAt            DateTime                @default(now()) @map("created_at")
  updatedAt            DateTime                @updatedAt @map("updated_at")
  orgUnits             OrgUnit[]
  employments          WorkforceEmployment[]
  commercialLinks      OrgUnitCommercialLink[]
  seatAllocations      WorkforceSeatAllocation[]
  vacationPlans        WorkforceVacationPlan[]
  personnelOrders      WorkforcePersonnelOrder[]
  staffScheduleRevisions StaffScheduleRevision[]

  @@map("workforce_scopes")
}

model OrgUnit {
  id                    String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workforceScopeId      String                  @map("workforce_scope_id") @db.Uuid
  parentId              String?                 @map("parent_id") @db.Uuid
  name                  String
  code                  String?
  status                OrgUnitStatus           @default(ACTIVE)
  sortOrder             Int                     @default(0) @map("sort_order")
  managerEmploymentId   String?                 @map("manager_employment_id") @db.Uuid
  managerUserId         String?                 @map("manager_user_id") @db.Uuid
  createdAt             DateTime                @default(now()) @map("created_at")
  updatedAt             DateTime                @updatedAt @map("updated_at")
  workforceScope        WorkforceScope          @relation(fields: [workforceScopeId], references: [id], onDelete: Cascade)
  parent                OrgUnit?                @relation("OrgUnitTree", fields: [parentId], references: [id], onDelete: Restrict)
  children              OrgUnit[]               @relation("OrgUnitTree")
  managerEmployment     WorkforceEmployment?    @relation("OrgUnitManager", fields: [managerEmploymentId], references: [id], onDelete: SetNull)
  positions             WorkforcePosition[]
  employments           WorkforceEmployment[]   @relation("EmploymentOrgUnit")
  commercialLinks       OrgUnitCommercialLink[]
  vacationPlans         WorkforceVacationPlan[]

  @@unique([workforceScopeId, parentId, name])
  @@index([workforceScopeId, parentId])
  @@map("org_units")
}

model OrgUnitCommercialLink {
  id               String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId   String                @unique @map("organization_id") @db.Uuid
  workforceScopeId String                @map("workforce_scope_id") @db.Uuid
  orgUnitId        String?               @map("org_unit_id") @db.Uuid
  linkMode         OrgCommercialLinkMode @default(SCOPE_ROOT) @map("link_mode")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  organization     Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workforceScope   WorkforceScope        @relation(fields: [workforceScopeId], references: [id], onDelete: Cascade)
  orgUnit          OrgUnit?              @relation(fields: [orgUnitId], references: [id], onDelete: SetNull)

  @@map("org_unit_commercial_links")
}

model WorkforcePosition {
  id          String                @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  orgUnitId   String                @map("org_unit_id") @db.Uuid
  name        String
  code        String?
  totalSlots  Int                   @default(1) @map("total_slots")
  status      OrgUnitStatus         @default(ACTIVE)
  createdAt   DateTime              @default(now()) @map("created_at")
  updatedAt   DateTime              @updatedAt @map("updated_at")
  orgUnit     OrgUnit               @relation(fields: [orgUnitId], references: [id], onDelete: Cascade)
  employments WorkforceEmployment[]
  roleTemplates SatelliteRoleTemplate[]

  @@unique([orgUnitId, name])
  @@map("workforce_positions")
}

model SatelliteRoleTemplate {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workforceScopeId String            @map("workforce_scope_id") @db.Uuid
  positionId       String            @map("position_id") @db.Uuid
  satelliteKey     String            @map("satellite_key")
  satelliteRole    String            @map("satellite_role")
  isDefault        Boolean           @default(true) @map("is_default")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  position         WorkforcePosition @relation(fields: [positionId], references: [id], onDelete: Cascade)

  @@unique([positionId, satelliteKey, satelliteRole])
  @@index([workforceScopeId, satelliteKey])
  @@map("satellite_role_templates")
}

model WorkforceRoleBinding {
  id              String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  employmentId    String            @map("employment_id") @db.Uuid
  satelliteKey    String            @map("satellite_key")
  satelliteRole   String            @map("satellite_role")
  source          RoleBindingSource
  manualGrantId   String?           @map("manual_grant_id") @db.Uuid
  status          RoleBindingStatus @default(ACTIVE)
  satelliteUserId String?           @map("satellite_user_id")
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")
  employment      WorkforceEmployment @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  manualGrant     WorkforceManualGrant? @relation(fields: [manualGrantId], references: [id], onDelete: SetNull)

  @@unique([employmentId, satelliteKey, satelliteRole])
  @@index([employmentId, status])
  @@map("workforce_role_bindings")
}

model WorkforceManualGrant {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  employmentId    String    @map("employment_id") @db.Uuid
  satelliteKey    String    @map("satellite_key")
  satelliteRole   String    @map("satellite_role")
  reason          String
  grantedByUserId String    @map("granted_by_user_id") @db.Uuid
  expiresAt       DateTime? @map("expires_at")
  revokedAt       DateTime? @map("revoked_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  employment      WorkforceEmployment @relation(fields: [employmentId], references: [id], onDelete: Cascade)
  roleBindings    WorkforceRoleBinding[]

  @@map("workforce_manual_grants")
}

model WorkforceSeatAllocation {
  id               String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  workforceScopeId String            @map("workforce_scope_id") @db.Uuid
  globalPersonId   String            @map("global_person_id") @db.Uuid
  employmentId     String            @unique @map("employment_id") @db.Uuid
  status           RoleBindingStatus @default(ACTIVE)
  createdAt        DateTime          @default(now()) @map("created_at")
  workforceScope   WorkforceScope    @relation(fields: [workforceScopeId], references: [id], onDelete: Cascade)
  employment       WorkforceEmployment @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@unique([workforceScopeId, globalPersonId])
  @@map("workforce_seat_allocations")
}

/// CP workforce employment — no PII; person via MDM globalPersonId.
model WorkforceEmployment {
  id                         String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId             String                    @map("organization_id") @db.Uuid
  workforceScopeId           String                    @map("workforce_scope_id") @db.Uuid
  orgUnitId                  String                    @map("org_unit_id") @db.Uuid
  positionId                 String                    @map("position_id") @db.Uuid
  globalPersonId             String                    @map("global_person_id") @db.Uuid
  status                     WorkforceEmploymentStatus @default(ACTIVE)
  hireDate                   DateTime                  @map("hire_date") @db.Date
  financeEmployeeId          String?                   @map("finance_employee_id") @db.Uuid
  commercialOrganizationId   String?                   @map("commercial_organization_id") @db.Uuid
  platformUserId             String?                   @map("platform_user_id") @db.Uuid
  createdAt                  DateTime                  @default(now()) @map("created_at")
  updatedAt                  DateTime                  @updatedAt @map("updated_at")
  organization               Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  workforceScope             WorkforceScope            @relation(fields: [workforceScopeId], references: [id], onDelete: Cascade)
  orgUnit                    OrgUnit                   @relation("EmploymentOrgUnit", fields: [orgUnitId], references: [id], onDelete: Restrict)
  position                   WorkforcePosition         @relation(fields: [positionId], references: [id], onDelete: Restrict)
  absences                   WorkforceAbsence[]
  managedOrgUnits            OrgUnit[]                 @relation("OrgUnitManager")
  roleBindings               WorkforceRoleBinding[]
  manualGrants               WorkforceManualGrant[]
  seatAllocation             WorkforceSeatAllocation?
  timesheetEntries           WorkforceTimesheetEntry[]
  vacationPlanLines          WorkforceVacationPlanLine[]
  personnelOrders            WorkforcePersonnelOrder[]

  @@index([organizationId, status])
  @@index([workforceScopeId, orgUnitId])
  @@index([globalPersonId])
  @@map("workforce_employments")
}

/// CP absence workflow (master); Finance holds payroll mirror.
model WorkforceAbsence {
  id                String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId    String                 @map("organization_id") @db.Uuid
  employmentId      String                 @map("employment_id") @db.Uuid
  kind              WorkforceAbsenceKind
  startDate         DateTime               @map("start_date") @db.Date
  endDate           DateTime               @map("end_date") @db.Date
  note              String                 @default("")
  status            WorkforceAbsenceStatus   @default(DRAFT)
  submittedAt       DateTime?              @map("submitted_at") @db.Timestamptz(6)
  approvedAt        DateTime?              @map("approved_at") @db.Timestamptz(6)
  rejectedAt        DateTime?              @map("rejected_at") @db.Timestamptz(6)
  cancelledAt       DateTime?              @map("cancelled_at") @db.Timestamptz(6)
  submittedByUserId String?                @map("submitted_by_user_id") @db.Uuid
  approvedByUserId  String?                @map("approved_by_user_id") @db.Uuid
  rejectedByUserId  String?                @map("rejected_by_user_id") @db.Uuid
  cancelledByUserId String?                @map("cancelled_by_user_id") @db.Uuid
  rejectionReason   String?                @map("rejection_reason")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  employment        WorkforceEmployment    @relation(fields: [employmentId], references: [id], onDelete: Cascade)

  @@index([organizationId, employmentId, startDate])
  @@index([organizationId, status])
  @@map("workforce_absences")
}

model WorkforceTimesheetEntry {
  id             String                        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  employmentId   String                        @map("employment_id") @db.Uuid
  workDate       DateTime                      @map("work_date") @db.Date
  hours          Decimal                       @db.Decimal(10, 2)
  source         String                        @default("construction_csv")
  sourceRef      String?                       @map("source_ref")
