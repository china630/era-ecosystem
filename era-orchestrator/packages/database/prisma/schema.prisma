model AuditLog {
  id             String        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String?       @map("organization_id") @db.Uuid
  userId         String?       @map("user_id") @db.Uuid
  entityType     String        @map("entity_type")
  entityId       String        @map("entity_id")
  action         String
  changes        Json?
  createdAt      DateTime      @default(now()) @map("created_at")
  oldValues      Json?         @map("old_values")
  newValues      Json?         @map("new_values")
  clientIp       String?       @map("client_ip")
  userAgent      String?       @map("user_agent")
  hash           String?       @map("hash")
  organization   Organization? @relation(fields: [organizationId], references: [id])
  user           User?         @relation(fields: [userId], references: [id])

  @@index([organizationId, createdAt])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

model NotificationTemplate {
  id             String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String?                  @map("organization_id") @db.Uuid
  templateKey    String                   @map("template_key") @db.VarChar(128)
  messageClass   NotificationMessageClass @map("message_class")
  channel        NotificationChannel
  subject        String?                  @db.VarChar(512)
  bodyTemplate   String                   @map("body_template")
  isActive       Boolean                  @default(true) @map("is_active")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")
  organization   Organization?            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  outboxEntries  NotificationOutbox[]

  @@unique([organizationId, templateKey, channel])
  @@index([templateKey])
  @@map("notification_templates")
}

model NotificationOutbox {
  id               String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId   String                   @map("organization_id") @db.Uuid
  templateKey      String                   @map("template_key") @db.VarChar(128)
  templateId       String?                  @map("template_id") @db.Uuid
  messageClass     NotificationMessageClass @map("message_class")
  channel          NotificationChannel
  recipient        String                   @db.VarChar(256)
  payload          Json                     @default("{}")
  status           NotificationOutboxStatus @default(PENDING)
  sourceEntityType String                   @map("source_entity_type") @db.VarChar(64)
  sourceEntityId   String                   @map("source_entity_id") @db.VarChar(128)
  errorMessage     String?                  @map("error_message")
  sentAt           DateTime?                @map("sent_at") @db.Timestamptz(6)
  createdAt        DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template         NotificationTemplate?    @relation(fields: [templateId], references: [id])
  deliveryLogs     NotificationDeliveryLog[]

  @@unique([organizationId, sourceEntityType, sourceEntityId, templateKey])
  @@index([organizationId, status, createdAt])
  @@map("notification_outbox")
}

model NotificationDeliveryLog {
  id              String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  outboxId        String                   @map("outbox_id") @db.Uuid
  organizationId  String                   @map("organization_id") @db.Uuid
  channel         NotificationChannel
  status          NotificationOutboxStatus
  providerPayload Json?                    @map("provider_payload")
  errorMessage    String?                  @map("error_message")
  attemptedAt     DateTime                 @default(now()) @map("attempted_at") @db.Timestamptz(6)
  outbox          NotificationOutbox       @relation(fields: [outboxId], references: [id], onDelete: Cascade)
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([outboxId, attemptedAt])
  @@index([organizationId, attemptedAt])
  @@map("notification_delivery_logs")
}

model PlatformPaymentLink {
  id               String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId   String                    @map("organization_id") @db.Uuid
  amountAzn        Decimal                   @map("amount_azn") @db.Decimal(12, 2)
  currency         String                    @default("AZN") @db.VarChar(3)
  counterpartyRef  String?                   @map("counterparty_ref") @db.VarChar(128)
  sourceEntityType String                    @map("source_entity_type") @db.VarChar(64)
  sourceEntityId   String                    @map("source_entity_id") @db.VarChar(128)
  paymentOrderId   String?                   @map("payment_order_id") @db.Uuid
  token            String                    @unique @db.VarChar(64)
  paymentUrl       String?                   @map("payment_url")
  status           PlatformPaymentLinkStatus @default(PENDING)
  expiresAt        DateTime?                 @map("expires_at") @db.Timestamptz(6)
  metadata         Json                      @default("{}")
  createdAt        DateTime                  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                  @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  paymentOrder     PaymentOrder?             @relation(fields: [paymentOrderId], references: [id])

  @@index([organizationId, status])
  @@map("platform_payment_links")
}

model PlatformPortalLink {
  id             String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  token          String                   @unique @db.VarChar(64)
  entityType     String                   @map("entity_type") @db.VarChar(64)
  entityId       String                   @map("entity_id") @db.VarChar(128)
  status         PlatformPortalLinkStatus @default(ACTIVE)
  expiresAt      DateTime?                @map("expires_at") @db.Timestamptz(6)
  metadata       Json                     @default("{}")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, entityType, entityId])
  @@map("platform_portal_links")
}

model BookableResource {
  id             String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  resourceKey    String               @map("resource_key") @db.VarChar(64)
  name           String               @db.VarChar(256)
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  slots          BookingSlot[]
  appointments   BookingAppointment[]

  @@unique([organizationId, resourceKey])
  @@map("bookable_resources")
}

model BookingSlot {
  id             String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String               @map("organization_id") @db.Uuid
  resourceId     String               @map("resource_id") @db.Uuid
  startsAt       DateTime             @map("starts_at") @db.Timestamptz(6)
  endsAt         DateTime             @map("ends_at") @db.Timestamptz(6)
  capacity       Int                  @default(1)
  bookedCount    Int                  @default(0) @map("booked_count")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource       BookableResource     @relation(fields: [resourceId], references: [id], onDelete: Cascade)
  appointments   BookingAppointment[]

  @@index([organizationId, startsAt])
  @@map("booking_slots")
}

model BookingAppointment {
  id             String                   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String                   @map("organization_id") @db.Uuid
  resourceId     String?                  @map("resource_id") @db.Uuid
  slotId         String?                  @map("slot_id") @db.Uuid
  customerRef    String                   @map("customer_ref") @db.VarChar(128)
  customerPhone  String?                  @map("customer_phone") @db.VarChar(32)
  customerName   String?                  @map("customer_name") @db.VarChar(256)
  scheduledAt    DateTime                 @map("scheduled_at") @db.Timestamptz(6)
  status         BookingAppointmentStatus @default(PENDING)
  metadata       Json                     @default("{}")
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resource       BookableResource?        @relation(fields: [resourceId], references: [id])
  slot           BookingSlot?             @relation(fields: [slotId], references: [id])

  @@index([organizationId, scheduledAt])
  @@map("booking_appointments")
}

model PlatformPromotion {
  id             String                        @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String                        @map("organization_id") @db.Uuid
  code           String                        @db.VarChar(64)
  name           String                        @db.VarChar(256)
  discountType   PlatformPromotionDiscountType @map("discount_type")
  discountValue  Decimal                       @map("discount_value") @db.Decimal(12, 2)
  validFrom      DateTime?                     @map("valid_from") @db.Timestamptz(6)
  validUntil     DateTime?                     @map("valid_until") @db.Timestamptz(6)
  status         PlatformPromotionStatus       @default(ACTIVE)
  metadata       Json                          @default("{}")
  createdAt      DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization                  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("platform_promotions")
}

model PlatformCustomDomain {
  id             String                     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String                     @map("organization_id") @db.Uuid
  hostname       String                     @db.VarChar(253)
  status         PlatformCustomDomainStatus @default(PENDING_DNS)
  metadata       Json                       @default("{}")
  createdAt      DateTime                   @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                   @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, hostname])
  @@map("platform_custom_domains")
}

model PlatformShipment {
  id               String                 @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId   String                 @map("organization_id") @db.Uuid
  externalRef      String?                @map("external_ref") @db.VarChar(128)
  trackingToken    String                 @unique @map("tracking_token") @db.VarChar(64)
  status           PlatformShipmentStatus @default(CREATED)
  sourceEntityType String                 @map("source_entity_type") @db.VarChar(64)
  sourceEntityId   String                 @map("source_entity_id") @db.VarChar(128)
  recipientPhone   String?                @map("recipient_phone") @db.VarChar(32)
  metadata         Json                   @default("{}")
  createdAt        DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, status])
  @@index([organizationId, sourceEntityType, sourceEntityId])
  @@map("platform_shipments")
}

model PlatformAuditLog {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  addonSlug      String       @map("addon_slug") @db.VarChar(64)
  action         String       @db.VarChar(128)
  idempotencyKey String?      @map("idempotency_key") @db.VarChar(128)
  payload        Json         @default("{}")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, createdAt])
  @@map("platform_audit_logs")
}

model PlatformIdempotencyRecord {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  scope          String       @db.VarChar(128)
  idempotencyKey String       @map("idempotency_key") @db.VarChar(256)
  responseJson   Json?        @map("response_json")
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, scope, idempotencyKey])
  @@map("platform_idempotency_records")
}

model PlatformLoyaltyLedger {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  customerRef    String       @map("customer_ref") @db.VarChar(128)
  pointsDelta    Int          @map("points_delta")
  reason         String       @db.VarChar(128)
  promotionCode  String?      @map("promotion_code") @db.VarChar(64)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, customerRef])
  @@map("platform_loyalty_ledger")
}
