{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": true,
    "paths": {
      "@era/satellite-kit/integration/person-name": [
        "../../../packages/satellite-kit/dist/integration/person-name"
      ],
      "@era/satellite-kit/time": [
        "../../../packages/satellite-kit/dist/time/baku"
      ],
      "@era/satellite-kit/phone": [
        "../../../packages/satellite-kit/dist/phone/normalize-person-phone"
      ],
      "@era/satellite-kit/person/name": [
        "../../../packages/satellite-kit/dist/person/person-name-match"
      ]
    }
  },
  "include": ["src/**/*"]
}
