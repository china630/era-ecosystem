  episode          ClinicalEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  icdCodeId        String          @map("icd_code_id")
  icdCode          IcdCode         @relation(fields: [icdCodeId], references: [id])
  note             String?
  recordedAt       DateTime        @default(now())
