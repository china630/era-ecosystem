  startsOn       DateTime         @map("starts_on")
  endsOn         DateTime         @map("ends_on")
  note           String?
  createdAt      DateTime         @default(now()) @map("created_at")

  @@index([practitionerId, startsOn, endsOn])
  @@index([organizationId])
  @@map("staff_absence")
}

/// Consecutive-day rotation (e.g. naftalan max 2 days then iod-brom; superinductive by body part)
model ProcedureRotationRule {
  id                 String        @id @default(cuid())
  organizationId String @map("organization_id")
  code               String
  name               String
  memberCodes        String[]      @map("member_codes")
  scope              RotationScope @default(GROUP)
