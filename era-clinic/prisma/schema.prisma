generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                       String                   @id @default(cuid())
  code                     String                   @unique
  name                     String
  enabledPresets           String[]                 @default(["outpatient"]) @map("enabled_presets")
  programSchedulingMode    ProgramSchedulingMode    @default(AFTER_CHECKUP) @map("program_scheduling_mode")
  schedulingSlotMinutes    Int                      @default(5) @map("scheduling_slot_minutes")
  procedureOverQuotaPolicy ProcedureOverQuotaPolicy @default(CHARGE_FOLIO) @map("procedure_over_quota_policy")
  defaultOutletId          String?                  @map("default_outlet_id")
  /// Favorite diagnostic keys: `mod:USG`, `mod:USG:abdomen`, `lab:hematology`, `code:LAB-CBC`
  catalogFavoriteCodes     String[]                 @default([]) @map("catalog_favorite_codes")
  /// `first` = favorites sorted to top; `only` = hide non-favorites in pickers
  catalogFavoritesMode     String                   @default("first") @map("catalog_favorites_mode")
  patientCardResultsPreview Int                     @default(5) @map("patient_card_results_preview")
  patientCardPlanPreview    Int                     @default(15) @map("patient_card_plan_preview")
  patientCardHistoryPageSize Int                    @default(25) @map("patient_card_history_page_size")
  patientCardPlanPageSize   Int                     @default(25) @map("patient_card_plan_page_size")
  /// Check-in allowed from scheduledAt − N minutes
  procedureCheckInGraceBeforeMin Int                @default(5) @map("procedure_check_in_grace_before_min")
  /// Check-in allowed until scheduledAt + N minutes
  procedureCheckInGraceAfterMin  Int                @default(15) @map("procedure_check_in_grace_after_min")
  /// When true nurse check-in needs a guest QR (or supervised override); when false MANUAL check-in is allowed
  checkInRequiresQr        Boolean                  @default(true) @map("check_in_requires_qr")
  /// Optional: auto-NO_SHOW a SCHEDULED order this many minutes past scheduledAt (null = end-of-day sweep only)
  autoNoShowAfterMin       Int?                     @map("auto_no_show_after_min")
  /// Clinic day start hour (Asia/Baku wall clock), inclusive
  dayStartHour             Int                      @default(9) @map("day_start_hour")
  /// Clinic day end hour (Asia/Baku), exclusive
  dayEndHour               Int                      @default(18) @map("day_end_hour")
  lunchStartHour           Int                      @default(13) @map("lunch_start_hour")
  lunchEndHour             Int                      @default(14) @map("lunch_end_hour")
  /// JS getUTCDay-style weekday numbers closed (0=Sunday). Default Sunday only.
  closedWeekdays           Int[]                    @default([0]) @map("closed_weekdays")
  /// Default minutes between consecutive patient procedures when template gap is unset
  defaultProcedureGapMinutes Int                    @default(5) @map("default_procedure_gap_minutes")
  /// When true, procedures/resources with extendedEndHour may run past dayEndHour
  peakModeEnabled          Boolean                  @default(false) @map("peak_mode_enabled")
  /// Peak-mode clinic day end hour (Asia/Baku), exclusive; used when procedure/resource has no override
  peakDayEndHour           Int                      @default(22) @map("peak_day_end_hour")
  /// Last published `ok`|`warning`|`critical` for capacity foresight debounce
  lastCapacityRiskLevel    String?                  @map("last_capacity_risk_level")
  /// Print branding — logo as data URL (no file storage)
  printLogoDataUrl         String?                  @map("print_logo_data_url") @db.Text
  printClinicNameEn        String?                  @map("print_clinic_name_en")
  printClinicNameRu        String?                  @map("print_clinic_name_ru")
  printClinicNameAz        String?                  @map("print_clinic_name_az")
  printAddressEn           String?                  @map("print_address_en")
  printAddressRu           String?                  @map("print_address_ru")
  printAddressAz           String?                  @map("print_address_az")
  printPhone               String?                  @map("print_phone")
  printEmail               String?                  @map("print_email")
  printWebsite             String?                  @map("print_website")
  printFooterEn            String?                  @map("print_footer_en") @db.Text
  printFooterRu            String?                  @map("print_footer_ru") @db.Text
  printFooterAz            String?                  @map("print_footer_az") @db.Text
  printSignatureLab        String?                  @map("print_signature_lab")
  printSignatureDoctor     String?                  @map("print_signature_doctor")
  /// Ordered checkup sections JSON: [{ specialty, enabled }]
  checkupSectionsJson      String?                  @map("checkup_sections_json") @db.Text
  createdAt                DateTime                 @default(now())
  outlets                  Outlet[]
}

enum LabOrderStatus {
  ORDERED
  COLLECTED
  IN_PROGRESS
  RESULT_READY
  PUBLISHED
  COMPLETED
}

enum PatientOrigin {
  WALK_IN
  IN_HOUSE
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum VisitStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BillingTarget {
  FINANCE
  HOTEL_FOLIO
  SETTLEMENT_HUB
}

enum ResourceKind {
  ROOM
  EQUIPMENT
}

enum ProcedureRequirementRole {
  LOCATION
  EQUIPMENT
  STAFF
}

enum ProcedureStaffMode {
  HARD
  SOFT
}

enum ProcedureOrderStatus {
  /// Package line shown on patient card; not on resources until doctor confirms
  PROPOSED
  SCHEDULED
  CHECKED_IN
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum RotationScope {
  BODY_PART
  GROUP
}

enum LabResultSource {
  IN_HOUSE
  EXTERNAL
}

enum LabResultFlag {
  NORMAL
  HIGH
  LOW
  CRITICAL
}

enum ProcedureCheckInChannel {
  QR
  OVERRIDE
  MANUAL
}

enum ProgramSchedulingMode {
  ON_CHECKIN
  AFTER_CHECKUP
}

enum ProcedureOverQuotaPolicy {
  CHARGE_FOLIO
  BLOCK
  WARN_ONLY
}

enum ClinicReceiptStatus {
  OPEN
  PAID
  VOID
}

enum ClinicReceiptChannel {
  LOCAL
  FINANCE
  HOTEL_FOLIO
  SETTLEMENT_HUB
}

enum ClinicReceiptLineSource {
  VISIT_LINE
  LAB_ITEM
  PROCEDURE
  MANUAL
}

enum QueueTicketStatus {
  WAITING
  CALLED
  SERVED
  SKIPPED
}

enum LisFileFormat {
  CSV
  HL7_FRAGMENT
}

/// Clinical/administrative sex for dosing, protocols, rooming (ops cache — not MDM SoR yet).
enum PatientSex {
  MALE
  FEMALE
  OTHER
  UNKNOWN
}

enum PatientBloodGroup {
  A_POS
  A_NEG
  B_POS
  B_NEG
  AB_POS
  AB_NEG
  O_POS
  O_NEG
  UNKNOWN
}

model Outlet {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  preset    String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
}

model PatientRef {
  id                      String             @id @default(cuid())
  refCode                 String             @unique
  fullName                String
  phone                   String?
  nationality             String?            @default("AZ")
  /// Clinical sex (ops cache). SoR for identifiers remains MDM.
  sex                     PatientSex         @default(UNKNOWN)
  /// Calendar date only; age is derived at read time.
  birthDate               DateTime?          @db.Date
  bloodGroup              PatientBloodGroup  @default(UNKNOWN) @map("blood_group")
  emergencyContactName    String?            @map("emergency_contact_name")
  emergencyContactPhone   String?            @map("emergency_contact_phone")
  globalPersonId          String?
  /// Free-text anamnesis; required before demographics save in ops UI
  anamnesisText           String?            @map("anamnesis_text") @db.Text
  anamnesisUpdatedAt      DateTime?          @map("anamnesis_updated_at")
  appointments            Appointment[]
  visits                  Visit[]
  labOrders               LabOrder[]
  episodes                ClinicalEpisode[]
  procedureOrders         ProcedureOrder[]
  contraindications       PatientContraindication[]
  bedAssignments          BedAssignment[]
  inpatientAdmissions     InpatientAdmission[]
  receipts                ClinicReceipt[]
  procedureChargeLogs     ProcedureChargeLog[]
  createdAt               DateTime           @default(now())
}

model Practitioner {
  id                 String            @id @default(cuid())
  code               String            @unique
  fullName           String
  specialty          String?
  globalPersonId     String?           @map("global_person_id")
  financeEmployeeId  String?           @unique @map("finance_employee_id")
  cpEmploymentId     String?           @unique @map("cp_employment_id")
  userId             String?           @unique @map("user_id")
  user               User?             @relation(fields: [userId], references: [id])
  active             Boolean           @default(true)
  defaultSlotMinutes Int               @default(30) @map("default_slot_minutes")
  appointments       Appointment[]
  visits             Visit[]
  resourceBookings   ResourceBooking[]
  skills             PractitionerSkill[]
  procedureAllocations ProcedureAllocation[]
  scheduleRules      PractitionerScheduleRule[]
  scheduleExceptions PractitionerScheduleException[]
}

/// CLI-36 — doctor shift rotation.
/// A practitioner's weekly/parity/cycle availability. Multiple rules stack
/// (union of intervals). No active rule for a practitioner ⇒ unrestricted
/// (tenant working hours), preserving pre-CLI-36 behaviour.
enum PractitionerSchedulePattern {
  WEEKLY           // weekdaysJson every week
  WEEK_PARITY      // weekdaysJson on even/odd ISO weeks (parity)
  MONTH_DAY_PARITY // even/odd day-of-month (parity)
  CYCLE            // N-day rotation from cycleAnchor (cycleOffsetsJson)
}

enum ScheduleParity {
  EVEN
  ODD
}

enum PractitionerScheduleExceptionKind {
  DAY_OFF      // block the whole date (overrides rules)
  EXTRA_SHIFT  // add an interval on the date
  CUSTOM_HOURS // replace the date's intervals with the given window
}

model PractitionerScheduleRule {
  id               String                      @id @default(cuid())
  practitionerId   String                      @map("practitioner_id")
  pattern          PractitionerSchedulePattern
  /// JSON int[] of weekdays (0=Sun .. 6=Sat) — WEEKLY / WEEK_PARITY
  weekdaysJson     String?                     @map("weekdays_json")
  /// WEEK_PARITY: even/odd ISO week; MONTH_DAY_PARITY: even/odd day-of-month
  parity           ScheduleParity?
  /// CYCLE anchor date (00:00 Asia/Baku)
  cycleAnchor      DateTime?                   @map("cycle_anchor")
  /// CYCLE length in days
  cycleLengthDays  Int?                        @map("cycle_length_days")
  /// CYCLE: JSON int[] of active day offsets within the cycle
  cycleOffsetsJson String?                     @map("cycle_offsets_json")
  /// Working window on a matching day, minutes from midnight (Asia/Baku)
  startMinute      Int                         @map("start_minute")
  endMinute        Int                         @map("end_minute")
  /// Optional seasonal validity (inclusive from / exclusive to)
  effectiveFrom    DateTime?                   @map("effective_from")
  effectiveTo      DateTime?                   @map("effective_to")
  active           Boolean                     @default(true)
  sortOrder        Int                         @default(0) @map("sort_order")
  createdAt        DateTime                    @default(now()) @map("created_at")
  practitioner     Practitioner                @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@index([practitionerId, active])
}

model PractitionerScheduleException {
  id             String                            @id @default(cuid())
  practitionerId String                            @map("practitioner_id")
  /// The affected calendar day (00:00 Asia/Baku)
  date           DateTime                          @map("date")
  kind           PractitionerScheduleExceptionKind
  /// Minutes from midnight — EXTRA_SHIFT / CUSTOM_HOURS
  startMinute    Int?                              @map("start_minute")
  endMinute      Int?                              @map("end_minute")
  note           String?
  createdAt      DateTime                          @default(now()) @map("created_at")
  practitioner   Practitioner                      @relation(fields: [practitionerId], references: [id], onDelete: Cascade)

  @@unique([practitionerId, date, kind])
  @@index([practitionerId, date])
}

model PractitionerSkill {
  id               String       @id @default(cuid())
  practitionerId   String       @map("practitioner_id")
  procedureTypeId  String       @map("procedure_type_id")
  active           Boolean      @default(true)
  practitioner     Practitioner @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
  procedureType    ProcedureType @relation(fields: [procedureTypeId], references: [id], onDelete: Cascade)
  createdAt        DateTime     @default(now()) @map("created_at")

  @@unique([practitionerId, procedureTypeId])
  @@index([procedureTypeId])
  @@map("practitioner_skill")
}

model Room {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  resources Resource[]
  createdAt DateTime   @default(now())
}

model Resource {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  kind             ResourceKind      @default(EQUIPMENT)
  capacity         Int               @default(1)
  /// When peak mode is on, this resource may run until this hour (exclusive)
  extendedEndHour  Int?              @map("extended_end_hour")
  roomId           String?
  room             Room?             @relation(fields: [roomId], references: [id])
  bookings         ResourceBooking[]
  procedureOrders  ProcedureOrder[]
  appointments     Appointment[]
  procedureAllocations ProcedureAllocation[]
  createdAt        DateTime          @default(now())
}

model ResourceBooking {
  id              String          @id @default(cuid())
  resourceId      String
  practitionerId  String?
  appointmentId   String?         @unique
  procedureOrderId String?        @unique
  startsAt        DateTime
  endsAt          DateTime
  resource        Resource        @relation(fields: [resourceId], references: [id])
  practitioner    Practitioner?   @relation(fields: [practitionerId], references: [id])
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id])
  procedureOrder  ProcedureOrder? @relation(fields: [procedureOrderId], references: [id])

  @@index([resourceId, startsAt, endsAt])
}

model Appointment {
  id             String            @id @default(cuid())
  patientRefId   String
  practitionerId String
  scheduledAt    DateTime
  roomCode       String?
  /// Pattern B secondary location/equipment (optional).
  resourceId     String?           @map("resource_id")
  status         AppointmentStatus @default(SCHEDULED)
  reminderSentAt DateTime?
  patientRef     PatientRef        @relation(fields: [patientRefId], references: [id])
  practitioner   Practitioner      @relation(fields: [practitionerId], references: [id])
  resource       Resource?         @relation(fields: [resourceId], references: [id])
  visit          Visit?
  resourceBooking ResourceBooking?
  createdAt      DateTime          @default(now())

  @@index([scheduledAt, status])
  @@index([resourceId, scheduledAt])
}

model Visit {
  id             String               @id @default(cuid())
  appointmentId  String?              @unique
  patientRefId   String
  practitionerId String
  status         VisitStatus          @default(IN_PROGRESS)
  patientOrigin  PatientOrigin        @default(WALK_IN)
  billingTarget        BillingTarget        @default(FINANCE)
  settlementPendingId  String?
  hubFiscalReceiptId   String?
  settledAt            DateTime?
  reservationId        String?
  roomNumber     String?
  amountNet      Decimal              @default(0) @db.Decimal(12, 2)
  completedAt    DateTime?
  patientRef     PatientRef           @relation(fields: [patientRefId], references: [id])
  practitioner   Practitioner         @relation(fields: [practitionerId], references: [id])
  appointment    Appointment?         @relation(fields: [appointmentId], references: [id])
  serviceLines   VisitServiceLine[]
  labOrders      LabOrder[]
  discountAudits VisitDiscountAudit[]
  cpoeEntries    CpoeEntry[]
  procedureOrders ProcedureOrder[]
  receipts       ClinicReceipt[]
  queueTickets   QueueTicket[]
  createdAt      DateTime             @default(now())

  @@index([patientRefId, status])
}

model VisitServiceLine {
  id          String  @id @default(cuid())
  visitId     String
  serviceCode String
  description String
  amount      Decimal @db.Decimal(12, 2)
  visit       Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
}

model LabOrder {
  id                String         @id @default(cuid())
  patientRefId      String
  visitId           String?
  clinicalEpisodeId String?
  /// @deprecated dual-write snapshot; prefer LabOrderItem.serviceCode
  testCode          String
  status            LabOrderStatus @default(ORDERED)
  amountNet         Decimal        @default(0) @db.Decimal(12, 2)
  collectedAt       DateTime?
  /// @deprecated dual-write snapshot; prefer LabResult rows
  resultJson        String?
  publishedAt       DateTime?
  telehealthUrl     String?
  completedAt       DateTime?
  /// IN_HOUSE (clinic) or EXTERNAL (patient-brought results)
  source            LabResultSource @default(IN_HOUSE)
  /// Actual lab draw / result date (required for EXTERNAL; max 90 days age)
  resultDate        DateTime?       @map("result_date")
  fasting           Boolean         @default(false)
  /// Planned collection slot (e.g. next morning fasting)
  scheduledCollectionAt DateTime?   @map("scheduled_collection_at")
  patientRef        PatientRef     @relation(fields: [patientRefId], references: [id])
  visit             Visit?         @relation(fields: [visitId], references: [id])
  episode           ClinicalEpisode? @relation(fields: [clinicalEpisodeId], references: [id])
  items             LabOrderItem[]
  createdAt         DateTime       @default(now())

  @@index([patientRefId, status])
  @@index([visitId])
  @@index([clinicalEpisodeId])
  @@index([createdAt])
}

/// Diagnostic modality (LAB, USG, FUNCTIONAL, …) — catalog source of truth in DB.
model Modality {
  id          String              @id @default(cuid())
  code        String              @unique
  kind        String
  titleEn     String              @map("title_en")
  titleRu     String              @map("title_ru")
  titleAz     String              @map("title_az")
  sortOrder   Int                 @default(0) @map("sort_order")
  active      Boolean             @default(true)
  services    DiagnosticService[]
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

/// Diagnostic / lab service from catalog (USG-ABD, LAB-CBC, packages, visit templates).
model DiagnosticService {
  id           String              @id @default(cuid())
  code         String              @unique
  modalityId   String              @map("modality_id")
  modality     Modality            @relation(fields: [modalityId], references: [id])
  category     String              @default("")
  kind         String
  titleEn      String              @map("title_en")
  titleRu      String              @map("title_ru")
  titleAz      String              @map("title_az")
  /// Price / Finance link code
  serviceCode  String              @map("service_code")
  /// Imaging / visit template fields JSON (CatalogFieldDef[])
  fieldsJson   String?             @map("fields_json") @db.Text
  /// Package composition: child service codes JSON (string[])
  includesJson String?             @map("includes_json") @db.Text
  sortOrder    Int                 @default(0) @map("sort_order")
  active       Boolean             @default(true)
  analytes     DiagnosticAnalyte[]
  labOrderItems LabOrderItem[]
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@index([modalityId])
  @@index([kind])
  @@index([active])
}

enum AnalyteValueType {
  NUMERIC
  QUALITATIVE
}

model DiagnosticAnalyte {
  id           String               @id @default(cuid())
  serviceId    String               @map("service_id")
  service      DiagnosticService    @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  code         String
  unit         String?
  labelEn      String               @map("label_en")
  labelRu      String               @map("label_ru")
  labelAz      String               @map("label_az")
  refMin       String?              @map("ref_min")
  refMax       String?              @map("ref_max")
  /// Print grouping within a panel (e.g. physical-chemical / microscopy)
  section      String?
  valueType    AnalyteValueType     @default(NUMERIC) @map("value_type")
  sortOrder    Int                  @default(0) @map("sort_order")
  valueOptions AnalyteValueOption[]

  @@unique([serviceId, code])
  @@index([serviceId])
}

/// Trilingual allowed values for QUALITATIVE analytes (store code in LabResult.value).
model AnalyteValueOption {
  id        String            @id @default(cuid())
  analyteId String            @map("analyte_id")
  analyte   DiagnosticAnalyte @relation(fields: [analyteId], references: [id], onDelete: Cascade)
  code      String
  labelEn   String            @map("label_en")
  labelRu   String            @map("label_ru")
  labelAz   String            @map("label_az")
  sortOrder Int               @default(0) @map("sort_order")

  @@unique([analyteId, code])
  @@index([analyteId])
}

/// Trilingual USM / imaging phrase library (store phrase code in LabResult.value).
model ImagingPhrase {
  id                   String   @id @default(cuid())
  organKey             String   @map("organ_key")
  code                 String   @unique
  textEn               String   @map("text_en") @db.Text
  textRu               String   @map("text_ru") @db.Text
  textAz               String   @map("text_az") @db.Text
  /// JSON string[] of measurement placeholder keys (e.g. ["sizeCm"])
  measurementKeysJson  String?  @map("measurement_keys_json") @db.Text
  sortOrder            Int      @default(0) @map("sort_order")
  active               Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  @@index([organKey, sortOrder])
  @@index([active])
}

/// Global common meta fields for imaging/visit result forms.
model DiagnosticMetaField {
  id         String   @id @default(cuid())
  key        String   @unique
  fieldType  String   @map("field_type")
  labelEn    String   @map("label_en")
  labelRu    String   @map("label_ru")
  labelAz    String   @map("label_az")
  unit       String?
  optionsJson String? @map("options_json") @db.Text
  required   Boolean  @default(false)
  sortOrder  Int      @default(0) @map("sort_order")
}

model LabOrderItem {
  id                  String             @id @default(cuid())
  labOrderId          String             @map("lab_order_id")
  labOrder            LabOrder           @relation(fields: [labOrderId], references: [id], onDelete: Cascade)
  diagnosticServiceId String?            @map("diagnostic_service_id")
  diagnosticService   DiagnosticService? @relation(fields: [diagnosticServiceId], references: [id])
  /// Snapshot of catalog / order code at create time
  serviceCode         String             @map("service_code")
  amountNet           Decimal            @default(0) @db.Decimal(12, 2) @map("amount_net")
  sortOrder           Int                @default(0) @map("sort_order")
  results             LabResult[]
  createdAt           DateTime           @default(now())

  @@index([labOrderId])
  @@index([diagnosticServiceId])
  @@index([serviceCode])
}

model LabResult {
  id              String         @id @default(cuid())
  labOrderItemId  String         @map("lab_order_item_id")
  labOrderItem    LabOrderItem   @relation(fields: [labOrderItemId], references: [id], onDelete: Cascade)
  code            String
  label           String?
  value           String
  unit            String?
  refMin          String?        @map("ref_min")
  refMax          String?        @map("ref_max")
  flag            LabResultFlag  @default(NORMAL)
  enteredByUserId String?        @map("entered_by_user_id")
  enteredAt       DateTime       @default(now()) @map("entered_at")

  @@index([labOrderItemId])
  @@index([flag])
  @@unique([labOrderItemId, code])
}

model ClinicalEpisode {
  id                  String              @id @default(cuid())
  patientRefId        String?
  patientRef          PatientRef?         @relation(fields: [patientRefId], references: [id])
  globalPersonId      String?
  hotelStayId         String?
  reservationId       String?
  roomNumber          String?
  organizationId      String
  patientOrigin       PatientOrigin       @default(IN_HOUSE)
  programCode         String?
  checkupCompletedAt  DateTime?
  status              String              @default("OPEN")
  openedAt            DateTime            @default(now())
  closedAt            DateTime?
  complaints          ClinicalComplaint[]
  diagnoses           ClinicalDiagnosis[]
  labOrders           LabOrder[]
  programInstance     ProgramInstance?

  @@index([reservationId])
  @@index([organizationId, status])
}

model ClinicalComplaint {
  id         String          @id @default(cuid())
  episodeId  String
  episode    ClinicalEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  text       String
  recordedAt DateTime        @default(now())

  @@index([episodeId])
}

model ClinicalDiagnosis {
  id          String          @id @default(cuid())
  episodeId   String
  episode     ClinicalEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  icdCodeId   String?
  icdCode     IcdCode?        @relation(fields: [icdCodeId], references: [id])
  icdCodeText String?
  description String
  recordedAt  DateTime        @default(now())

  @@index([episodeId])
}

model IcdCode {
  id          String              @id @default(cuid())
  code        String              @unique
  description String
  diagnoses   ClinicalDiagnosis[]
}

/// Former BodyPart Prisma enum — String codes from ClinicLookup kind=BODY_PART (ADR A4).

/// T1 SatAdmin pick-lists — ADR managed-lists-vs-enums A4
enum ClinicLookupKind {
  BODY_PART
}

model ClinicLookup {
  id        String           @id @default(cuid())
  kind      ClinicLookupKind
  code      String
  name      String
  active    Boolean          @default(true)
  sortOrder Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@unique([kind, code])
  @@index([kind, active, sortOrder])
}

enum ProcedureRuleKind {
  SEQUENCE_GAP
  MUTUAL_EXCLUSION
}

enum ProcedureCompatibilityRuleType {
  FORBID_SAME_DAY
  MIN_HOURS_GAP
  FORBID_SEQUENCE
}

model ProcedureCompatibilityRule {
  id              String                         @id @default(cuid())
  procedureCodeA  String
  procedureCodeB  String
  ruleType        ProcedureCompatibilityRuleType
  minHours        Int?
  active          Boolean                        @default(true)
  note            String?
  createdAt       DateTime                       @default(now())

  @@index([procedureCodeA])
  @@index([procedureCodeB])
  @@index([active])
}

model ProcedureType {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  durationMin        Int           @default(30)
  resourceKind       ResourceKind?
  resourceCode       String?
  /// ClinicLookup BODY_PART code
  bodyPart           String?
  afterLunchAllowed  Boolean       @default(true)
  /// When peak mode is on, this procedure may run until this hour (exclusive)
  extendedEndHour    Int?          @map("extended_end_hour")
  orders             ProcedureOrder[]
  requirements       ProcedureTypeRequirement[]
  skills             PractitionerSkill[]

  @@index([resourceCode])
}

/// Consecutive-day rotation (e.g. naftalan max 2 days then iod-brom; superinductive by body part)
model ProcedureRotationRule {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  memberCodes        String[]      @map("member_codes")
  scope              RotationScope @default(GROUP)
  maxConsecutiveDays Int           @default(1) @map("max_consecutive_days")
  restProcedureCode  String?       @map("rest_procedure_code")
  active             Boolean       @default(true)
  note               String?
  createdAt          DateTime      @default(now()) @map("created_at")

  @@index([active])
}

/// Quota-preserving substitute when original is contraindicated
model ProcedureSubstitutionRule {
  id              String   @id @default(cuid())
  originalCode    String   @map("original_code")
  substituteCode  String   @map("substitute_code")
  active          Boolean  @default(true)
  note            String?
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([originalCode])
  @@index([substituteCode])
  @@index([active])
}

model ProcedureTypeRequirement {
  id               String                   @id @default(cuid())
  procedureTypeId  String                   @map("procedure_type_id")
  role             ProcedureRequirementRole
  resourceKind     ResourceKind?            @map("resource_kind")
  resourceCode     String?                  @map("resource_code")
  quantity         Int                      @default(1)
  staffMode        ProcedureStaffMode       @default(HARD) @map("staff_mode")
  required         Boolean                  @default(true)
  procedureType    ProcedureType            @relation(fields: [procedureTypeId], references: [id], onDelete: Cascade)
  createdAt        DateTime                 @default(now()) @map("created_at")

  @@index([procedureTypeId])
  @@map("procedure_type_requirement")
}

model ProcedureRule {
  id              String             @id @default(cuid())
  beforeCode      String
  afterCode       String
  kind            ProcedureRuleKind  @default(SEQUENCE_GAP)
  minGapMinutes   Int                @default(0)
  /// ClinicLookup BODY_PART code
  bodyPart        String?

  @@index([beforeCode])
  @@index([afterCode])
}

model PatientContraindication {
  id           String     @id @default(cuid())
  patientRefId String
  /// ClinicLookup BODY_PART code
  bodyPart     String
  note         String?
  patientRef   PatientRef @relation(fields: [patientRefId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([patientRefId])
}

enum ServiceCatalogKind {
  PROCEDURE
  DIAGNOSTIC
  LAB
  VISIT
  OTHER
}

model ServiceCatalogCache {
  id               String             @id @default(cuid())
  code             String             @unique
  description      String
  /// Locale-specific commercial names (Finance sync / Nafta import). UI picks via localizedCatalogDescription.
  descriptionAz    String?            @map("description_az")
  descriptionRu    String?            @map("description_ru")
  descriptionEn    String?            @map("description_en")
  amount           Decimal            @db.Decimal(12, 2)
  packageIncluded  Boolean            @default(false) @map("package_included")
  department       String?
  kind             ServiceCatalogKind @default(OTHER)
  syncedAt         DateTime           @default(now())

  @@index([kind])
}

model VisitDiscountAudit {
  id         String   @id @default(cuid())
  visitId    String
  percent    Decimal  @db.Decimal(5, 2)
  approvedBy String
  reason     String
  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([visitId])
}

model ClinicalTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  specialty   String?
  bodyJson    String
  createdAt   DateTime @default(now())
}

model ProgramTemplate {
  id          String                  @id @default(cuid())
  code        String                  @unique
  name        String
  durationDays Int
  procedures  ProgramTemplateProcedure[]
  instances   ProgramInstance[]
}

model ProgramTemplateProcedure {
  id               String          @id @default(cuid())
  templateId       String
  procedureCode    String
  procedureName    String
  quotaTotal       Int
  minGapMinutes    Int?
  avoidAfterHour   Int?
  template         ProgramTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model ProgramInstance {
  id              String          @id @default(cuid())
  templateId      String
  episodeId       String          @unique
  reservationId   String?
  programCode     String
  startsOn        DateTime
  endsOn          DateTime
  template        ProgramTemplate @relation(fields: [templateId], references: [id])
  episode         ClinicalEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  procedureLines  ProgramProcedureBalance[]

  @@index([reservationId])
}

model ProgramProcedureBalance {
  id                String          @id @default(cuid())
  instanceId        String
  procedureCode     String
  quotaTotal        Int
  quotaUsed         Int             @default(0)
  instance          ProgramInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, procedureCode])
}

model ProcedureOrder {
  id               String               @id @default(cuid())
  visitId          String?
  patientRefId     String
  procedureTypeId  String?
  procedureCode    String
  procedureName    String
  scheduledAt      DateTime
  endsAt           DateTime?
  sequenceIndex    Int?
  /// ClinicLookup BODY_PART code
  bodyPart         String?
  status           ProcedureOrderStatus @default(SCHEDULED)
  amountNet        Decimal              @default(0) @db.Decimal(12, 2)
  /// Therapist instruction / clinical note for print schedule
  note             String?              @db.Text
  quantity         Int                  @default(1)
  patientOrigin    PatientOrigin        @default(WALK_IN)
  reservationId    String?
  resourceId       String?
  /// Reception moved/assigned outside auto-planner
  manuallyAdjusted Boolean              @default(false) @map("manually_adjusted")
  /// Doctor confirmed PROPOSED → place on resources
  confirmedAt      DateTime?            @map("confirmed_at")
  confirmedByUserId String?             @map("confirmed_by_user_id")
  checkedInAt      DateTime?            @map("checked_in_at")
  checkedInByUserId String?             @map("checked_in_by_user_id")
  checkInChannel   ProcedureCheckInChannel? @map("check_in_channel")
  checkInOverrideReason String?         @map("check_in_override_reason")
  completedAt      DateTime?            @map("completed_at")
  completedByUserId String?             @map("completed_by_user_id")
  noShowAt         DateTime?            @map("no_show_at")
  noShowByUserId   String?              @map("no_show_by_user_id")
  cancelledAt      DateTime?            @map("cancelled_at")
  cancelledByUserId String?             @map("cancelled_by_user_id")
  cancelReason     String?              @map("cancel_reason")
  visit            Visit?               @relation(fields: [visitId], references: [id])
  patientRef       PatientRef           @relation(fields: [patientRefId], references: [id])
  procedureType    ProcedureType?       @relation(fields: [procedureTypeId], references: [id])
  resource         Resource?            @relation(fields: [resourceId], references: [id])
  resourceBooking  ResourceBooking?
  allocations      ProcedureAllocation[]
  createdAt        DateTime             @default(now())

  @@index([scheduledAt, status])
  @@index([patientRefId])
  @@index([resourceId, scheduledAt])
  @@index([status, scheduledAt])
}

model ProcedureAllocation {
  id               String                   @id @default(cuid())
  procedureOrderId String                   @map("procedure_order_id")
  role             ProcedureRequirementRole
  resourceId       String?                  @map("resource_id")
  practitionerId   String?                  @map("practitioner_id")
  startsAt         DateTime                 @map("starts_at")
  endsAt           DateTime                 @map("ends_at")
  procedureOrder   ProcedureOrder           @relation(fields: [procedureOrderId], references: [id], onDelete: Cascade)
  resource         Resource?                @relation(fields: [resourceId], references: [id])
  practitioner     Practitioner?            @relation(fields: [practitionerId], references: [id])

  @@index([procedureOrderId])
  @@index([resourceId, startsAt, endsAt])
  @@index([practitionerId, startsAt, endsAt])
  @@map("procedure_allocation")
}

enum InpatientAdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

model InpatientAdmission {
  id           String                   @id @default(cuid())
  patientRefId String                   @map("patient_ref_id")
  status       InpatientAdmissionStatus @default(ADMITTED)
  admittedAt   DateTime                 @default(now()) @map("admitted_at")
  dischargedAt DateTime?                @map("discharged_at")
  patient      PatientRef               @relation(fields: [patientRefId], references: [id])
  assignments  BedAssignment[]
  dailyCharges InpatientDailyCharge[]

  @@index([patientRefId, status])
}

model InpatientDailyCharge {
  id          String             @id @default(cuid())
  admissionId String             @map("admission_id")
  chargeDate  DateTime           @map("charge_date") @db.Date
  emittedAt   DateTime           @default(now()) @map("emitted_at")
  admission   InpatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@unique([admissionId, chargeDate])
  @@map("inpatient_daily_charges")
}

model Ward {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  dailyChargeCode String?  @map("daily_charge_code")
  beds            Bed[]
  createdAt       DateTime @default(now())
}

model Bed {
  id          String          @id @default(cuid())
  wardId      String
  code        String
  status      String          @default("AVAILABLE")
  ward        Ward            @relation(fields: [wardId], references: [id], onDelete: Cascade)
  assignments BedAssignment[]

  @@unique([wardId, code])
}

model BedAssignment {
  id           String              @id @default(cuid())
  bedId        String
  patientRefId String              @map("patient_ref_id")
  admissionId  String?             @map("admission_id")
  admittedAt   DateTime            @default(now()) @map("admitted_at")
  dischargedAt DateTime?           @map("discharged_at")
  bed          Bed                 @relation(fields: [bedId], references: [id], onDelete: Cascade)
  patient      PatientRef          @relation(fields: [patientRefId], references: [id])
  admission    InpatientAdmission? @relation(fields: [admissionId], references: [id])

  @@index([bedId, dischargedAt])
  @@index([admissionId])
}

model CpoeEntry {
  id          String   @id @default(cuid())
  visitId     String
  templateId  String?
  payloadJson String
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([visitId])
}

model ClinicShift {
  id             String          @id @default(cuid())
  code           String          @unique
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  status         String          @default("OPEN")
  openedByUserId String?         @map("opened_by_user_id")
  closedByUserId String?         @map("closed_by_user_id")
  /// JSON snapshot of Z-report totals at close
  zReportJson    String?         @map("z_report_json") @db.Text
  receipts       ClinicReceipt[]
}

model ClinicReceipt {
  id                  String                @id @default(cuid())
  shiftId             String
  visitId             String?
  patientRefId        String?               @map("patient_ref_id")
  status              ClinicReceiptStatus   @default(OPEN)
  channel             ClinicReceiptChannel  @default(LOCAL)
  amountGross         Decimal               @default(0) @db.Decimal(12, 2) @map("amount_gross")
  discountAmount      Decimal               @default(0) @db.Decimal(12, 2) @map("discount_amount")
  amountNet           Decimal               @default(0) @db.Decimal(12, 2)
  /// @deprecated dual-write primary method; prefer ClinicReceiptPayment rows
  paymentMethod       String?
  fiscalReceiptId     String?
  fiscalQrPayload     String?
  paidAt              DateTime?
  voidedAt            DateTime?             @map("voided_at")
  voidReason          String?               @map("void_reason")
  voidedByUserId      String?               @map("voided_by_user_id")
  reprintCount        Int                   @default(0) @map("reprint_count")
  settlementPendingId String?               @map("settlement_pending_id")
  folioChargeRef      String?               @map("folio_charge_ref")
  shift               ClinicShift           @relation(fields: [shiftId], references: [id])
  visit               Visit?                @relation(fields: [visitId], references: [id])
  patientRef          PatientRef?           @relation(fields: [patientRefId], references: [id])
  lines               ClinicReceiptLine[]
  payments            ClinicReceiptPayment[]
  createdAt           DateTime              @default(now())

  @@index([shiftId, status])
  @@index([createdAt])
  @@index([patientRefId])
  @@index([status, createdAt])
}

model ClinicReceiptLine {
  id             String                   @id @default(cuid())
  receiptId      String
  serviceCode    String
  description    String
  amount         Decimal                  @db.Decimal(12, 2)
  discountAmount Decimal                  @default(0) @db.Decimal(12, 2) @map("discount_amount")
  sourceType     ClinicReceiptLineSource  @default(VISIT_LINE) @map("source_type")
  sourceId       String?                  @map("source_id")
  receipt        ClinicReceipt            @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model ClinicReceiptPayment {
  id              String        @id @default(cuid())
  receiptId       String
  method          String
  amount          Decimal       @db.Decimal(12, 2)
  fiscalReceiptId String?       @map("fiscal_receipt_id")
  createdAt       DateTime      @default(now())
  receipt         ClinicReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

/// Over-quota / folio charge visibility for cashier (K6)
model ProcedureChargeLog {
  id               String     @id @default(cuid())
  procedureOrderId String     @map("procedure_order_id")
  patientRefId     String     @map("patient_ref_id")
  reservationId    String?    @map("reservation_id")
  procedureCode    String     @map("procedure_code")
  procedureName    String     @map("procedure_name")
  amountNet        Decimal    @db.Decimal(12, 2) @map("amount_net")
  overQuota        Boolean    @default(false) @map("over_quota")
  /// HOTEL_FOLIO | LOCAL | BLOCKED | WARN_ONLY
  channel          String
  externalTicketId String?    @map("external_ticket_id")
  settledLocally   Boolean    @default(false) @map("settled_locally")
  receiptId        String?    @map("receipt_id")
  patientRef       PatientRef @relation(fields: [patientRefId], references: [id])
  createdAt        DateTime   @default(now())

  @@index([createdAt])
  @@index([patientRefId])
  @@index([settledLocally, overQuota])
  @@index([procedureOrderId])
}

model ProcessedEvent {
  id            String   @id @default(cuid())
  correlationId String   @unique
  eventType     String
  processedAt   DateTime @default(now())

  @@index([eventType])
}

model Role {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  permissionsJson String   @default("[]")
  users           User[]
}

model User {
  id                String        @id @default(cuid())
  login             String        @unique
  email             String?
  phone             String?       @unique
  fullName          String
  passwordHash      String
  roleId            String
  role              Role          @relation(fields: [roleId], references: [id])
  status            String        @default("ACTIVE")
  isCrossSystem     Boolean       @default(false) @map("is_cross_system")
  globalPersonId    String?       @map("global_person_id")
  financeEmployeeId String?       @unique @map("finance_employee_id")
  cpEmploymentId    String?       @unique @map("cp_employment_id")
  practitioner      Practitioner?
  lastLoginAt       DateTime?     @map("last_login_at")
  createdAt         DateTime      @default(now()) @map("created_at")
}

model SatelliteAuditLog {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  changesJson   String   @default("{}") @map("changes_json")
  ipAddress     String?  @map("ip_address")
  integrityHash String?  @map("integrity_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("satellite_audit_logs")
}

model QueueTicket {
  id          String            @id @default(cuid())
  visitId     String
  queueNumber Int
  status      QueueTicketStatus @default(WAITING)
  desk        String?
  calledAt    DateTime?
  visit       Visit             @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([status, createdAt])
  @@index([visitId])
}

model LisFileProfile {
  id            String        @id @default(cuid())
  name          String        @unique
  format        LisFileFormat @default(CSV)
  delimiter     String        @default(",")
  columnMapping String        @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
