model ProcedureOrder {
  id               String               @id @default(cuid())
  organizationId String @map("organization_id")
  visitId          String?
  patientRefId     String
  /// Optional link to sanatorium care course (Pattern B / orphans may stay null).
  clinicalEpisodeId String?             @map("clinical_episode_id")
  procedureTypeId  String?
  procedureCode    String
  procedureName    String
  scheduledAt      DateTime
  endsAt           DateTime?
  sequenceIndex    Int?
  /// ClinicLookup BODY_PART code — derived from sites[] (first unique coarse; FULL_BODY wins)
  bodyPart         String?
  /// TURN = növbəli (same slot, sites in turn). TOGETHER = simultaneous. Null when <2 sites.
  siteApplyMode    ProcedureSiteApplyMode? @map("site_apply_mode")
  status           ProcedureOrderStatus @default(SCHEDULED)
  /// 5-char access code (Crockford-like, case-insensitive) assigned when the order becomes SCHEDULED.
  accessCode      String?             @map("access_code")
  amountNet        Decimal              @default(0) @db.Decimal(12, 2)
  /// Wave D: true when COMPLETED extra (over-quota / not-in-package / 4th same-day) — doctor bonus.
  bonusEligible    Boolean              @default(false) @map("bonus_eligible")
  /// Therapist instruction / clinical note for print schedule
  note             String?              @db.Text
  /// Type-gated physio values (program, substance, work-kind, …). W3.
  physioFields     Json?                @map("physio_fields")
  quantity         Int                  @default(1)
  patientOrigin    PatientOrigin        @default(WALK_IN)
  reservationId    String?
  resourceId       String?
  /// Reception moved/assigned outside auto-planner
  manuallyAdjusted Boolean              @default(false) @map("manually_adjusted")
  /// Doctor confirmed PROPOSED → place on resources
  confirmedAt      DateTime?            @map("confirmed_at")
  confirmedByUserId String?             @map("confirmed_by_user_id")
  /// Practitioner who prescribed/confirmed the procedure (doctor attribution for reports/bonuses).
  prescribedByPractitionerId String?      @map("prescribed_by_practitioner_id")
  checkedInAt      DateTime?            @map("checked_in_at")
  checkedInByUserId String?             @map("checked_in_by_user_id")
  checkInChannel   ProcedureCheckInChannel? @map("check_in_channel")
  checkInOverrideReason String?         @map("check_in_override_reason")
  completedAt      DateTime?            @map("completed_at")
  completedByUserId String?             @map("completed_by_user_id")
  /// Cutover import: historical COMPLETED rows skip folio posting and nurse bonus.
  importedHistorical Boolean             @default(false) @map("imported_historical")
  /// Dual-run extra ticket issued (3 copies). Charge is EW SPA, not COMPLETED.
  extraTicketIssuedAt DateTime?          @map("extra_ticket_issued_at")
  extraTicketId       String?            @map("extra_ticket_id")
  noShowAt         DateTime?            @map("no_show_at")
  noShowByUserId   String?              @map("no_show_by_user_id")
  cancelledAt      DateTime?            @map("cancelled_at")
  cancelledByUserId String?             @map("cancelled_by_user_id")
  cancelReason     String?              @map("cancel_reason")
  visit            Visit?               @relation(fields: [visitId], references: [id])
  patientRef       PatientRef           @relation(fields: [patientRefId], references: [id])
  clinicalEpisode  ClinicalEpisode?     @relation(fields: [clinicalEpisodeId], references: [id])
  procedureType    ProcedureType?       @relation(fields: [procedureTypeId], references: [id])
  prescribedByPractitioner Practitioner? @relation("ProcedureOrder_prescribedByPractitioner", fields: [prescribedByPractitionerId], references: [id])
  resource         Resource?            @relation(fields: [resourceId], references: [id])
  resourceBooking  ResourceBooking?
  allocations      ProcedureAllocation[]
  sites            ProcedureOrderSite[]
  createdAt        DateTime             @default(now())

  @@unique([organizationId, accessCode])
  @@index([scheduledAt, status])
  @@index([patientRefId])
  @@index([clinicalEpisodeId])
  @@index([resourceId, scheduledAt])
  @@index([status, scheduledAt])
  @@index([prescribedByPractitionerId, scheduledAt])
  @@index([organizationId])
  @@index([extraTicketId])
}

model ProcedureAllocation {
  id               String                   @id @default(cuid())
  procedureOrderId String                   @map("procedure_order_id")
  role             ProcedureRequirementRole
  resourceId       String?                  @map("resource_id")
  practitionerId   String?                  @map("practitioner_id")
  startsAt         DateTime                 @map("starts_at")
  endsAt           DateTime                 @map("ends_at")
  procedureOrder   ProcedureOrder           @relation(fields: [procedureOrderId], references: [id], onDelete: Cascade)
  resource         Resource?                @relation(fields: [resourceId], references: [id])
  practitioner     Practitioner?            @relation(fields: [practitionerId], references: [id])

  @@index([procedureOrderId])
  @@index([resourceId, startsAt, endsAt])
  @@index([practitionerId, startsAt, endsAt])
  @@map("procedure_allocation")
}

enum ProcedureSiteApplyMode {
  TOGETHER
  TURN
}

enum ProcedureSiteLaterality {
  LEFT
  RIGHT
  BOTH
}

/// Ordered S chips on a procedure order. Laterality only when the site catalog allows it.
model ProcedureOrderSite {
  id               String                   @id @default(cuid())
  organizationId   String                   @map("organization_id")
  procedureOrderId String                   @map("procedure_order_id")
  siteId           String                   @map("site_id")
  sortOrder        Int                      @default(0) @map("sort_order")
  laterality       ProcedureSiteLaterality?
  procedureOrder   ProcedureOrder           @relation(fields: [procedureOrderId], references: [id], onDelete: Cascade)
  site             PhysioSite               @relation(fields: [siteId], references: [id], onDelete: Restrict)

  @@unique([procedureOrderId, siteId])
  @@index([procedureOrderId, sortOrder])
  @@index([organizationId])
  @@map("procedure_order_site")
}

enum PhysioNahiyeQueueStatus {
  OPEN
  RESOLVED
  NOT_ANATOMY
}

/// SatAdmin synonym queue for unmatched / partial WO nahiye (CLI-49 W4).
model PhysioNahiyeQueue {
  id                   String                   @id @default(cuid())
  organizationId       String                   @map("organization_id")
  normalizedText       String                   @map("normalized_text")
  sampleRaw            String                   @map("sample_raw") @db.Text
  residue              String                   @db.Text
  bucket               String
  sampleProcedureName  String?                  @map("sample_procedure_name")
  hitCount             Int                      @default(1) @map("hit_count")
  status               PhysioNahiyeQueueStatus  @default(OPEN)
  suggestedSiteCode    String?                  @map("suggested_site_code")
  lastOrderId          String?                  @map("last_order_id")
  createdAt            DateTime                 @default(now()) @map("created_at")
  updatedAt            DateTime                 @updatedAt @map("updated_at")

  @@unique([organizationId, normalizedText])
  @@index([organizationId, status, hitCount])
  @@map("physio_nahiye_queue")
}

enum InpatientAdmissionStatus {
  ADMITTED
  DISCHARGED
  TRANSFERRED
}

model InpatientAdmission {
  id           String                   @id @default(cuid())
  organizationId String @map("organization_id")
  patientRefId String                   @map("patient_ref_id")
  status       InpatientAdmissionStatus @default(ADMITTED)
  admittedAt   DateTime                 @default(now()) @map("admitted_at")
  dischargedAt DateTime?                @map("discharged_at")
  patient      PatientRef               @relation(fields: [patientRefId], references: [id])
  assignments  BedAssignment[]
  dailyCharges InpatientDailyCharge[]
  diagnoses    AdmissionDiagnosis[]

  @@index([patientRefId, status])
  @@index([organizationId])
}

model InpatientDailyCharge {
  id          String             @id @default(cuid())
  admissionId String             @map("admission_id")
  chargeDate  DateTime           @map("charge_date") @db.Date
  emittedAt   DateTime           @default(now()) @map("emitted_at")
  admission   InpatientAdmission @relation(fields: [admissionId], references: [id], onDelete: Cascade)

  @@unique([admissionId, chargeDate])
  @@map("inpatient_daily_charges")
}

model Ward {
  id              String   @id @default(cuid())
  organizationId String @map("organization_id")
  code            String
  name            String
  dailyChargeCode String?  @map("daily_charge_code")
  beds            Bed[]
  createdAt       DateTime @default(now())
  @@unique([organizationId, code])
  @@index([organizationId])
}

model Bed {
  id          String          @id @default(cuid())
  organizationId String @map("organization_id")
  wardId      String
  code        String
  status      String          @default("AVAILABLE")
  ward        Ward            @relation(fields: [wardId], references: [id], onDelete: Cascade)
  assignments BedAssignment[]

  @@unique([wardId, code])
  @@index([organizationId])
}

model BedAssignment {
  id           String              @id @default(cuid())
  organizationId String @map("organization_id")
  bedId        String
  patientRefId String              @map("patient_ref_id")
  admissionId  String?             @map("admission_id")
  admittedAt   DateTime            @default(now()) @map("admitted_at")
  dischargedAt DateTime?           @map("discharged_at")
  bed          Bed                 @relation(fields: [bedId], references: [id], onDelete: Cascade)
  patient      PatientRef          @relation(fields: [patientRefId], references: [id])
  admission    InpatientAdmission? @relation(fields: [admissionId], references: [id])

  @@index([bedId, dischargedAt])
  @@index([admissionId])
  @@index([organizationId])
}

model CpoeEntry {
  id          String   @id @default(cuid())
  organizationId String @map("organization_id")
  visitId     String
  templateId  String?
  payloadJson String
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([visitId])
  @@index([organizationId])
}

model ClinicShift {
  id             String          @id @default(cuid())
  organizationId String @map("organization_id")
  code           String
  openedAt       DateTime        @default(now())
  closedAt       DateTime?
  status         String          @default("OPEN")
  openedByUserId String?         @map("opened_by_user_id")
  closedByUserId String?         @map("closed_by_user_id")
  /// JSON snapshot of Z-report totals at close
  zReportJson    String?         @map("z_report_json") @db.Text
  receipts       ClinicReceipt[]
  @@unique([organizationId, code])
  @@index([organizationId])
}

model ClinicReceipt {
  id                  String                @id @default(cuid())
  organizationId String @map("organization_id")
  shiftId             String
  visitId             String?
  patientRefId        String?               @map("patient_ref_id")
  status              ClinicReceiptStatus   @default(OPEN)
  channel             ClinicReceiptChannel  @default(LOCAL)
  amountGross         Decimal               @default(0) @db.Decimal(12, 2) @map("amount_gross")
  discountAmount      Decimal               @default(0) @db.Decimal(12, 2) @map("discount_amount")
  amountNet           Decimal               @default(0) @db.Decimal(12, 2)
  /// @deprecated dual-write primary method; prefer ClinicReceiptPayment rows
  paymentMethod       String?
  fiscalReceiptId     String?
  fiscalQrPayload     String?
  paidAt              DateTime?
  voidedAt            DateTime?             @map("voided_at")
  voidReason          String?               @map("void_reason")
  voidedByUserId      String?               @map("voided_by_user_id")
  reprintCount        Int                   @default(0) @map("reprint_count")
  settlementPendingId String?               @map("settlement_pending_id")
  folioChargeRef      String?               @map("folio_charge_ref")
  shift               ClinicShift           @relation(fields: [shiftId], references: [id])
  visit               Visit?                @relation(fields: [visitId], references: [id])
  patientRef          PatientRef?           @relation(fields: [patientRefId], references: [id])
  lines               ClinicReceiptLine[]
  payments            ClinicReceiptPayment[]
  createdAt           DateTime              @default(now())

  @@index([shiftId, status])
  @@index([createdAt])
  @@index([patientRefId])
  @@index([status, createdAt])
  @@index([organizationId])
}

model ClinicReceiptLine {
  id             String                   @id @default(cuid())
  receiptId      String
  serviceCode    String
  description    String
  amount         Decimal                  @db.Decimal(12, 2)
  discountAmount Decimal                  @default(0) @db.Decimal(12, 2) @map("discount_amount")
  sourceType     ClinicReceiptLineSource  @default(VISIT_LINE) @map("source_type")
  sourceId       String?                  @map("source_id")
  receipt        ClinicReceipt            @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model ClinicReceiptPayment {
  id              String        @id @default(cuid())
  receiptId       String
  method          String
  amount          Decimal       @db.Decimal(12, 2)
  fiscalReceiptId String?       @map("fiscal_receipt_id")
  createdAt       DateTime      @default(now())
  receipt         ClinicReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

/// Over-quota / folio charge visibility for cashier (K6)
model ProcedureChargeLog {
  id               String     @id @default(cuid())
  organizationId String @map("organization_id")
  procedureOrderId String     @map("procedure_order_id")
  patientRefId     String     @map("patient_ref_id")
  reservationId    String?    @map("reservation_id")
  procedureCode    String     @map("procedure_code")
  procedureName    String     @map("procedure_name")
  amountNet        Decimal    @db.Decimal(12, 2) @map("amount_net")
  overQuota        Boolean    @default(false) @map("over_quota")
  /// HOTEL_FOLIO | LOCAL | BLOCKED | WARN_ONLY
  channel          String
  externalTicketId String?    @map("external_ticket_id")
  settledLocally   Boolean    @default(false) @map("settled_locally")
  receiptId        String?    @map("receipt_id")
  patientRef       PatientRef @relation(fields: [patientRefId], references: [id])
  createdAt        DateTime   @default(now())

  @@index([createdAt])
  @@index([patientRefId])
  @@index([settledLocally, overQuota])
  @@index([procedureOrderId])
  @@index([organizationId])
}

model ProcessedEvent {
  id            String   @id @default(cuid())
  organizationId String @map("organization_id")
  correlationId String
  eventType     String
  processedAt   DateTime @default(now())

  @@index([eventType])
  @@unique([organizationId, correlationId])
  @@index([organizationId])
}

model Role {
  id              String   @id @default(cuid())
  organizationId String @map("organization_id")
  code            String
  name            String
  permissionsJson String   @default("[]")
  users           User[]
  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id                String        @id @default(cuid())
  organizationId String @map("organization_id")
  login             String
  email             String?
  phone             String?       
  fullName          String
  passwordHash      String
  roleId            String
  role              Role          @relation(fields: [roleId], references: [id])
  status            String        @default("ACTIVE")
  isCrossSystem     Boolean       @default(false) @map("is_cross_system")
  globalPersonId    String?       @map("global_person_id")
  financeEmployeeId String?       @unique @map("finance_employee_id")
  cpEmploymentId    String?       @unique @map("cp_employment_id")
  practitioner      Practitioner?
  lastLoginAt       DateTime?     @map("last_login_at")
  createdAt         DateTime      @default(now()) @map("created_at")
  @@unique([organizationId, login])
  @@unique([organizationId, phone])
  @@index([organizationId])
}

model SatelliteAuditLog {
  id            String   @id @default(cuid())
  organizationId String @map("organization_id")
  userId        String?  @map("user_id")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  changesJson   String   @default("{}") @map("changes_json")
  ipAddress     String?  @map("ip_address")
  integrityHash String?  @map("integrity_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("satellite_audit_logs")
  @@index([organizationId])
}

model QueueTicket {
  id          String            @id @default(cuid())
  organizationId String @map("organization_id")
  visitId     String
  queueNumber Int
  status      QueueTicketStatus @default(WAITING)
  desk        String?
  calledAt    DateTime?
  visit       Visit             @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([status, createdAt])
  @@index([visitId])
  @@index([organizationId])
}

model LisFileProfile {
  id            String        @id @default(cuid())
  organizationId String @map("organization_id")
  name          String
  format        LisFileFormat @default(CSV)
  delimiter     String        @default(",")
  columnMapping String        @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@unique([organizationId, name])
  @@index([organizationId])
}

model CutoverImportKey {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  entity         String
  externalRef    String   @map("external_ref")
  recordId       String   @map("record_id")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([organizationId, entity, externalRef])
  @@index([organizationId])
  @@map("cutover_import_key")
}

/// Per-org clinic cutover (Super-Admin / Sync). Not CLINIC_ELEKTRAWEB_DUAL_RUN env.
model ClinicCutoverPolicy {
  organizationId        String   @id @map("organization_id")
  elektrawebDualRun     Boolean  @default(false) @map("elektraweb_dual_run")
  hotelOrganizationId   String?  @map("hotel_organization_id")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("clinic_cutover_policy")
}
