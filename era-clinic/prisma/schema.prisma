enum ProcedureRuleKind {
  SEQUENCE_GAP
  MUTUAL_EXCLUSION
}

enum ProcedureCompatibilityRuleType {
  FORBID_SAME_DAY
  MIN_HOURS_GAP
  FORBID_SEQUENCE
}

model ProcedureCompatibilityRule {
  id              String                         @id @default(cuid())
  organizationId String @map("organization_id")
  procedureCodeA  String
  procedureCodeB  String
  ruleType        ProcedureCompatibilityRuleType
  minHours        Int?
  active          Boolean                        @default(true)
  note            String?
  createdAt       DateTime                       @default(now())

  @@index([procedureCodeA])
  @@index([procedureCodeB])
  @@index([active])
  @@index([organizationId])
}

model ProcedureType {
  id                 String        @id @default(cuid())
  organizationId String @map("organization_id")
  code               String
  name               String
  durationMin        Int           @default(30)
  /// Cabin/device idle minutes after occupancy ends (0 = back-to-back). ADR clinic-scheduling-time-layers.
  resourceGapMinutes Int           @default(5) @map("resource_gap_minutes")
  /// Guest rest before any next same-day procedure (WO PatientGapMin). Not cabin idle.
  patientRestMinutes Int           @default(15) @map("patient_rest_minutes")
  resourceKind       ResourceKind?
  resourceCode       String?
  /// ClinicLookup BODY_PART code
  bodyPart           String?
  /// When false, doctor does not pick S (ozone, inhalation, IV). Seeded from SKU; SatAdmin can override.
  needsSite          Boolean       @default(true) @map("needs_site")
  /// Order-field codes (DEVICE_PROGRAM, SUBSTANCE_OR_ADDITIVE, …). Empty = sites + note only.
  physioOrderFields  String[]      @default([]) @map("physio_order_fields")
  afterLunchAllowed  Boolean       @default(true)
  /// When false, slot must start at or after lunchEndHour (men 4-chamber after lunch).
  beforeLunchAllowed Boolean       @default(true) @map("before_lunch_allowed")
  /// Optional wall-clock start (Asia/Baku hour). Null = tenant dayStartHour.
  dayStartHour       Int?          @map("day_start_hour")
  /// Optional exclusive end hour. Null = tenant dayEndHour.
  dayEndHour         Int?          @map("day_end_hour")
  /// When peak mode is on, this procedure may run until this hour (exclusive)
  extendedEndHour    Int?          @map("extended_end_hour")
  orders             ProcedureOrder[]
  requirements       ProcedureTypeRequirement[]
  consumableLines    ProcedureConsumableLine[]
  skills             PractitionerSkill[]
  dutyLines          StaffDutyLine[]

  @@index([resourceCode])
  @@unique([organizationId, code])
  @@index([organizationId])
}

/// Cabin TTK / consumable BOM per procedure session (Finance warehouse SKUs).
/// Not manufacturing ProductRecipe; not retail pharmacy.
model ProcedureConsumableLine {
  id               String        @id @default(cuid())
  organizationId   String        @map("organization_id")
  procedureTypeId  String        @map("procedure_type_id")
  /// Org-stable Finance product SKU
  sku              String
  /// Optional Finance Product.id (UUID) when resolved from picker
  financeProductId String?       @map("finance_product_id")
  qtyPerSession    Decimal       @default(1) @map("qty_per_session") @db.Decimal(19, 4)
  wasteFactor      Decimal       @default(0) @map("waste_factor") @db.Decimal(19, 6)
  procedureType    ProcedureType @relation(fields: [procedureTypeId], references: [id], onDelete: Cascade)
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  @@unique([procedureTypeId, sku])
  @@index([procedureTypeId])
  @@index([organizationId])
  @@map("procedure_consumable_line")
}

/// Monthly duty roster: which nurse (or lab tech) sits on which procedure/device.
/// Distinct from PractitionerSkill (capability) and CLI-36 shifts (when they work).
model StaffDutyRoster {
  id                  String                 @id @default(cuid())
  organizationId      String                 @map("organization_id")
  /// Calendar month in Asia/Baku, `YYYY-MM`
  yearMonth           String                 @map("year_month")
  staffKind           PractitionerStaffKind  @default(NURSE) @map("staff_kind")
  status              StaffDutyRosterStatus  @default(DRAFT)
  approvedAt          DateTime?              @map("approved_at")
  approvedByUserId    String?                @map("approved_by_user_id")
  copiedFromYearMonth String?                @map("copied_from_year_month")
  note                String?
  lines               StaffDutyLine[]
  createdAt           DateTime               @default(now()) @map("created_at")
  updatedAt           DateTime               @updatedAt @map("updated_at")

  @@unique([organizationId, yearMonth, staffKind])
  @@index([organizationId])
  @@map("staff_duty_roster")
}

model StaffDutyLine {
  id              String        @id @default(cuid())
  organizationId  String        @map("organization_id")
  rosterId        String        @map("roster_id")
  roster          StaffDutyRoster @relation(fields: [rosterId], references: [id], onDelete: Cascade)
  procedureTypeId String        @map("procedure_type_id")
  procedureType   ProcedureType @relation(fields: [procedureTypeId], references: [id], onDelete: Cascade)
  practitionerId  String?       @map("practitioner_id")
  practitioner    Practitioner? @relation(fields: [practitionerId], references: [id], onDelete: SetNull)
  /// Carry this assignment into the next month's draft
  stable          Boolean       @default(false)
  sortOrder       Int           @default(0) @map("sort_order")
  note            String?
  createdAt       DateTime      @default(now()) @map("created_at")

  @@unique([rosterId, procedureTypeId])
  @@index([practitionerId])
  @@index([organizationId])
  @@map("staff_duty_line")
}

/// Clinic-local absence overlay (vacation / sick / training). Finance HR sync is later.
model StaffAbsence {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  practitionerId String           @map("practitioner_id")
  practitioner   Practitioner     @relation(fields: [practitionerId], references: [id], onDelete: Cascade)
