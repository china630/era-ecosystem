enum IcdCodeKind {
  CHAPTER
  BLOCK
  CATEGORY
  LEAF
}

enum DiagnosisRole {
  PRIMARY
  SECONDARY
}

enum AdmissionDiagnosisKind {
  ADMISSION
  DISCHARGE
}

/// Global WHO ICD-10 catalog — platform reference, never tenant-scoped (no organizationId).
model IcdCode {
