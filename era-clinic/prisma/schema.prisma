generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  outlets   Outlet[]
}

enum LabOrderStatus {
  ORDERED
  COLLECTED
  IN_PROGRESS
  RESULT_READY
  PUBLISHED
  COMPLETED
}

enum PatientOrigin {
  WALK_IN
  IN_HOUSE
}

enum AppointmentStatus {
  SCHEDULED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum VisitStatus {
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum BillingTarget {
  FINANCE
  HOTEL_FOLIO
}

enum ResourceKind {
  ROOM
  EQUIPMENT
}

enum ProcedureOrderStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum ClinicReceiptStatus {
  OPEN
  PAID
  VOID
}

enum QueueTicketStatus {
  WAITING
  CALLED
  SERVED
  SKIPPED
}

enum LisFileFormat {
  CSV
  HL7_FRAGMENT
}

model Outlet {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  preset    String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
}

model PatientRef {
  id               String            @id @default(cuid())
  refCode          String            @unique
  fullName         String
  phone            String?
  nationality      String?           @default("AZ")
  finCode          String?
  passportNumber   String?
  issuingCountry   String?
  globalPersonId   String?
  appointments     Appointment[]
  visits           Visit[]
  labOrders        LabOrder[]
  episodes         ClinicalEpisode[]
  procedureOrders       ProcedureOrder[]
  contraindications     PatientContraindication[]
  createdAt             DateTime          @default(now())
}

model Practitioner {
  id             String          @id @default(cuid())
  code           String          @unique
  fullName       String
  specialty      String?
  appointments   Appointment[]
  visits         Visit[]
  resourceBookings ResourceBooking[]
}

model Room {
  id        String     @id @default(cuid())
  code      String     @unique
  name      String
  resources Resource[]
  createdAt DateTime   @default(now())
}

model Resource {
  id               String            @id @default(cuid())
  code             String            @unique
  name             String
  kind             ResourceKind      @default(EQUIPMENT)
  capacity         Int               @default(1)
  roomId           String?
  room             Room?             @relation(fields: [roomId], references: [id])
  bookings         ResourceBooking[]
  procedureOrders  ProcedureOrder[]
  createdAt        DateTime          @default(now())
}

model ResourceBooking {
  id              String          @id @default(cuid())
  resourceId      String
  practitionerId  String?
  appointmentId   String?         @unique
  procedureOrderId String?        @unique
  startsAt        DateTime
  endsAt          DateTime
  resource        Resource        @relation(fields: [resourceId], references: [id])
  practitioner    Practitioner?   @relation(fields: [practitionerId], references: [id])
  appointment     Appointment?    @relation(fields: [appointmentId], references: [id])
  procedureOrder  ProcedureOrder? @relation(fields: [procedureOrderId], references: [id])

  @@index([resourceId, startsAt, endsAt])
}

model Appointment {
  id             String            @id @default(cuid())
  patientRefId   String
  practitionerId String
  scheduledAt    DateTime
  roomCode       String?
  status         AppointmentStatus @default(SCHEDULED)
  reminderSentAt DateTime?
  patientRef     PatientRef        @relation(fields: [patientRefId], references: [id])
  practitioner   Practitioner      @relation(fields: [practitionerId], references: [id])
  visit          Visit?
  resourceBooking ResourceBooking?
  createdAt      DateTime          @default(now())

  @@index([scheduledAt, status])
}

model Visit {
  id             String               @id @default(cuid())
  appointmentId  String?              @unique
  patientRefId   String
  practitionerId String
  status         VisitStatus          @default(IN_PROGRESS)
  patientOrigin  PatientOrigin        @default(WALK_IN)
  billingTarget  BillingTarget        @default(FINANCE)
  reservationId  String?
  roomNumber     String?
  amountNet      Decimal              @default(0) @db.Decimal(12, 2)
  completedAt    DateTime?
  patientRef     PatientRef           @relation(fields: [patientRefId], references: [id])
  practitioner   Practitioner         @relation(fields: [practitionerId], references: [id])
  appointment    Appointment?         @relation(fields: [appointmentId], references: [id])
  serviceLines   VisitServiceLine[]
  labOrders      LabOrder[]
  discountAudits VisitDiscountAudit[]
  cpoeEntries    CpoeEntry[]
  procedureOrders ProcedureOrder[]
  receipts       ClinicReceipt[]
  queueTickets   QueueTicket[]
  createdAt      DateTime             @default(now())

  @@index([patientRefId, status])
}

model VisitServiceLine {
  id          String  @id @default(cuid())
  visitId     String
  serviceCode String
  description String
  amount      Decimal @db.Decimal(12, 2)
  visit       Visit   @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId])
}

model LabOrder {
  id                String         @id @default(cuid())
  patientRefId      String
  visitId           String?
  clinicalEpisodeId String?
  testCode          String
  status            LabOrderStatus @default(ORDERED)
  amountNet         Decimal        @default(0) @db.Decimal(12, 2)
  collectedAt       DateTime?
  resultJson        String?
  publishedAt       DateTime?
  telehealthUrl     String?
  completedAt       DateTime?
  patientRef        PatientRef     @relation(fields: [patientRefId], references: [id])
  visit             Visit?         @relation(fields: [visitId], references: [id])
  episode           ClinicalEpisode? @relation(fields: [clinicalEpisodeId], references: [id])
  createdAt         DateTime       @default(now())

  @@index([patientRefId, status])
  @@index([visitId])
  @@index([clinicalEpisodeId])
}

model ClinicalEpisode {
  id             String              @id @default(cuid())
  patientRefId   String?
  patientRef     PatientRef?         @relation(fields: [patientRefId], references: [id])
  globalPersonId String?
  hotelStayId    String?
  reservationId  String?
  organizationId String
  patientOrigin  PatientOrigin       @default(IN_HOUSE)
  programCode    String?
  status         String              @default("OPEN")
  openedAt       DateTime            @default(now())
  closedAt       DateTime?
  complaints     ClinicalComplaint[]
  diagnoses      ClinicalDiagnosis[]
  labOrders      LabOrder[]
  programInstance ProgramInstance?

  @@index([reservationId])
  @@index([organizationId, status])
}

model ClinicalComplaint {
  id         String          @id @default(cuid())
  episodeId  String
  episode    ClinicalEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  text       String
  recordedAt DateTime        @default(now())

  @@index([episodeId])
}

model ClinicalDiagnosis {
  id          String          @id @default(cuid())
  episodeId   String
  episode     ClinicalEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  icdCodeId   String?
  icdCode     IcdCode?        @relation(fields: [icdCodeId], references: [id])
  icdCodeText String?
  description String
  recordedAt  DateTime        @default(now())

  @@index([episodeId])
}

model IcdCode {
  id          String              @id @default(cuid())
  code        String              @unique
  description String
  diagnoses   ClinicalDiagnosis[]
}

enum BodyPart {
  HEAD
  NECK
  CHEST
  BACK
  ABDOMEN
  ARM_LEFT
  ARM_RIGHT
  LEG_LEFT
  LEG_RIGHT
  FULL_BODY
}

enum ProcedureRuleKind {
  SEQUENCE_GAP
  MUTUAL_EXCLUSION
}

enum ProcedureCompatibilityRuleType {
  FORBID_SAME_DAY
  MIN_HOURS_GAP
  FORBID_SEQUENCE
}

model ProcedureCompatibilityRule {
  id              String                         @id @default(cuid())
  procedureCodeA  String
  procedureCodeB  String
  ruleType        ProcedureCompatibilityRuleType
  minHours        Int?
  active          Boolean                        @default(true)
  note            String?
  createdAt       DateTime                       @default(now())

  @@index([procedureCodeA])
  @@index([procedureCodeB])
  @@index([active])
}

model ProcedureType {
  id                 String        @id @default(cuid())
  code               String        @unique
  name               String
  durationMin        Int           @default(30)
  resourceKind       ResourceKind?
  resourceCode       String?
  bodyPart           BodyPart?
  afterLunchAllowed  Boolean       @default(true)
  orders             ProcedureOrder[]

  @@index([resourceCode])
}

model ProcedureRule {
  id              String             @id @default(cuid())
  beforeCode      String
  afterCode       String
  kind            ProcedureRuleKind  @default(SEQUENCE_GAP)
  minGapMinutes   Int                @default(0)
  bodyPart        BodyPart?

  @@index([beforeCode])
  @@index([afterCode])
}

model PatientContraindication {
  id           String     @id @default(cuid())
  patientRefId String
  bodyPart     BodyPart
  note         String?
  patientRef   PatientRef @relation(fields: [patientRefId], references: [id], onDelete: Cascade)
  createdAt    DateTime   @default(now())

  @@index([patientRefId])
}

model ServiceCatalogCache {
  id          String   @id @default(cuid())
  code        String   @unique
  description String
  amount      Decimal  @db.Decimal(12, 2)
  syncedAt    DateTime @default(now())
}

model VisitDiscountAudit {
  id         String   @id @default(cuid())
  visitId    String
  percent    Decimal  @db.Decimal(5, 2)
  approvedBy String
  reason     String
  visit      Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([visitId])
}

model ClinicalTemplate {
  id          String   @id @default(cuid())
  code        String   @unique
  title       String
  specialty   String?
  bodyJson    String
  createdAt   DateTime @default(now())
}

model ProgramTemplate {
  id          String                  @id @default(cuid())
  code        String                  @unique
  name        String
  durationDays Int
  procedures  ProgramTemplateProcedure[]
  instances   ProgramInstance[]
}

model ProgramTemplateProcedure {
  id               String          @id @default(cuid())
  templateId       String
  procedureCode    String
  procedureName    String
  quotaTotal       Int
  minGapMinutes    Int?
  avoidAfterHour   Int?
  template         ProgramTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  @@index([templateId])
}

model ProgramInstance {
  id              String          @id @default(cuid())
  templateId      String
  episodeId       String          @unique
  reservationId   String?
  programCode     String
  startsOn        DateTime
  endsOn          DateTime
  template        ProgramTemplate @relation(fields: [templateId], references: [id])
  episode         ClinicalEpisode @relation(fields: [episodeId], references: [id], onDelete: Cascade)
  procedureLines  ProgramProcedureBalance[]

  @@index([reservationId])
}

model ProgramProcedureBalance {
  id                String          @id @default(cuid())
  instanceId        String
  procedureCode     String
  quotaTotal        Int
  quotaUsed         Int             @default(0)
  instance          ProgramInstance @relation(fields: [instanceId], references: [id], onDelete: Cascade)

  @@unique([instanceId, procedureCode])
}

model ProcedureOrder {
  id               String               @id @default(cuid())
  visitId          String?
  patientRefId     String
  procedureTypeId  String?
  procedureCode    String
  procedureName    String
  scheduledAt      DateTime
  endsAt           DateTime?
  sequenceIndex    Int?
  bodyPart         BodyPart?
  status           ProcedureOrderStatus @default(SCHEDULED)
  amountNet        Decimal              @default(0) @db.Decimal(12, 2)
  patientOrigin    PatientOrigin        @default(WALK_IN)
  reservationId    String?
  resourceId       String?
  visit            Visit?               @relation(fields: [visitId], references: [id])
  patientRef       PatientRef           @relation(fields: [patientRefId], references: [id])
  procedureType    ProcedureType?       @relation(fields: [procedureTypeId], references: [id])
  resource         Resource?            @relation(fields: [resourceId], references: [id])
  resourceBooking  ResourceBooking?
  createdAt        DateTime             @default(now())

  @@index([scheduledAt, status])
  @@index([patientRefId])
  @@index([resourceId, scheduledAt])
}

model Ward {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  beds      Bed[]
  createdAt DateTime @default(now())
}

model Bed {
  id          String          @id @default(cuid())
  wardId      String
  code        String
  status      String          @default("AVAILABLE")
  ward        Ward            @relation(fields: [wardId], references: [id], onDelete: Cascade)
  assignments BedAssignment[]

  @@unique([wardId, code])
}

model BedAssignment {
  id           String    @id @default(cuid())
  bedId        String
  patientRefId String
  admittedAt   DateTime  @default(now())
  dischargedAt DateTime?
  bed          Bed       @relation(fields: [bedId], references: [id], onDelete: Cascade)

  @@index([bedId, dischargedAt])
}

model CpoeEntry {
  id          String   @id @default(cuid())
  visitId     String
  templateId  String?
  payloadJson String
  visit       Visit    @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())

  @@index([visitId])
}

model ClinicShift {
  id        String          @id @default(cuid())
  code      String          @unique
  openedAt  DateTime        @default(now())
  closedAt  DateTime?
  status    String          @default("OPEN")
  receipts  ClinicReceipt[]
}

model ClinicReceipt {
  id              String              @id @default(cuid())
  shiftId         String
  visitId         String?
  status          ClinicReceiptStatus @default(OPEN)
  amountNet       Decimal             @default(0) @db.Decimal(12, 2)
  paymentMethod   String?
  fiscalReceiptId String?
  fiscalQrPayload String?
  paidAt          DateTime?
  shift           ClinicShift         @relation(fields: [shiftId], references: [id])
  visit           Visit?              @relation(fields: [visitId], references: [id])
  lines           ClinicReceiptLine[]
  createdAt       DateTime            @default(now())

  @@index([shiftId, status])
}

model ClinicReceiptLine {
  id          String        @id @default(cuid())
  receiptId   String
  serviceCode String
  description String
  amount      Decimal       @db.Decimal(12, 2)
  receipt     ClinicReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade)

  @@index([receiptId])
}

model ProcessedEvent {
  id            String   @id @default(cuid())
  correlationId String   @unique
  eventType     String
  processedAt   DateTime @default(now())

  @@index([eventType])
}

model Role {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  permissionsJson String   @default("[]")
  users           User[]
}

model User {
  id            String    @id @default(cuid())
  login         String    @unique
  email         String?
  phone         String?   @unique
  fullName      String
  passwordHash  String
  roleId        String
  role          Role      @relation(fields: [roleId], references: [id])
  status        String    @default("ACTIVE")
  isCrossSystem Boolean   @default(false) @map("is_cross_system")
  lastLoginAt   DateTime? @map("last_login_at")
  createdAt     DateTime  @default(now()) @map("created_at")
}

model SatelliteAuditLog {
  id            String   @id @default(cuid())
  userId        String?  @map("user_id")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  changesJson   String   @default("{}") @map("changes_json")
  ipAddress     String?  @map("ip_address")
  integrityHash String?  @map("integrity_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("satellite_audit_logs")
}

model QueueTicket {
  id          String            @id @default(cuid())
  visitId     String
  queueNumber Int
  status      QueueTicketStatus @default(WAITING)
  desk        String?
  calledAt    DateTime?
  visit       Visit             @relation(fields: [visitId], references: [id], onDelete: Cascade)
  createdAt   DateTime          @default(now())

  @@index([status, createdAt])
  @@index([visitId])
}

model LisFileProfile {
  id            String        @id @default(cuid())
  name          String        @unique
  format        LisFileFormat @default(CSV)
  delimiter     String        @default(",")
  columnMapping String        @default("{}")
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}
