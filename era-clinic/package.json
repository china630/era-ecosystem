{
  "name": "era-clinic",
  "version": "0.1.0",
  "private": true,
  "description": "Appointments, visits, services",
  "scripts": {
    "dev": "next dev -p 3203",
    "build": "prisma generate && next build",
    "start": "next start -p 3203",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed:vnext": "npx tsx prisma/seed-vnext.ts",
    "db:seed": "npx tsx prisma/seed-vnext.ts && node prisma/load-icd10.cjs && node prisma/load-nafta-prices.cjs && node prisma/load-sanatorium-week.cjs && node prisma/seed-diagnostic-catalog.cjs && node prisma/backfill-lab-order-items.cjs && node prisma/load-lab-usg-demo.cjs && node prisma/seed-planning-rules.cjs",
    "db:seed:icd10": "node prisma/load-icd10.cjs",
    "test": "jest --ci",
    "db:seed:sanatorium-week": "node prisma/load-sanatorium-week.cjs",
    "db:seed:lab-usg": "node prisma/load-lab-usg-demo.cjs",
    "db:seed:planning-rules": "node prisma/seed-planning-rules.cjs",
    "db:seed:diagnostic-catalog": "node prisma/seed-diagnostic-catalog.cjs",
    "db:seed:backfill-lab-items": "node prisma/backfill-lab-order-items.cjs"
  },
  "dependencies": {
    "@era/clinic-domain": "file:../packages/clinic-domain",
    "@era/contracts": "file:../packages/era-contracts",
    "@era/fiscal": "file:../packages/era-fiscal",
    "@era/satellite-kit": "file:../packages/satellite-kit",
    "@prisma/client": "^6.9.0",
    "next": "^15.3.3",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.25.36",
    "jose": "^6.0.11",
    "xlsx": "^0.18.5",
    "@era/i18n-common": "file:../packages/i18n-common",
    "next-intl": "^4.12.0",
    "lucide-react": "^0.511.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "jest": "^29.7.0",
    "prisma": "^6.9.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.3",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.4",
    "tailwindcss": "^3.4.17"
  }
}
