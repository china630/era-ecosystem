{
  "name": "era-clinic",
  "version": "0.1.0",
  "private": true,
  "description": "Appointments, visits, services",
  "scripts": {
    "dev": "next dev -p 3203",
    "build": "prisma generate && next build",
    "start": "next start -p 3203",
    "lint": "next lint",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:seed:vnext": "npx tsx prisma/seed-vnext.ts",
    "db:seed:physio": "npx tsx prisma/seed-physio-catalog.ts",
    "db:seed:physio:base": "npx tsx prisma/seed-physio-catalog-base.ts",
    "db:seed:physio:nafta": "npx tsx prisma/seed-physio-catalog-nafta.ts",
    "db:seed": "node prisma/load-icd10.cjs && npx tsx prisma/seed-physio-catalog-base.ts && node prisma/seed-diagnostic-catalog-base.cjs",
    "db:seed:demo": "npx tsx prisma/seed-vnext.ts && node prisma/load-icd10.cjs && node prisma/load-nafta-prices.cjs && node prisma/load-sanatorium-week.cjs && node prisma/seed-diagnostic-catalog.cjs && npx tsx prisma/seed-physio-catalog.ts && node prisma/backfill-lab-order-items.cjs && node prisma/load-lab-usg-demo.cjs && npx tsx prisma/seed-planning-rules.ts && node prisma/seed-intake-blocks.mjs",
    "db:seed:intake-blocks": "node prisma/seed-intake-blocks.mjs",
    "db:seed:icd10": "node prisma/load-icd10.cjs",
    "db:seed:nafta-prices": "node prisma/load-nafta-prices.cjs",
    "test": "jest --ci",
    "audit:admin-api-map": "node scripts/audit-admin-api-map.mjs",
    "db:seed:sanatorium-week": "node prisma/load-sanatorium-week.cjs",
    "db:seed:lab-usg": "node prisma/load-lab-usg-demo.cjs",
    "db:seed:planning-rules": "npx tsx prisma/seed-planning-rules.ts",
    "db:seed:diagnostic-catalog": "node prisma/seed-diagnostic-catalog.cjs",
    "db:seed:diagnostic-catalog:base": "node prisma/seed-diagnostic-catalog-base.cjs",
    "db:seed:diagnostic-catalog:nafta": "node prisma/seed-diagnostic-catalog-nafta.cjs",
    "db:seed:backfill-lab-items": "node prisma/backfill-lab-order-items.cjs",
    "nest:generate": "node scripts/generate-nest.mjs",
    "nest": "tsx nest/main.ts",
    "front": "node scripts/clinic-front.mjs"
  },
  "dependencies": {
    "@era/clinic-domain": "file:../packages/clinic-domain",
    "@era/contracts": "file:../packages/era-contracts",
    "@era/fiscal": "file:../packages/era-fiscal",
    "@era/i18n-common": "file:../packages/i18n-common",
    "@era/satellite-kit": "file:../packages/satellite-kit",
    "@nestjs/common": "^11.2.9",
    "@nestjs/core": "^11.2.9",
    "@nestjs/platform-express": "^11.2.9",
    "@prisma/client": "^6.9.0",
    "express": "^5.3.0",
    "jose": "^6.0.11",
    "lucide-react": "^0.511.0",
    "next": "^15.3.3",
    "next-intl": "^4.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "reflect-metadata": "^0.2.2",
    "xlsx": "^0.18.5",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "jest": "^29.7.0",
    "postcss": "^8.5.4",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.3"
  }
}
