# Isolated PostgreSQL for era-hotel-pms only
# Host: localhost | Docker compose: postgres service
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/era_hotel_pms?schema=public"

# Redis — retry queue for outbound events
# Host: localhost | Docker compose: redis service
REDIS_URL="redis://localhost:6379"

# Outbound integration — Nafta: 1C bridge listener; ERA: central API gateway
EXTERNAL_INTEGRATION_URL="http://localhost:3000/api/integration/mock-receiver"
EXTERNAL_NIGHT_AUDIT_URL=""
EXTERNAL_INTEGRATION_TOKEN=""

# HTTP client for event dispatcher
EXTERNAL_HTTP_TIMEOUT_MS=10000
EXTERNAL_RETRY_MAX=3

# Outbound channel toggles (env fallback until Admin → Integration UI saved)
OUTBOUND_ENABLED=true
OUTBOUND_REALTIME_CHARGES=true
OUTBOUND_REALTIME_PAYMENTS=true
OUTBOUND_REALTIME_VOIDS=true
OUTBOUND_CHECKOUT_EVENT=true
OUTBOUND_NIGHT_AUDIT_EVENT=true

# Phase 2 — ERP inbound (E6 fiscal status callback)
ERP_INBOUND_WEBHOOK_SECRET="dev-erp-webhook-secret"
OUTBOUND_INVOICE_ISSUED=true
OUTBOUND_PAYMENT_FISCALIZED=true
OUTBOUND_CITY_LEDGER_SNAPSHOT=true
OUTBOUND_MASTER_DATA_SYNC=true

# Phase 2 — POS bridge (room charge from era-fnb-pos or admin test)
POS_BRIDGE_SECRET="dev-pos-bridge-secret"
# PMS → fb-pos webhook on check-out (era-fnb-pos URL; optional until FB-1)
FNB_POS_WEBHOOK_URL="http://localhost:3202/api/webhooks/pms/reservation-lifecycle"
# UI link to era-fnb-pos (nav opens in new tab)
NEXT_PUBLIC_FNB_POS_URL="http://localhost:3202"
# Deep links to era-finance-core web (invoices, agency CL, inventory)
NEXT_PUBLIC_FINANCE_WEB_URL="http://localhost:3100"

# Phase 2 — AZ tourism registry (mock when URL empty)
TOURISM_REGISTRY_ENABLED=false
TOURISM_REGISTRY_URL=""

# Phase 2 — stock consumption on POS room-charge with productSku
STOCK_CONSUMPTION_ENABLED=false

# Property code sent in every envelope (see doc/clone-spec/18-erp-integration.md)
HOTEL_PROPERTY_CODE="NAFTA-SANATORIUM-001"

# UI locale (en | ru | az) — cookie NEXT_LOCALE overrides after user choice
DEFAULT_LOCALE=en

# OTA / Channel Manager adapters (W0 — see docs/adr/hotel-ota-adapter-strategy.md)
ERA_CHANNEL_ADAPTER=webhook
ERA_OTA_MODE=webhook
ERA_OTA_WEBHOOK_SECRET=""
# Exely hub (when Nafta audit confirms credentials)
EXELY_API_BASE_URL=""
EXELY_API_KEY=""
EXELY_PROPERTY_ID=""

# Fiscal NBC HTTP bridge (@era/fiscal — W2)
ERA_FISCAL_PROVIDER=nbc
ERA_FISCAL_NBC_URL=""
ERA_FISCAL_NBC_TOKEN=""

# Door lock vendor (W2 — mock | vendor)
ERA_DOOR_LOCK_DRIVER=mock
ERA_DOOR_LOCK_URL=""
ERA_DOOR_LOCK_TOKEN=""

# Clinic check-in: default event bus only; set true for legacy direct HTTP bridge
ERA_HOTEL_CLINIC_HTTP_BRIDGE=false

# Auth (satellite-local RBAC)
AUTH_JWT_SECRET="change-me-to-a-long-random-secret-min-32-chars"
AUTH_COOKIE_NAME="era_session"

# Elektraweb live bridge (dual-run browser extension — HOT-06)
# Process kill switch only. Per-org hotel ids / walk-in / write → Super-Admin ElektrawebBridgePolicy + Sync.
ELEKTRAWEB_BRIDGE_ENABLED=0
ERA_SATELLITE_ORGANIZATION_ID=""

# ERA Core seat licensing (mock in dev)
ERA_CORE_LICENSING_URL="http://localhost:3000/api/integration/mock-licensing"
ERA_CORE_API_KEY=""
LICENSING_SEAT_LIMIT=10

# SSO from ERA Core (Financial_Auditor)
ERA_SSO_SHARED_SECRET="dev-sso-secret-change-in-production"

# Guest CRM deep links (independent satellites — not in-hotel /medical or /finance routes)
NEXT_PUBLIC_FINANCE_WEB_URL="http://127.0.0.1:3100"
NEXT_PUBLIC_CLINIC_WEB_URL="http://127.0.0.1:3200"
NEXT_PUBLIC_SATELLITE_CLINIC_URL="http://127.0.0.1:3200"
NEXT_PUBLIC_SATELLITE_LOGISTICS_URL="http://127.0.0.1:3300"
NEXT_PUBLIC_SATELLITE_FNB_POS_URL="http://127.0.0.1:3400"

# Hotel → clinic direct HTTP bridge (default: event bus only via orchestrator fan-out)
ERA_HOTEL_CLINIC_HTTP_BRIDGE=false
CLINIC_URL="http://127.0.0.1:3200"
CLINIC_BRIDGE_SECRET="dev-clinic-bridge-secret"
# Settlement hub callbacks to department satellites
FNB_POS_URL="http://127.0.0.1:3202"

# Docker dev only — seed on container start
RUN_SEED=false
