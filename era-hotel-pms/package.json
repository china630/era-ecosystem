{
  "name": "era-hotel-pms",
  "version": "1.0.0",
  "private": true,
  "description": "Standalone hotel PMS satellite — Nafta / ERA integration",
  "scripts": {
    "dev": "next dev -p 3201",
    "build": "npm run verify:i18n && prisma generate && next build",
    "start": "next start -p 3201",
    "lint": "next lint",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "db:seed:demo": "tsx prisma/seed.ts",
    "build:docs": "node scripts/build-nafta-docs.js",
    "analyze:manifest": "node scripts/analyze-manifest.js",
    "license:excel": "node scripts/nafta-license-excel.js",
    "trace:screens": "node scripts/build-screen-traceability.js",
    "verify:i18n": "node scripts/verify-i18n-keys.mjs",
    "sync:i18n": "node scripts/restore-and-sync-i18n.mjs",
    "i18n:fill-missing": "node scripts/apply-missing-i18n.mjs",
    "test": "jest --passWithNoTests",
    "test:e2e": "playwright test"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@era/contracts": "file:../packages/era-contracts",
    "@era/i18n-common": "file:../packages/i18n-common",
    "@era/satellite-kit": "file:../packages/satellite-kit",
    "lucide-react": "^0.511.0",
    "@prisma/client": "^6.9.0",
    "axios": "^1.9.0",
    "jose": "^5.9.6",
    "next": "^15.3.3",
    "next-intl": "^4.12.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "redis": "^4.7.0",
    "zod": "^3.25.36"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.27.0",
    "eslint-config-next": "^15.3.3",
    "jest": "^29.7.0",
    "postcss": "^8.5.3",
    "prisma": "^6.9.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.3.4",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "xlsx": "^0.18.5"
  }
}
