generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEAN
  INSPECTED
  OOO
  OOS
  MAINTENANCE
}

/** HK cleanliness axis — ADR hotel-housekeeping-nafta-ops */
enum RoomHkCondition {
  DIRTY
  PICKUP
  CLEAN
  INSPECTED
}

/** Inventory axis — OOO leaves inventory; OOS stays in denominator */
enum RoomInventoryStatus {
  IN_SERVICE
  OOS
  OOO
}

enum HkJobType {
  DEPARTURE
  STAYOVER
  ARRIVAL_PREP
  NSR
  OTHER
}

enum HkVisitOutcome {
  V
  VC
  OK
  REFUSED
  DND
  SO
}

enum HkDepartment {
  ROOMS
  PUBLIC_AREA
  LAUNDRY
}

enum HkRosterCellKind {
  E
  L
  N
  OFF
  EG
  CUSTOM
}

enum ReservationStatus {
  OPTION
  CONFIRMED
  IN_HOUSE
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  COMPANY_ACCOUNT
  LOYALTY_POINTS
  /** Settle offset from FolioDeposit HELD → APPLIED */
  DEPOSIT
  BANK_TRANSFER
}

enum FolioPaymentKind {
  PAYMENT
  REFUND
}

/** Corporate negotiation / hold block (above ContractAllotment quota). See docs/adr/hotel-booking-hierarchy.md */
enum AllotmentBlockStatus {
  TENTATIVE
  DEFINITE
  CANCELLED
  RELEASED
}

/** How folios are owned across stays in a ReservationGroup (Booking). */
enum BookingFolioMode {
  INDIVIDUAL
  MASTER
  SPLIT
}

/** How party members bill within one RoomStay. */
enum PartyBillingMode {
  /** One folio owner (ReservationGuest.isPrimary / reservation.guestId). */
  PRIMARY
  /** Equal peers — each party member owns a GUEST folio. */
  EQUAL
}

enum FolioDepositStatus {
  HELD
  APPLIED
  REFUNDED
  FORFEITED
}

enum CardAuthorizationStatus {
  HELD
  CAPTURED
  RELEASED
  EXPIRED
  VOIDED
}

enum FolioSettlementStatus {
  OPEN
  COMPLETED
  VOID
}

/// Former Prisma enum — now String codes from HotelLookup kind=NOTE_TYPE (ADR A2).

enum FolioType {
  GUEST
  COMPANY
  AGENCY
}

enum FolioStatus {
  OPEN
  CLOSED
  VOID
  /** Guest checked out; company/agency balance awaiting AR handoff */
  PENDING_AR
  /** Handed off to Finance / invoice issued */
  TRANSFERRED_AR
}

enum BusinessDayStatus {
  OPEN
  CLOSED
}

enum NightAuditStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum OutboundEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum SettlementPendingStatus {
  PENDING
  PAID
  VOID
}

enum SettlementSourceSystem {
  FNB_POS
  CLINIC
  RETAIL
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum ChannelErrorStatus {
  OPEN
  RESOLVED
}

enum MedicalOrderStatus {
  PENDING
  COMPLETED
}

enum LabResultFlag {
  NORMAL
  HIGH
  LOW
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FiscalDocumentStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
}

enum TourismSubmissionStatus {
  PENDING
  SENT
  FAILED
}

enum PosResourceType {
  TABLE
  SPA_CABIN
  BANQUET_HALL
}

enum BanquetEventStatus {
  DRAFT
  CONFIRMED
  DONE
  CANCELLED
}

enum PosReservationStatus {
  BOOKED
  SEATED
  CANCELLED
  COMPLETED
}

enum ProcedureAppointmentStatus {
  BOOKED
  FINISHED
  NO_SHOW
}

enum TransferDirection {
  IN
  OUT
}

enum TransferOrderStatus {
  BOOKED
  CONFIRMED
  DONE
  CANCELLED
}

enum TourDepartureStatus {
  DRAFT
  OPEN
  CLOSED
  DEPARTED
  CANCELLED
}

enum TourBookingStatus {
  CHARGED
  PAID
  CANCELLED
  ON_CITY_LEDGER
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER
}

model HotelProfile {
  id                       String    @id @default(uuid())
  name                     String
  currency                 String    @default("AZN")
  timezone                 String    @default("Asia/Baku")
  propertyCode             String
  organizationId           String   
  roomCapacity             Int       @default(78)
  integrationSettingsJson  String?   @db.Text
  currentBusinessDate      DateTime? @db.Date
  businessDateLocked       Boolean   @default(false)
  defaultCreditLimitAzn    Decimal?  @db.Decimal(12, 2)
  /**
   * Hotel-wide feature flags / settings JSON.
   *
   * Shape stored in `HotelProfile.policyJson.nightAuditReportPack`:
   * interface ReportPackConfig {
   *   enabled: boolean;
   *   slugs: string[]; // ordered list of enabled report slugs
   * }
   *
   * Nafta default pack is 8 enabled slugs:
   * ['daily-management','trial-balance-period','cash-report','monthly-daily-analysis','in-house','annual-occupancy','folio-transactions','department-revenues']
   */
  policyJson               String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  @@unique([organizationId, propertyCode])
  @@index([organizationId])
}

model Role {
  id              String   @id @default(uuid())
  organizationId String
  code            String
  name            String
  permissionsJson String   @db.Text
  users           User[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id                String     @id @default(uuid())
  organizationId String
  login             String
  email             String?
  phone             String?    
  passwordHash      String
  fullName          String
  department        String?
  status            UserStatus @default(ACTIVE)
  roleId            String
  role              Role       @relation(fields: [roleId], references: [id])
  isCrossSystem     Boolean    @default(false)
  globalPersonId    String?    @map("global_person_id")
  financeEmployeeId String?    @unique @map("finance_employee_id")
  cpEmploymentId    String?    @unique @map("cp_employment_id")
  lastLoginAt       DateTime?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  @@index([roleId])
  @@index([status])
  @@unique([organizationId, login])
  @@unique([organizationId, phone])
  @@index([organizationId])
}

enum RatePlanType {
  BASE
  DERIVED
}

enum RateAdjustmentMode {
  PERCENT
  FIXED
}

enum AddOnPricingUnit {
  PER_STAY
  PER_NIGHT
  PER_GUEST
  PER_GUEST_NIGHT
}

enum AddOnInclusion {
  INCLUDED
  OPTIONAL
}

enum ProductType {
  SELLABLE
  STOCK
}

/// T1 SatAdmin pick-lists (market, segment, VIP, …) — ADR managed-lists-vs-enums A1
enum HotelLookupKind {
  MARKET
  SEGMENT
  VIP_TYPE
  LOYALTY_TIER
  VISA_TYPE
  TITLE
  GENDER
  MARITAL_STATUS
  TRIP_REASON
  ACCOM_TYPE
  RECORD_TYPE
  SPECIAL_STATE
  VERIFICATION_STATUS
  NOTE_TYPE
  CONCIERGE_CATEGORY
  EVENT_LINE_KIND
}

model HotelLookup {
  id        String          @id @default(uuid())
  organizationId String
  kind      HotelLookupKind
  code      String
  name      String
  active    Boolean         @default(true)
  sortOrder Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  @@unique([organizationId, kind, code])
  @@index([kind, active, sortOrder])
  @@index([organizationId])
}

model RoomView {
  id        String   @id @default(uuid())
  organizationId String
  code      String
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@unique([organizationId, code])
  @@index([organizationId])
}

model BedType {
  id         String   @id @default(uuid())
  organizationId String
  code       String
  name       String
  systemType String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  @@unique([organizationId, code])
  @@index([organizationId])
}

model RoomType {
  id            String              @id @default(uuid())
  organizationId String
  code          String
  name          String
  adultCapacity Int                 @default(2)
  childCapacity Int                 @default(0)
  baseQuota     Int
  active        Boolean             @default(true)
  rooms         Room[]
  reservations  Reservation[]
  givenRoomReservations Reservation[] @relation("GivenRoomType")
  staySlices    ReservationStaySlice[]
  ratePlans     RatePlan[]
  roomTypeRates RoomTypeRate[]
  stopSells     ChannelStopSell[]
  channelRoomMappings ChannelRoomMapping[]
  contractAllotments ContractAllotment[]
  allotmentBlockLines AllotmentBlockLine[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  @@unique([organizationId, code])
  @@index([organizationId])
}

model ChannelStopSell {
  id             String    @id @default(uuid())
  organizationId String   
  date           DateTime  @db.Date
  roomTypeId     String?
  roomType       RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  note           String?
  createdAt      DateTime  @default(now())

  @@unique([organizationId, date, roomTypeId])
  @@index([organizationId])
}

model Room {
  id           String             @id @default(uuid())
  organizationId String
  roomNumber   String
  roomTypeId   String
  roomType     RoomType           @relation(fields: [roomTypeId], references: [id])
  floor        Int                @default(1)
  status       RoomStatus         @default(AVAILABLE)
  hkCondition  RoomHkCondition    @default(CLEAN)
  inventoryStatus RoomInventoryStatus @default(IN_SERVICE)
  inventoryReason String?
  description  String?
  viewCode     String?
  bedTypeCode  String?
  location     String?
  maxBed       Int?
  disabled     Boolean            @default(false)
  deleted      Boolean            @default(false)
  reservations Reservation[]
  hkTasks      HousekeepingTask[]
  serviceOrders MaintenanceWorkOrder[]
  closures     RoomClosure[]
  minibarPosts MinibarPosting[]
  roomChangesFrom RoomChangePlan[] @relation("RoomChangeFrom")
  roomChangesTo   RoomChangePlan[] @relation("RoomChangeTo")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
  @@unique([organizationId, roomNumber])
  @@index([organizationId])
}

model MealPlan {
  id           String        @id @default(uuid())
  organizationId String
  code         String
  name         String
  ratePlans    RatePlan[]
  reservations Reservation[]
  @@unique([organizationId, code])
  @@index([organizationId])
}

model RatePlan {
  id            String        @id @default(uuid())
  organizationId String
  code          String
  name          String
  type          RatePlanType  @default(DERIVED)

  // Derivation config (NULL for BASE / BAR)
  derivedFromId   String?
  derivedFrom     RatePlan?           @relation("RateDerivation", fields: [derivedFromId], references: [id])
  derivedPlans    RatePlan[]          @relation("RateDerivation")
  adjustmentMode  RateAdjustmentMode?
  adjustmentValue Decimal?            @db.Decimal(12, 4)

  // Room revenue classification (defaults to ROOM revenue code at runtime)
  roomRevenueCodeId String?
  roomRevenueCode   RevenueCode?      @relation("RatePlanRoomRevenue", fields: [roomRevenueCodeId], references: [id])

  isRefundable  Boolean       @default(true)
  active        Boolean       @default(true)

  // Legacy fields (kept for backward compatibility during migration)
  medicalFlag   Boolean       @default(false)
  pricePerNight Decimal       @db.Decimal(12, 2)
  roomTypeId    String?
  roomType      RoomType?     @relation(fields: [roomTypeId], references: [id])
  mealPlanId    String?
  mealPlan      MealPlan?     @relation(fields: [mealPlanId], references: [id])

  // Occupancy supplements (used when policy.occupancyPricingEnabled)
  baseOccupancy     Int       @default(1)
  extraAdultAmount  Decimal?  @db.Decimal(12, 2)
  thirdAdultAmount  Decimal?  @db.Decimal(12, 2)
  extraBedAmount    Decimal?  @db.Decimal(12, 2)

  sellVersions  RatePlanSellVersion[]
  reservations  Reservation[]
  staySlices    ReservationStaySlice[]
  packageLines  RatePlanPackageLine[]
  procedureInclusions RatePlanProcedureInclusion[]
  contractPricingRules ContractPricingRule[]
  channelRateMappings  ChannelRateMapping[]
  roomTypeRates RoomTypeRate[]
  addOns        RatePlanAddOn[]
  salesContracts SalesContract[]
  allotmentBlockLines AllotmentBlockLine[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  @@unique([organizationId, code])
  @@index([organizationId])
}

// Absolute price calendar — only for BASE (BAR) rate plans, per room type and date
enum RoomTypeRateSource {
  AUTO
  MANUAL
}

model RoomTypeRate {
  id           String              @id @default(uuid())
  /// Tenant isolation via RatePlan / RoomType parents — not a query root. Cross-org FK is a service invariant.
  ratePlanId   String
  ratePlan     RatePlan            @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomTypeId   String
  roomType     RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date         DateTime            @db.Date
  amount       Decimal             @db.Decimal(12, 2)
  currencyCode String              @default("AZN")
  source       RoomTypeRateSource  @default(MANUAL)
  lockedAt     DateTime?           @map("locked_at")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([ratePlanId, roomTypeId, date])
  @@index([roomTypeId, date])
}

model AddOn {
  id            String           @id @default(uuid())
  organizationId String
  code          String
  name          String
  price         Decimal          @db.Decimal(12, 2)
  pricingUnit   AddOnPricingUnit @default(PER_GUEST_NIGHT)
  revenueCodeId String
  revenueCode   RevenueCode      @relation("AddOnRevenue", fields: [revenueCodeId], references: [id])
  taxTag        String?
  active        Boolean          @default(true)
  ratePlanLinks RatePlanAddOn[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  @@unique([organizationId, code])
  @@index([organizationId])
}

model RatePlanAddOn {
  id            String         @id @default(uuid())
  ratePlanId    String
  ratePlan      RatePlan       @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  addOnId       String
  addOn         AddOn          @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  inclusion     AddOnInclusion @default(OPTIONAL)
  overridePrice Decimal?       @db.Decimal(12, 2)
  sortOrder     Int            @default(0)

  @@unique([ratePlanId, addOnId])
  @@index([ratePlanId])
}

model RatePlanPackageLine {
  id            String      @id @default(uuid())
  ratePlanId    String
  ratePlan      RatePlan    @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  revenueCodeId String
  revenueCode   RevenueCode @relation(fields: [revenueCodeId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  sortOrder     Int         @default(0)

  @@unique([ratePlanId, revenueCodeId])
  @@index([ratePlanId])
}

model ProcedureService {
  id            String               @id @default(uuid())
  organizationId String
  code          String
  name          String
  durationMin   Int                  @default(30)
  defaultAmount Decimal              @db.Decimal(12, 2)
  appointments  ProcedureAppointment[]
  inclusions    RatePlanProcedureInclusion[]
  createdAt     DateTime             @default(now())
  @@unique([organizationId, code])
  @@index([organizationId])
}

model RatePlanProcedureInclusion {
  ratePlanId String
  serviceId  String
  ratePlan   RatePlan         @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  service    ProcedureService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([ratePlanId, serviceId])
}

model ProcedureAppointment {
  id            String                     @id @default(uuid())
  reservationId String
  reservation   Reservation                @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  serviceId     String
  service       ProcedureService           @relation(fields: [serviceId], references: [id])
  staffName     String?
  placeCode     String?
  startAt       DateTime
  endAt         DateTime
  status        ProcedureAppointmentStatus @default(BOOKED)
  auditNote     String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([reservationId])
  @@index([startAt, endAt])
  @@index([staffName, startAt])
  @@index([placeCode, startAt])
}

model Department {
  id           String        @id @default(uuid())
  organizationId String
  code         String
  name         String
  revenueCodes RevenueCode[]
  charges      FolioCharge[]
  @@unique([organizationId, code])
  @@index([organizationId])
}

model RevenueCode {
  id           String             @id @default(uuid())
  organizationId String
  code         String
  name         String
  taxTag       String?
  active       Boolean            @default(true)
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  charges      FolioCharge[]
  routingRule  FolioRoutingRule?
  routingOverrides ReservationFolioRoutingOverride[]
  packageLines RatePlanPackageLine[]
  glMapping    HotelRevenueGlMapping?
  ratePlansRoom RatePlan[]        @relation("RatePlanRoomRevenue")
  addOns        AddOn[]           @relation("AddOnRevenue")
  eventOrderLines EventOrderLine[]
  @@unique([organizationId, code])
  @@index([organizationId])
}

model HotelRevenueGlMapping {
  id            String      @id @default(uuid())
  revenueCodeId String      @unique
  revenueCode   RevenueCode @relation(fields: [revenueCodeId], references: [id], onDelete: Cascade)
  glAccountCode String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BookingSource {
  id           String        @id @default(uuid())
  organizationId String
  code         String
  name         String
  reservations Reservation[]
  @@unique([organizationId, code])
  @@index([organizationId])
}

model Agency {
  id                   String              @id @default(uuid())
  organizationId String
  code                 String
  name                 String
  voen                 String?
  /** Local cache for Finance counterparty (resolved by agency VÖEN). */
  financeCounterpartyId String?
  commissionPercent    Decimal?            @db.Decimal(5, 2)
  /** Max open AR (PENDING_AR + TRANSFERRED_AR) for this agency; null = use stay/hotel default */
  creditLimitAzn       Decimal?            @db.Decimal(12, 2)
  /** Net days after checkout for Finance aging (display + H-BL-48) */
  paymentTermsDays     Int?
  active               Boolean             @default(true)
  reservations         Reservation[]
  reservationGroups    ReservationGroup[]
  allotmentBlocks      AllotmentBlock[]
  contractPricingRules ContractPricingRule[]
  salesContracts       SalesContract[]
  banquetEvents        BanquetEvent[]       @relation("BanquetAgency")
  @@unique([organizationId, code])
  @@index([organizationId])
}

/** Editable agency-name prefix → medical SKU (pilot polish #20). */
model AgencyMedicalSkuRule {
  id               String   @id @default(uuid())
  organizationId   String
  agencyNamePrefix String
  packageCode      String
  sortOrder        Int      @default(0)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([organizationId, active])
  @@index([agencyNamePrefix])
}

enum ContractPricingRuleType {
  DISCOUNT
  SUPPLEMENT
}

enum SalesContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SalesContractCounterpartyType {
  AGENCY
  CORPORATE
}

/// Former EventOrderLineKind enum — String codes from HotelLookup kind=EVENT_LINE_KIND (ADR A2).

enum EventStaffAssignmentStatus {
  PLANNED
  DONE
  CANCELLED
}

model ContractPricingRule {
  id           String                  @id @default(uuid())
  name         String
  agencyId     String?
  agency       Agency?                 @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  ratePlanId   String
  ratePlan     RatePlan                @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  ruleType     ContractPricingRuleType
  valuePercent Decimal                 @db.Decimal(5, 2)
  validFrom    DateTime                @db.Date
  validTo      DateTime?               @db.Date
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([agencyId, ratePlanId])
  @@index([validFrom, validTo])
}

model SalesContract {
  id                String                        @id @default(uuid())
  organizationId String
  code              String
  name              String
  counterpartyType  SalesContractCounterpartyType @default(AGENCY)
  agencyId          String?
  agency            Agency?                       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  companyGuestId    String?
  companyGuest      Guest?                        @relation("SalesContractCompany", fields: [companyGuestId], references: [id], onDelete: SetNull)
  validFrom         DateTime                      @db.Date
  validTo           DateTime?                     @db.Date
  status            SalesContractStatus           @default(DRAFT)
  ratePlanId        String
  ratePlan          RatePlan                      @relation(fields: [ratePlanId], references: [id])
  minStay           Int?
  cta               Boolean                       @default(false)
  ctd               Boolean                       @default(false)
  commissionPercent Decimal?                      @db.Decimal(5, 2)
  depositRequired   Boolean                       @default(false)
  depositAmount     Decimal?                      @db.Decimal(12, 2)
  notes             String?
  externalRef       String?
  legacyRuleId      String?                       @unique
  allotments        ContractAllotment[]
  allotmentBlocks   AllotmentBlock[]
  reservations      Reservation[]
  banquetEvents     BanquetEvent[]
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([agencyId, status])
  @@index([validFrom, validTo])
  @@unique([organizationId, code])
  @@index([organizationId])
}

model ContractAllotment {
  id              String        @id @default(uuid())
  salesContractId String
  salesContract   SalesContract @relation(fields: [salesContractId], references: [id], onDelete: Cascade)
  roomTypeId      String
  roomType        RoomType      @relation(fields: [roomTypeId], references: [id])
  validFrom       DateTime      @db.Date
  validTo         DateTime      @db.Date
  nightlyQuota    Int
  releaseDays     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([salesContractId, roomTypeId])
  @@index([validFrom, validTo])
}

model Guest {
  id                 String         @id @default(uuid())
  organizationId String
  externalRef        String?
  globalPersonId     String?
  fullName           String
  firstName          String?
  lastName           String?
  middleName         String?
  title              String?
  /** M/F ops cache — physical column `gender`. */
  sex                String?        @map("gender")
  nationality        String         @default("AZ")
  voen               String?
  phone              String?
  email              String?
  loyaltyTier        String?
  vipType            String?
  birthDate          DateTime?
  birthPlace         String?
  occupation         String?
  registrationNumber String?
  vehiclePlate       String?
  greyList           Boolean        @default(false)
  problematic        Boolean        @default(false)
  hotelName          String?
  visitCount         Int            @default(0)
  gdprConfirmed      Boolean        @default(false)
  smsConsent         Boolean        @default(false)
  whatsappConsent    Boolean        @default(false)
  phoneConsent       Boolean        @default(false)
  emailConsent       Boolean        @default(false)
  callBack           Boolean        @default(false)
  visaType           String?
  visaNumber         String?
  visaExpiry         DateTime?
  maritalStatus      String?
  /** Parent CRM fields — not patronymic (see middleName). */
  parentFatherName   String?        @map("fatherName")
  parentMotherName   String?        @map("motherName")
  verificationStatus String?
  marriageDate       DateTime?      @db.Date
  bonusPercent       Decimal?       @db.Decimal(5, 2)
  phoneVerified      Boolean        @default(false)
  emailVerified      Boolean        @default(false)
  isLocked           Boolean        @default(false)
  reservations       Reservation[]
  loyaltyPointEntries GuestLoyaltyPointEntry[]
  medicalAlerts      MedicalAlert[]
  documents          GuestDocument[]
  contacts           GuestContact[]
  addresses          GuestAddress[]
  loyaltyCards       GuestLoyaltyCard[]
  timeShareAgreements GuestTimeShareAgreement[]
  crmExtension        GuestCrmExtension?
  conciergeOrders     ConciergeOrder[]
  dispatchRequests    DispatchRequest[]
  notes              GuestNote[]
  tasks              GuestTask[]
  lostFoundItems     LostFoundItem[]
  tags               GuestTag[]
  archiveFiles       GuestArchiveFile[]
  preferences        GuestPreference[]
