generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoomStatus {
  AVAILABLE
  OCCUPIED
  DIRTY
  CLEAN
  INSPECTED
  OOO
  OOS
  MAINTENANCE
}

enum ReservationStatus {
  OPTION
  CONFIRMED
  IN_HOUSE
  CHECKED_OUT
  CANCELLED
  NO_SHOW
}

enum PaymentMethod {
  CASH
  CARD
  COMPANY_ACCOUNT
  LOYALTY_POINTS
}

enum FolioDepositStatus {
  HELD
  APPLIED
  REFUNDED
  FORFEITED
}

enum CardAuthorizationStatus {
  HELD
  CAPTURED
  RELEASED
  EXPIRED
  VOIDED
}

enum FolioSettlementStatus {
  OPEN
  COMPLETED
  VOID
}

enum ReservationNoteType {
  EXTRA_REQ
  RES_NOTE
  CIN_NOTE
  COUT_NOTE
  ROOM_NOTE
  CANCEL_NOTE
  PAYMENT_NOTE
  PRICE_NOTE
  INVOICE_NOTE
  CONFIRMATION
  GENERAL_NOTE
  ARRIVAL_POSTPONED
  DEPARTURE_EXTENDED
  SET_ARRIVAL_EARLY
  SET_DEPARTURE_EARLY
}

enum FolioType {
  GUEST
  COMPANY
  AGENCY
}

enum FolioStatus {
  OPEN
  CLOSED
  VOID
}

enum BusinessDayStatus {
  OPEN
  CLOSED
}

enum NightAuditStatus {
  RUNNING
  COMPLETED
  FAILED
}

enum OutboundEventStatus {
  PENDING
  SENT
  FAILED
  SKIPPED
}

enum CashShiftStatus {
  OPEN
  CLOSED
}

enum HousekeepingTaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

enum ChannelErrorStatus {
  OPEN
  RESOLVED
}

enum MedicalOrderStatus {
  PENDING
  COMPLETED
}

enum LabResultFlag {
  NORMAL
  HIGH
  LOW
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum FiscalDocumentStatus {
  PENDING
  SENT
  ACCEPTED
  REJECTED
}

enum TourismSubmissionStatus {
  PENDING
  SENT
  FAILED
}

enum PosResourceType {
  TABLE
  SPA_CABIN
  BANQUET_HALL
}

enum BanquetEventStatus {
  DRAFT
  CONFIRMED
  DONE
  CANCELLED
}

enum PosReservationStatus {
  BOOKED
  SEATED
  CANCELLED
  COMPLETED
}

enum ProcedureAppointmentStatus {
  BOOKED
  FINISHED
  NO_SHOW
}

enum TransferDirection {
  IN
  OUT
}

enum TransferOrderStatus {
  BOOKED
  CONFIRMED
  DONE
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  ISSUE
  TRANSFER
}

model HotelProfile {
  id                       String    @id @default(uuid())
  name                     String
  currency                 String    @default("AZN")
  timezone                 String    @default("Asia/Baku")
  propertyCode             String    @unique
  organizationId           String    @default("nafta-sanatorium-org")
  roomCapacity             Int       @default(78)
  integrationSettingsJson  String?   @db.Text
  currentBusinessDate      DateTime? @db.Date
  businessDateLocked       Boolean   @default(false)
  defaultCreditLimitAzn    Decimal?  @db.Decimal(12, 2)
  policyJson               String?   @db.Text
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
}

model Role {
  id              String   @id @default(uuid())
  code            String   @unique
  name            String
  permissionsJson String   @db.Text
  users           User[]
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model User {
  id           String     @id @default(uuid())
  login        String     @unique
  email        String?
  phone        String?    @unique
  passwordHash String
  fullName     String
  department   String?
  status       UserStatus @default(ACTIVE)
  roleId       String
  role         Role       @relation(fields: [roleId], references: [id])
  isCrossSystem Boolean   @default(false)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  @@index([roleId])
  @@index([status])
}

enum RatePlanType {
  BASE
  DERIVED
}

enum RateAdjustmentMode {
  PERCENT
  FIXED
}

enum AddOnPricingUnit {
  PER_STAY
  PER_NIGHT
  PER_GUEST
  PER_GUEST_NIGHT
}

enum AddOnInclusion {
  INCLUDED
  OPTIONAL
}

enum ProductType {
  SELLABLE
  STOCK
}

model RoomView {
  id        String   @id @default(uuid())
  code      String   @unique
  name      String
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model BedType {
  id         String   @id @default(uuid())
  code       String   @unique
  name       String
  systemType String?
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model RoomType {
  id            String              @id @default(uuid())
  code          String              @unique
  name          String
  adultCapacity Int                 @default(2)
  childCapacity Int                 @default(0)
  baseQuota     Int
  active        Boolean             @default(true)
  rooms         Room[]
  reservations  Reservation[]
  givenRoomReservations Reservation[] @relation("GivenRoomType")
  ratePlans     RatePlan[]
  roomTypeRates RoomTypeRate[]
  stopSells     ChannelStopSell[]
  channelRoomMappings ChannelRoomMapping[]
  contractAllotments ContractAllotment[]
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
}

model ChannelStopSell {
  id         String    @id @default(uuid())
  date       DateTime  @db.Date
  roomTypeId String?
  roomType   RoomType? @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  note       String?
  createdAt  DateTime  @default(now())

  @@unique([date, roomTypeId])
}

model Room {
  id           String             @id @default(uuid())
  roomNumber   String             @unique
  roomTypeId   String
  roomType     RoomType           @relation(fields: [roomTypeId], references: [id])
  floor        Int                @default(1)
  status       RoomStatus         @default(AVAILABLE)
  description  String?
  viewCode     String?
  bedTypeCode  String?
  location     String?
  maxBed       Int?
  disabled     Boolean            @default(false)
  deleted      Boolean            @default(false)
  reservations Reservation[]
  hkTasks      HousekeepingTask[]
  serviceOrders MaintenanceWorkOrder[]
  closures     RoomClosure[]
  minibarPosts MinibarPosting[]
  roomChangesFrom RoomChangePlan[] @relation("RoomChangeFrom")
  roomChangesTo   RoomChangePlan[] @relation("RoomChangeTo")
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt
}

model MealPlan {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  ratePlans    RatePlan[]
  reservations Reservation[]
}

model RatePlan {
  id            String        @id @default(uuid())
  code          String        @unique
  name          String
  type          RatePlanType  @default(DERIVED)

  // Derivation config (NULL for BASE / BAR)
  derivedFromId   String?
  derivedFrom     RatePlan?           @relation("RateDerivation", fields: [derivedFromId], references: [id])
  derivedPlans    RatePlan[]          @relation("RateDerivation")
  adjustmentMode  RateAdjustmentMode?
  adjustmentValue Decimal?            @db.Decimal(12, 4)

  // Room revenue classification (defaults to ROOM revenue code at runtime)
  roomRevenueCodeId String?
  roomRevenueCode   RevenueCode?      @relation("RatePlanRoomRevenue", fields: [roomRevenueCodeId], references: [id])

  isRefundable  Boolean       @default(true)
  active        Boolean       @default(true)

  // Legacy fields (kept for backward compatibility during migration)
  medicalFlag   Boolean       @default(false)
  pricePerNight Decimal       @db.Decimal(12, 2)
  roomTypeId    String?
  roomType      RoomType?     @relation(fields: [roomTypeId], references: [id])
  mealPlanId    String?
  mealPlan      MealPlan?     @relation(fields: [mealPlanId], references: [id])

  reservations  Reservation[]
  packageLines  RatePlanPackageLine[]
  procedureInclusions RatePlanProcedureInclusion[]
  contractPricingRules ContractPricingRule[]
  channelRateMappings  ChannelRateMapping[]
  roomTypeRates RoomTypeRate[]
  addOns        RatePlanAddOn[]
  salesContracts SalesContract[]
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
}

// Absolute price calendar — only for BASE (BAR) rate plans, per room type and date
enum RoomTypeRateSource {
  AUTO
  MANUAL
}

model RoomTypeRate {
  id           String              @id @default(uuid())
  ratePlanId   String
  ratePlan     RatePlan            @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  roomTypeId   String
  roomType     RoomType            @relation(fields: [roomTypeId], references: [id], onDelete: Cascade)
  date         DateTime            @db.Date
  amount       Decimal             @db.Decimal(12, 2)
  currencyCode String              @default("AZN")
  source       RoomTypeRateSource  @default(MANUAL)
  lockedAt     DateTime?           @map("locked_at")
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt

  @@unique([ratePlanId, roomTypeId, date])
  @@index([roomTypeId, date])
}

model AddOn {
  id            String           @id @default(uuid())
  code          String           @unique
  name          String
  price         Decimal          @db.Decimal(12, 2)
  pricingUnit   AddOnPricingUnit @default(PER_GUEST_NIGHT)
  revenueCodeId String
  revenueCode   RevenueCode      @relation("AddOnRevenue", fields: [revenueCodeId], references: [id])
  taxTag        String?
  active        Boolean          @default(true)
  ratePlanLinks RatePlanAddOn[]
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
}

model RatePlanAddOn {
  id            String         @id @default(uuid())
  ratePlanId    String
  ratePlan      RatePlan       @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  addOnId       String
  addOn         AddOn          @relation(fields: [addOnId], references: [id], onDelete: Cascade)
  inclusion     AddOnInclusion @default(OPTIONAL)
  overridePrice Decimal?       @db.Decimal(12, 2)
  sortOrder     Int            @default(0)

  @@unique([ratePlanId, addOnId])
  @@index([ratePlanId])
}

model RatePlanPackageLine {
  id            String      @id @default(uuid())
  ratePlanId    String
  ratePlan      RatePlan    @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  revenueCodeId String
  revenueCode   RevenueCode @relation(fields: [revenueCodeId], references: [id])
  amount        Decimal     @db.Decimal(12, 2)
  sortOrder     Int         @default(0)

  @@unique([ratePlanId, revenueCodeId])
  @@index([ratePlanId])
}

model ProcedureService {
  id            String               @id @default(uuid())
  code          String               @unique
  name          String
  durationMin   Int                  @default(30)
  defaultAmount Decimal              @db.Decimal(12, 2)
  appointments  ProcedureAppointment[]
  inclusions    RatePlanProcedureInclusion[]
  createdAt     DateTime             @default(now())
}

model RatePlanProcedureInclusion {
  ratePlanId String
  serviceId  String
  ratePlan   RatePlan         @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  service    ProcedureService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([ratePlanId, serviceId])
}

model ProcedureAppointment {
  id            String                     @id @default(uuid())
  reservationId String
  reservation   Reservation                @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  serviceId     String
  service       ProcedureService           @relation(fields: [serviceId], references: [id])
  staffName     String?
  placeCode     String?
  startAt       DateTime
  endAt         DateTime
  status        ProcedureAppointmentStatus @default(BOOKED)
  auditNote     String?
  createdAt     DateTime                   @default(now())
  updatedAt     DateTime                   @updatedAt

  @@index([reservationId])
  @@index([startAt, endAt])
  @@index([staffName, startAt])
  @@index([placeCode, startAt])
}

model Department {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  revenueCodes RevenueCode[]
  charges      FolioCharge[]
}

model RevenueCode {
  id           String             @id @default(uuid())
  code         String             @unique
  name         String
  taxTag       String?
  active       Boolean            @default(true)
  departmentId String?
  department   Department?        @relation(fields: [departmentId], references: [id])
  charges      FolioCharge[]
  routingRule  FolioRoutingRule?
  packageLines RatePlanPackageLine[]
  glMapping    HotelRevenueGlMapping?
  ratePlansRoom RatePlan[]        @relation("RatePlanRoomRevenue")
  addOns        AddOn[]           @relation("AddOnRevenue")
  eventOrderLines EventOrderLine[]
}

model HotelRevenueGlMapping {
  id            String      @id @default(uuid())
  revenueCodeId String      @unique
  revenueCode   RevenueCode @relation(fields: [revenueCodeId], references: [id], onDelete: Cascade)
  glAccountCode String
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model BookingSource {
  id           String        @id @default(uuid())
  code         String        @unique
  name         String
  reservations Reservation[]
}

model Agency {
  id                   String              @id @default(uuid())
  code                 String              @unique
  name                 String
  voen                 String?
  commissionPercent    Decimal?            @db.Decimal(5, 2)
  active               Boolean             @default(true)
  reservations         Reservation[]
  reservationGroups    ReservationGroup[]
  contractPricingRules ContractPricingRule[]
  salesContracts       SalesContract[]
  banquetEvents        BanquetEvent[]       @relation("BanquetAgency")
}

enum ContractPricingRuleType {
  DISCOUNT
  SUPPLEMENT
}

enum SalesContractStatus {
  DRAFT
  ACTIVE
  EXPIRED
  CANCELLED
}

enum SalesContractCounterpartyType {
  AGENCY
  CORPORATE
}

enum EventOrderLineKind {
  MENU
  EQUIPMENT
  STAFF
  ROOM_RENTAL
  OTHER
}

enum EventStaffAssignmentStatus {
  PLANNED
  DONE
  CANCELLED
}

model ContractPricingRule {
  id           String                  @id @default(uuid())
  name         String
  agencyId     String?
  agency       Agency?                 @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  ratePlanId   String
  ratePlan     RatePlan                @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  ruleType     ContractPricingRuleType
  valuePercent Decimal                 @db.Decimal(5, 2)
  validFrom    DateTime                @db.Date
  validTo      DateTime?               @db.Date
  active       Boolean                 @default(true)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt

  @@index([agencyId, ratePlanId])
  @@index([validFrom, validTo])
}

model SalesContract {
  id                String                        @id @default(uuid())
  code              String                        @unique
  name              String
  counterpartyType  SalesContractCounterpartyType @default(AGENCY)
  agencyId          String?
  agency            Agency?                       @relation(fields: [agencyId], references: [id], onDelete: SetNull)
  companyGuestId    String?
  companyGuest      Guest?                        @relation("SalesContractCompany", fields: [companyGuestId], references: [id], onDelete: SetNull)
  validFrom         DateTime                      @db.Date
  validTo           DateTime?                     @db.Date
  status            SalesContractStatus           @default(DRAFT)
  ratePlanId        String
  ratePlan          RatePlan                      @relation(fields: [ratePlanId], references: [id])
  minStay           Int?
  cta               Boolean                       @default(false)
  ctd               Boolean                       @default(false)
  commissionPercent Decimal?                      @db.Decimal(5, 2)
  depositRequired   Boolean                       @default(false)
  depositAmount     Decimal?                      @db.Decimal(12, 2)
  notes             String?
  externalRef       String?
  legacyRuleId      String?                       @unique
  allotments        ContractAllotment[]
  reservations      Reservation[]
  banquetEvents     BanquetEvent[]
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt

  @@index([agencyId, status])
  @@index([validFrom, validTo])
}

model ContractAllotment {
  id              String        @id @default(uuid())
  salesContractId String
  salesContract   SalesContract @relation(fields: [salesContractId], references: [id], onDelete: Cascade)
  roomTypeId      String
  roomType        RoomType      @relation(fields: [roomTypeId], references: [id])
  validFrom       DateTime      @db.Date
  validTo         DateTime      @db.Date
  nightlyQuota    Int
  releaseDays     Int           @default(0)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([salesContractId, roomTypeId])
  @@index([validFrom, validTo])
}

model Guest {
  id                 String         @id @default(uuid())
  externalRef        String?        @unique
  globalPersonId     String?
  fullName           String
  firstName          String?
  lastName           String?
  middleName         String?
  title              String?
  gender             String?
  nationality        String         @default("AZ")
  nationalIdFin      String?
  voen               String?
  passportNumber     String?
  phone              String?
  email              String?
  loyaltyTier        String?
  vipType            String?
  birthDate          DateTime?
  birthPlace         String?
  occupation         String?
  registrationNumber String?
  vehiclePlate       String?
  greyList           Boolean        @default(false)
  problematic        Boolean        @default(false)
  hotelName          String?
  visitCount         Int            @default(0)
  gdprConfirmed      Boolean        @default(false)
  smsConsent         Boolean        @default(false)
  whatsappConsent    Boolean        @default(false)
  phoneConsent       Boolean        @default(false)
  emailConsent       Boolean        @default(false)
  callBack           Boolean        @default(false)
  visaType           String?
  visaNumber         String?
  visaExpiry         DateTime?
  maritalStatus      String?
  fatherName         String?
  motherName         String?
  verificationStatus String?
  marriageDate       DateTime?      @db.Date
  bonusPercent       Decimal?       @db.Decimal(5, 2)
  phoneVerified      Boolean        @default(false)
  emailVerified      Boolean        @default(false)
  isLocked           Boolean        @default(false)
  reservations       Reservation[]
  loyaltyPointEntries GuestLoyaltyPointEntry[]
  medicalAlerts      MedicalAlert[]
  documents          GuestDocument[]
  contacts           GuestContact[]
  addresses          GuestAddress[]
  loyaltyCards       GuestLoyaltyCard[]
  timeShareAgreements GuestTimeShareAgreement[]
  crmExtension        GuestCrmExtension?
  conciergeOrders     ConciergeOrder[]
  dispatchRequests    DispatchRequest[]
  notes              GuestNote[]
  tasks              GuestTask[]
  lostFoundItems     LostFoundItem[]
  tags               GuestTag[]
  archiveFiles       GuestArchiveFile[]
  preferences        GuestPreference[]
  allergens          GuestAllergen[]
  specialDates       GuestSpecialDate[]
  favoriteRooms      GuestFavoriteRoom[]
  comments           GuestComment[]
  surveys            GuestSurvey[]
  incidents          GuestIncident[]
  communications     GuestCommunication[]
  contactLogs        GuestContactLog[]
  familyMembers      GuestFamily[]       @relation("GuestFamilyOwner")
  familyOf           GuestFamily[]       @relation("GuestFamilyRelated")
  bookerReservations Reservation[]       @relation("ReservationBooker")
  migrationRegistrations MigrationRegistration[]
  salesContracts       SalesContract[]     @relation("SalesContractCompany")
  banquetEventsAsCompany BanquetEvent[]    @relation("BanquetCompanyGuest")
}

enum MigrationRegistrationStatus {
  PENDING
  SUBMITTED
  ACCEPTED
  REJECTED
}

model MigrationRegistration {
  id            String                      @id @default(uuid())
  guestId       String
  guest         Guest                       @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId String?
  status        MigrationRegistrationStatus @default(PENDING)
  payloadJson   String?
  externalRef   String?
  registryResponseJson String? @db.Text
  submittedAt   DateTime?
  responseNote  String?
  createdAt     DateTime                    @default(now())
  updatedAt     DateTime                    @updatedAt

  @@index([guestId])
  @@index([status])
}

model GuestTag {
  id        String   @id @default(uuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  name      String
  createdAt DateTime @default(now())

  @@unique([guestId, name])
  @@index([guestId])
}

model GuestArchiveFile {
  id         String   @id @default(uuid())
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  title      String
  docType    String
  mimeType   String?
  sizeBytes  Int?
  storageKey String
  createdAt  DateTime @default(now())

  @@index([guestId])
}

model GuestPreference {
  id         String   @id @default(uuid())
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  preference String
  note       String?
  importance String?
  department String?
  createdAt  DateTime @default(now())

  @@index([guestId])
}

model GuestAllergen {
  id        String   @id @default(uuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  allergen  String
  note      String?
  createdAt DateTime @default(now())

  @@index([guestId])
}

model GuestSpecialDate {
  id        String   @id @default(uuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  dateType  String
  eventDate DateTime @db.Date
  note      String?
  createdAt DateTime @default(now())

  @@index([guestId])
}

model GuestFavoriteRoom {
  id         String   @id @default(uuid())
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  roomNumber String
  roomType   String?
  note       String?
  createdAt  DateTime @default(now())

  @@index([guestId])
}

model GuestComment {
  id          String   @id @default(uuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  commentDate DateTime @default(now())
  state       String   @default("NEW")
  comment     String
  answer      String?
  source      String?
  actionType  String?
  createdAt   DateTime @default(now())

  @@index([guestId])
}

model GuestSurvey {
  id         String   @id @default(uuid())
  guestId    String
  guest      Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  surveyName String
  filledAt   DateTime @db.Date
  note       String?
  createdAt  DateTime @default(now())

  @@index([guestId])
}

model GuestIncident {
  id            String   @id @default(uuid())
  guestId       String
  guest         Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  incidentDate  DateTime @default(now())
  location      String
  description   String
  action        String?
  createdAt     DateTime @default(now())

  @@index([guestId])
}

model GuestCommunication {
  id        String   @id @default(uuid())
  guestId   String
  guest     Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  channel   String
  subject   String?
  body      String
  recipient String?
  status    String   @default("STUB")
  sentAt    DateTime?
  createdAt DateTime @default(now())

  @@index([guestId])
}

model GuestContactLog {
  id          String   @id @default(uuid())
  guestId     String
  guest       Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  contactDate DateTime @default(now())
  channel     String
  operator    String?
  result      String?
  createdAt   DateTime @default(now())

  @@index([guestId])
}

model GuestFamily {
  id              String   @id @default(uuid())
  guestId         String
  guest           Guest    @relation("GuestFamilyOwner", fields: [guestId], references: [id], onDelete: Cascade)
  relatedGuestId  String
  relatedGuest    Guest    @relation("GuestFamilyRelated", fields: [relatedGuestId], references: [id], onDelete: Cascade)
  relationship    String
  createdAt       DateTime @default(now())

  @@unique([guestId, relatedGuestId])
  @@index([guestId])
}

model GuestLoyaltyCard {
  id         String    @id @default(uuid())
  guestId    String
  guest      Guest     @relation(fields: [guestId], references: [id], onDelete: Cascade)
  cardNumber String
  tier       String?
  points     Decimal?  @db.Decimal(12, 2)
  active     Boolean   @default(true)
  issuedAt   DateTime?
  expiresAt  DateTime?
  createdAt  DateTime  @default(now())

  @@index([guestId])
}

model GuestLoyaltyPointEntry {
  id           String   @id @default(uuid())
  guestId      String
  guest        Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  entryDate    DateTime @db.Date
  points       Decimal  @db.Decimal(12, 2)
  description  String?
