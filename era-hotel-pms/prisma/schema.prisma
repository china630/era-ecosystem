  unitPrice      Decimal            @db.Decimal(12, 2)
  revenueCodeId  String?
  revenueCode    RevenueCode?       @relation(fields: [revenueCodeId], references: [id], onDelete: SetNull)
  notes          String?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@index([banquetEventId])
}

model EventResourceBooking {
  id             String        @id @default(uuid())
  banquetEventId String
  banquetEvent   BanquetEvent  @relation(fields: [banquetEventId], references: [id], onDelete: Cascade)
  saloonId       String?
  saloon         BanquetSaloon? @relation(fields: [saloonId], references: [id], onDelete: SetNull)
  posResourceId  String?
  posResource    PosResource?  @relation(fields: [posResourceId], references: [id], onDelete: SetNull)
  label          String?
  startAt        DateTime
  endAt          DateTime
  notes          String?
  createdAt      DateTime      @default(now())

  @@index([banquetEventId])
  @@index([saloonId, startAt])
  @@index([posResourceId, startAt])
}

model EventStaffAssignment {
  id             String                     @id @default(uuid())
  banquetEventId String
  banquetEvent   BanquetEvent               @relation(fields: [banquetEventId], references: [id], onDelete: Cascade)
  role           String
  staffName      String
  shiftStart     DateTime?
  shiftEnd       DateTime?
  status         EventStaffAssignmentStatus @default(PLANNED)
  notes          String?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt

  @@index([banquetEventId])
}

model PosReservation {
  id            String               @id @default(uuid())
  resourceId    String
  resource      PosResource          @relation(fields: [resourceId], references: [id])
  reservationId String?
  reservation   Reservation?         @relation(fields: [reservationId], references: [id])
  guestName     String?
  startAt       DateTime
  endAt         DateTime
  partySize     Int                  @default(2)
  status        PosReservationStatus @default(BOOKED)
  notes         String?
  createdAt     DateTime             @default(now())

  @@index([resourceId, startAt])
}

/// External era-fb-pos shift (Z not closed) — blocks night audit when OPEN
enum PosBridgeShiftStatus {
  OPEN
  CLOSED
}

model PosBridgeShift {
  id              String               @id @default(uuid())
  externalShiftId String
  outletCode      String
  propertyCode    String?
  status          PosBridgeShiftStatus @default(OPEN)
  openedAt        DateTime
  closedAt        DateTime?
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt

  @@unique([outletCode, externalShiftId])
  @@index([status])
}

/// Room charge idempotency from fb-pos (Idempotency-Key / externalTicketId)
model PosRoomChargeIdempotency {
  id             String   @id @default(uuid())
  idempotencyKey String   @unique
  folioChargeId  String   @unique
  reservationId  String
  requestHash    String
  createdAt      DateTime @default(now())

  @@index([reservationId])
}

model Warehouse {
  id         String          @id @default(uuid())
  code       String          @unique
  name       String
  movements  StockMovement[]
  createdAt  DateTime        @default(now())
}

model ProductGroup {
  id       String    @id @default(uuid())
  code     String    @unique
  name     String
  products Product[]
}

model Product {
  id           String          @id @default(uuid())
  code         String          @unique
  name         String
  productType  ProductType     @default(STOCK)
  groupId      String?
  group        ProductGroup?   @relation(fields: [groupId], references: [id])
  unit         String          @default("pcs")
  barcode      String?
  price        Decimal?        @db.Decimal(12, 2)
  currency     String?
  revenueGroup String?
  vatRate      Decimal?        @db.Decimal(5, 2)
  lastCost     Decimal?        @db.Decimal(12, 4)
  lastVendor   String?
  active       Boolean         @default(true)
  movements    StockMovement[]
  recipe       Recipe?
  recipeLines  RecipeLine[]    @relation("Ingredient")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
}

model TransferVehicle {
  id            String          @id @default(uuid())
  code          String          @unique
  brand         String
  licensePlate  String
  driverName    String?
  driverPhone   String?
  maxSeats      Int             @default(4)
  active        Boolean         @default(true)
  transferOrders TransferOrder[]
  createdAt     DateTime        @default(now())
}

model TransferOrder {
  id            String              @id @default(uuid())
  reservationId String
  reservation   Reservation         @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  direction     TransferDirection
  flightNo      String?
  pickupAt      DateTime
  vehicleId     String?
  vehicle       TransferVehicle?    @relation(fields: [vehicleId], references: [id])
  status        TransferOrderStatus @default(BOOKED)
  folioCharged  Boolean             @default(false)
  price         Decimal             @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([reservationId])
  @@index([pickupAt])
  @@index([status])
}

enum ConciergeProductCategory {
  EXCURSION
  TICKET
  RESTAURANT_EXT
}

enum ConciergeOrderStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model ConciergeProduct {
  id            String                   @id @default(uuid())
  code          String                   @unique
  name          String
  category      ConciergeProductCategory @default(EXCURSION)
  supplierName  String?
  commissionPct Decimal?                 @db.Decimal(5, 2)
  price         Decimal                  @db.Decimal(12, 2)
  active        Boolean                  @default(true)
  orders        ConciergeOrder[]
  createdAt     DateTime                 @default(now())
}

model ConciergeOrder {
  id            String               @id @default(uuid())
  guestId       String
  guest         Guest                @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation?         @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  productId     String
  product       ConciergeProduct     @relation(fields: [productId], references: [id])
  scheduledAt   DateTime?
  status        ConciergeOrderStatus @default(REQUESTED)
  folioChargeId String?
  notes         String?
  createdAt     DateTime             @default(now())

  @@index([guestId])
  @@index([status])
}

enum DispatchRequestStatus {
  QUEUED
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model DispatchVehicle {
  id        String            @id @default(uuid())
  code      String            @unique
  name      String
  capacity  Int               @default(4)
  active    Boolean           @default(true)
  requests  DispatchRequest[]
  createdAt DateTime          @default(now())
}

model DispatchRequest {
  id          String                @id @default(uuid())
  guestId     String?
  guest       Guest?                @relation(fields: [guestId], references: [id], onDelete: SetNull)
  fromLabel   String
  toLabel     String
  vehicleId   String?
  vehicle     DispatchVehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status      DispatchRequestStatus @default(QUEUED)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime              @default(now())

  @@index([status])
  @@index([guestId])
}

model GuestCrmExtension {
  id              String   @id @default(uuid())
  guestId         String   @unique
  guest           Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  interestsJson   String?  @db.Text
  socialMediaJson String?  @db.Text
  generalCrmNotes String?  @db.Text
  updatedAt       DateTime @updatedAt
}

model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  type        StockMovementType
  qty         Decimal           @db.Decimal(12, 3)
  reference   String?
  createdAt   DateTime          @default(now())

  @@index([productId, warehouseId])
}

model Recipe {
  id        String       @id @default(uuid())
  productId String       @unique
  product   Product      @relation(fields: [productId], references: [id])
  lines     RecipeLine[]
}

model RecipeLine {
  id                  String  @id @default(uuid())
  recipeId            String
  recipe              Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProductId String
  ingredient          Product @relation("Ingredient", fields: [ingredientProductId], references: [id])
  qty                 Decimal @db.Decimal(12, 3)
}

model OutboundEventLog {
  id          String              @id @default(uuid())
  eventType   String
  payloadJson String              @db.Text
  status      OutboundEventStatus @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model YieldRule {
  id              String   @id @default(uuid())
  propertyCode    String
  minOccupancyPct Decimal  @db.Decimal(5, 2)
  rateAdjustment  Decimal  @db.Decimal(5, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())
}

enum ServiceWorkOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ServiceRequestSource {
  GUEST
  STAFF
  RECURRING
}

enum ServicePriority {
  LOW
  NORMAL
  HIGH
}

enum ServiceCadence {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  DATE
  EVENT
}

model MaintenanceWorkOrder {
  id          String                 @id @default(uuid())
  roomId      String?
  room        Room?                  @relation(fields: [roomId], references: [id])
  title       String
  description String?
  category    String?
  priority    ServicePriority        @default(NORMAL)
  source      ServiceRequestSource   @default(STAFF)
  location    String?
  status      ServiceWorkOrderStatus @default(OPEN)
  reportedBy  String?
  assigneeId  String?
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([roomId])
  @@index([status])
}

model RecurringServiceSchedule {
  id          String         @id @default(uuid())
  title       String
  category    String?
  cadence     ServiceCadence
  anchorDate  DateTime?
  eventKey    String?
  roomId      String?
  location    String?
  enabled     Boolean        @default(true)
  nextDueAt   DateTime
  lastRunAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([nextDueAt])
  @@index([enabled])
}

model SatelliteAuditLog {
  id            String   @id @default(uuid())
  userId        String?  @map("user_id")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  changesJson   String   @default("{}") @map("changes_json")
  ipAddress     String?  @map("ip_address")
  integrityHash String?  @map("integrity_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("satellite_audit_logs")
}
