  vehicleId     String?
  vehicle       TransferVehicle?    @relation(fields: [vehicleId], references: [id])
  status        TransferOrderStatus @default(BOOKED)
  folioCharged  Boolean             @default(false)
  price         Decimal             @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  @@index([reservationId])
  @@index([pickupAt])
  @@index([status])
}

model TourTemplate {
  id             String          @id @default(uuid())
  organizationId String
  code           String
  name           String
  defaultAgenda  String          @default("")
  defaultPickup  String?
  defaultReturn  String?
  defaultCapacity Int            @default(20)
  defaultPrice   Decimal         @db.Decimal(12, 2)
  active         Boolean         @default(true)
  departures     TourDeparture[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, code])
  @@index([organizationId])
}

model TourDeparture {
  id             String              @id @default(uuid())
  organizationId String
  templateId     String?
  template       TourTemplate?       @relation(fields: [templateId], references: [id], onDelete: SetNull)
  date           DateTime            @db.Date
  pickupAt       DateTime
  returnAt       DateTime
  agenda         String              @default("")
  meetingPoint   String              @default("")
  guideName      String?
  vehicleId      String?
  vehicle        TransferVehicle?    @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  capacity       Int
  price          Decimal             @db.Decimal(12, 2)
  status         TourDepartureStatus @default(DRAFT)
  bookings       TourBooking[]
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([organizationId, date])
  @@index([vehicleId])
  @@index([status])
}

model TourBooking {
  id             String            @id @default(uuid())
  departureId    String
  departure      TourDeparture     @relation(fields: [departureId], references: [id], onDelete: Cascade)
  reservationId  String
  reservation    Reservation       @relation(fields: [reservationId], references: [id], onDelete: Cascade)
  guestId        String?
  folioChargeId  String?
  folioCharge    FolioCharge?      @relation(fields: [folioChargeId], references: [id], onDelete: SetNull)
  folioPaymentId String?
  status         TourBookingStatus @default(CHARGED)
  notes          String?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([departureId, reservationId])
  @@index([reservationId])
  @@index([status])
}

enum ConciergeOrderStatus {
  REQUESTED
  CONFIRMED
  COMPLETED
  CANCELLED
}

model ConciergeProduct {
  id             String           @id @default(uuid())
  organizationId String          
  code           String
  name           String
  /// HotelLookup CONCIERGE_CATEGORY code
  category       String           @default("EXCURSION")
  supplierName   String?
  commissionPct  Decimal?         @db.Decimal(5, 2)
  price          Decimal          @db.Decimal(12, 2)
  active         Boolean          @default(true)
  orders         ConciergeOrder[]
  createdAt      DateTime         @default(now())

  @@unique([organizationId, code])
  @@index([organizationId])
}

model ConciergeOrder {
  id            String               @id @default(uuid())
  guestId       String
  guest         Guest                @relation(fields: [guestId], references: [id], onDelete: Cascade)
  reservationId String?
  reservation   Reservation?         @relation(fields: [reservationId], references: [id], onDelete: SetNull)
  productId     String
  product       ConciergeProduct     @relation(fields: [productId], references: [id])
  scheduledAt   DateTime?
  status        ConciergeOrderStatus @default(REQUESTED)
  folioChargeId String?
  notes         String?
  createdAt     DateTime             @default(now())

  @@index([guestId])
  @@index([status])
}

enum DispatchRequestStatus {
  QUEUED
  ASSIGNED
  IN_PROGRESS
  DONE
  CANCELLED
}

model DispatchVehicle {
  id             String            @id @default(uuid())
  organizationId String           
  code           String
  name           String
  capacity       Int               @default(4)
  active         Boolean           @default(true)
  requests       DispatchRequest[]
  createdAt      DateTime          @default(now())

  @@unique([organizationId, code])
  @@index([organizationId])
}

model DispatchRequest {
  id          String                @id @default(uuid())
  guestId     String?
  guest       Guest?                @relation(fields: [guestId], references: [id], onDelete: SetNull)
  fromLabel   String
  toLabel     String
  vehicleId   String?
  vehicle     DispatchVehicle?      @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  status      DispatchRequestStatus @default(QUEUED)
  notes       String?
  completedAt DateTime?
  createdAt   DateTime              @default(now())

  @@index([status])
  @@index([guestId])
}

model GuestCrmExtension {
  id              String   @id @default(uuid())
  guestId         String   @unique
  guest           Guest    @relation(fields: [guestId], references: [id], onDelete: Cascade)
  interestsJson   String?  @db.Text
  socialMediaJson String?  @db.Text
  generalCrmNotes String?  @db.Text
  updatedAt       DateTime @updatedAt
}

model StockMovement {
  id          String            @id @default(uuid())
  productId   String
  product     Product           @relation(fields: [productId], references: [id])
  warehouseId String
  warehouse   Warehouse         @relation(fields: [warehouseId], references: [id])
  type        StockMovementType
  qty         Decimal           @db.Decimal(12, 3)
  reference   String?
  createdAt   DateTime          @default(now())

  @@index([productId, warehouseId])
}

model Recipe {
  id        String       @id @default(uuid())
  productId String       @unique
  product   Product      @relation(fields: [productId], references: [id])
  lines     RecipeLine[]
}

model RecipeLine {
  id                  String  @id @default(uuid())
  recipeId            String
  recipe              Recipe  @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  ingredientProductId String
  ingredient          Product @relation("Ingredient", fields: [ingredientProductId], references: [id])
  qty                 Decimal @db.Decimal(12, 3)
}

model OutboundEventLog {
  id          String              @id @default(uuid())
  eventType   String
  payloadJson String              @db.Text
  status      OutboundEventStatus @default(PENDING)
  attempts    Int                 @default(0)
  lastError   String?
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt
}

model YieldRule {
  id              String   @id @default(uuid())
  organizationId  String  
  propertyCode    String
  minOccupancyPct Decimal  @db.Decimal(5, 2)
  rateAdjustment  Decimal  @db.Decimal(5, 2)
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([organizationId])
}

enum ServiceWorkOrderStatus {
  OPEN
  IN_PROGRESS
  DONE
  CANCELLED
}

enum ServiceRequestSource {
  GUEST
  STAFF
  RECURRING
}

enum ServicePriority {
  LOW
  NORMAL
  HIGH
}

enum ServiceCadence {
  DAILY
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
  DATE
  EVENT
}

model MaintenanceWorkOrder {
  id             String                 @id @default(uuid())
  organizationId String                
  roomId         String?
  room        Room?                  @relation(fields: [roomId], references: [id])
  title       String
  description String?
  category    String?
  priority    ServicePriority        @default(NORMAL)
  source      ServiceRequestSource   @default(STAFF)
  location    String?
  status      ServiceWorkOrderStatus @default(OPEN)
  reportedBy  String?
  assigneeId  String?
  completedAt DateTime?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([roomId])
  @@index([status])
  @@index([organizationId])
}

model RecurringServiceSchedule {
  id             String         @id @default(uuid())
  organizationId String        
  title          String
  category    String?
  cadence     ServiceCadence
  anchorDate  DateTime?
  eventKey    String?
  roomId      String?
  location    String?
  enabled     Boolean        @default(true)
  nextDueAt   DateTime
  lastRunAt   DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([nextDueAt])
  @@index([enabled])
  @@index([organizationId])
}

model SatelliteAuditLog {
  id            String   @id @default(uuid())
  organizationId String
  userId        String?  @map("user_id")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  changesJson   String   @default("{}") @map("changes_json")
  ipAddress     String?  @map("ip_address")
  integrityHash String?  @map("integrity_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("satellite_audit_logs")
  @@index([organizationId])
}

/// Versioned BAR / unit-economics building blocks (service fee, meals, COGS).
enum PricingComponentKind {
  SERVICE_FEE
  MEAL
  FOOD_COGS
  MEDICAL_COGS
  OTHER
}

enum PricingAmountUnit {
  PER_PERSON_NIGHT
  PER_PERSON_MEAL
  PER_PERSON_DAY
}

model RatePlanSellVersion {
  id            String    @id @default(uuid())
  ratePlanId    String
  ratePlan      RatePlan  @relation(fields: [ratePlanId], references: [id], onDelete: Cascade)
  sellPrice     Decimal   @db.Decimal(12, 2)
  costFloor     Decimal?  @db.Decimal(12, 2)
  currencyCode  String    @default("AZN")
  /// Adults included in this sell/floor quote (1 = single, 2 = double)
  occupancy     Int       @default(1)
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdById   String?
  createdAt     DateTime  @default(now())

  @@index([ratePlanId, occupancy, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

model PricingComponent {
  id             String               @id @default(uuid())
  organizationId String              
  code           String
  name           String
  kind           PricingComponentKind
  unit           PricingAmountUnit
  sortOrder      Int                  @default(0)
  active         Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  versions       PricingComponentVersion[]

  @@unique([organizationId, code])
  @@index([kind, sortOrder])
  @@index([organizationId])
}

model PricingComponentVersion {
  id            String           @id @default(uuid())
  componentId   String
  component     PricingComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  sellAmount    Decimal?         @db.Decimal(12, 2)
  cogsAmount    Decimal?         @db.Decimal(12, 2)
  currencyCode  String           @default("AZN")
  effectiveFrom DateTime
  effectiveTo   DateTime?
  note          String?
  createdById   String?
  createdAt     DateTime         @default(now())

  @@index([componentId, effectiveFrom])
  @@index([effectiveFrom, effectiveTo])
}

enum ElektrawebOutboxSource {
  CLINIC
  FNB
}

enum ElektrawebOutboxStatus {
  PENDING
  SENDING
  POSTED
  FAILED
  CANCELLED
}

/// Per-org Elektraweb dual-run policy (Super-Admin / Sync). Not process env.
model ElektrawebBridgePolicy {
  organizationId      String   @id
  inboundEnabled      Boolean  @default(false)
  writeEnabled        Boolean  @default(false)
  elektrawebHotelId   Int?
  spaDepId            Int?
  spaCurrencyId       Int?
  walkinResId         String?
  walkinResNameId     String?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

/// Dual-run SPA extra tickets waiting for the sanatorium extension to Insert into Elektraweb.
model ElektrawebFolioOutbox {
  id                    String                  @id @default(cuid())
  organizationId        String
  source                ElektrawebOutboxSource
  idempotencyKey        String
  patientOrigin         String
  reservationId         String?
  elektrawebResNameId   String
  elektrawebResId       String?
  elektrawebRevId       String
  procedureCode         String?
  procedureName         String?
  amount                Decimal                 @db.Decimal(12, 2)
  description           String
  insertPayload         Json
  status                ElektrawebOutboxStatus  @default(PENDING)
  elektrawebLineId      String?
  lastError             String?
  postedAt              DateTime?
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt

  @@unique([organizationId, idempotencyKey])
  @@index([organizationId, status, createdAt])
}
