model Reservation {
  id            String            @id @default(uuid())
  organizationId String
  externalRef   String?
  /// Stay-guest Elektraweb `RESNAMEID` (SPA Save key). Hotel `RESID` stays on `externalRef`.
  elektrawebResNameId String?
  roomTypeId    String
  roomType      RoomType          @relation(fields: [roomTypeId], references: [id])
  roomId        String?
  room          Room?             @relation(fields: [roomId], references: [id])
  guestId       String
  guest         Guest             @relation(fields: [guestId], references: [id])
  ratePlanId    String
  ratePlan      RatePlan          @relation(fields: [ratePlanId], references: [id])
  mealPlanId    String?
  mealPlan      MealPlan?         @relation(fields: [mealPlanId], references: [id])
  sourceId      String?
  source        BookingSource?    @relation(fields: [sourceId], references: [id])
  agencyId      String?
  agency        Agency?           @relation(fields: [agencyId], references: [id])
  groupId       String?
  group         ReservationGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  salesContractId String?
  salesContract SalesContract?  @relation(fields: [salesContractId], references: [id], onDelete: SetNull)
  checkInDate   DateTime
  checkOutDate  DateTime
  status        ReservationStatus @default(CONFIRMED)
  paymentMethod PaymentMethod
  totalAmount   Decimal           @default(0) @db.Decimal(12, 2)
  creditLimitAzn Decimal?         @db.Decimal(12, 2)
  voucherNo     String?
  /** @deprecated variant A: always 1 for new stays — multi-room = N Reservation rows under ReservationGroup */
  roomCount     Int               @default(1)
  adults        Int               @default(1)
  children11_6  Int               @default(0)
  children5_2   Int               @default(0)
  children1_0   Int               @default(0)
  extraBeds     Int               @default(0)
  linenEveryNights Int?
  deepEveryNights  Int?
  market        String?
  segment       String?
  rateType      String?
  booker        String?
  bookerGuestId String?
  bookerGuest   Guest?            @relation("ReservationBooker", fields: [bookerGuestId], references: [id], onDelete: SetNull)
  guestRep      String?
  paidBy        String?
  vipType       String?
  accomType     String?
  recordType    String?
  specialStates String?
  tripReason    String?
  resGroup      String?
  colorCode     String?
  resNo         String?
  shareNo       String?
  /** FO opted into shared-twin assignment (union singles). Not the Elektraweb shareNo label. */
  shareEligible Boolean           @default(false)
  /** M | F — locked from guest gender when shareEligible; required before confirm consumes inventory. */
  shareGender   String?
  /** Bed slot 1|2 on assigned door after share assign. */
  shareBedIndex Int?
  /** PRIMARY = one folio owner; EQUAL = each party member has own GUEST folio. */
  partyBillingMode PartyBillingMode @default(PRIMARY)
  optionDate    DateTime?
  optionState   String?
  salesProject  String?
  useManualRate Boolean           @default(false)
  manualDailyRate Decimal?        @db.Decimal(12, 2)
  discountPercent Decimal?        @db.Decimal(5, 2)
  discountActive  Boolean         @default(false)
  isLocked        Boolean         @default(false)
  preferredLocation String?
  preferredBed      String?
  givenRoomTypeId   String?
  givenRoomType     RoomType?       @relation("GivenRoomType", fields: [givenRoomTypeId], references: [id], onDelete: SetNull)
  contractRef       String?
  /** Resolved Nafta medical SKU (PKG-STANDART|…) when unanimous across pax; null if mix/unresolved. */
  medicalPackageCode String?
  /** True when FO notes/agency did not yield a single SKU for check-in programCode. */
  medicalPackageUnresolved Boolean @default(true)
  stay          Stay?
  attachments   ReservationAttachment[]
  paxGuests     ReservationGuest[]
  notes         ReservationNote[]
  dailyRates    ReservationDailyRate[]
  staySlices    ReservationStaySlice[]
  roomChanges   RoomChangePlan[]
  folios        Folio[]
  folioSettlements FolioSettlement[]
  folioDeposits FolioDeposit[]
  cardAuthorizations CardAuthorization[]
  channelErrors ChannelSyncError[]
  medicalOrders   MedicalOrder[]
  medicalAlerts   MedicalAlert[]
  fiscalDocuments   FiscalDocument[]
  tourismSubmissions TourismSubmission[]
  posReservations   PosReservation[]
  procedureAppointments ProcedureAppointment[]
  transferOrders    TransferOrder[]
  tourBookings      TourBooking[]
  conciergeOrders   ConciergeOrder[]
  banquetEvents     BanquetEvent[]
  paymentCards      ReservationPaymentCard[]
  packageLines      ReservationPackageLine[]
  tasks             ReservationTask[]
  folioRoutingOverrides ReservationFolioRoutingOverride[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  @@index([status])
  @@index([roomId])
  @@index([guestId])
  @@index([bookerGuestId])
  @@index([roomTypeId])
  @@index([agencyId])
  @@index([groupId])
  @@index([salesContractId])
  @@unique([organizationId, externalRef])
  @@index([organizationId])
  @@index([elektrawebResNameId])
}

