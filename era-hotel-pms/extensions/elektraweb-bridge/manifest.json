{
  "manifest_version": 3,
  "name": "ERA Elektraweb Bridge",
  "version": "0.3.3",
  "description": "Temporary dual-run: Elektraweb ↔ ERA (inbound mirror + sanatorium SPA extra Insert)",
  "permissions": ["storage", "alarms"],
  "host_permissions": [
    "https://app.elektraweb.com/*",
    "https://*.elektraweb.com/*",
    "http://localhost:3201/*",
    "http://127.0.0.1:3201/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ERA Elektraweb Bridge",
    "default_icon": {
      "16": "icons/lamp-gray-16.png",
      "32": "icons/lamp-gray-32.png"
    }
  },
  "icons": {
    "16": "icons/lamp-gray-16.png",
    "32": "icons/lamp-gray-32.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": ["https://app.elektraweb.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://app.elektraweb.com/*"],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://app.elektraweb.com/*"],
      "js": ["overlay.js"],
      "run_at": "document_idle",
      "type": "module"
    }
  ]
}
