{
  "manifest_version": 3,
  "name": "ERA Elektraweb Bridge",
  "version": "0.3.8",
  "description": "Temporary dual-run: Elektraweb ↔ ERA (inbound mirror + sanatorium SPA extra Insert)",
  "permissions": ["storage", "alarms", "scripting", "tabs", "webNavigation"],
  "host_permissions": [
    "https://app.elektraweb.com/*",
    "https://*.elektraweb.com/*",
    "https://elektraweb.com/*",
    "http://localhost:3201/*",
    "http://127.0.0.1:3201/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "ERA Elektraweb Bridge",
    "default_icon": {
      "16": "icons/lamp-gray-16.png",
      "32": "icons/lamp-gray-32.png"
    }
  },
  "icons": {
    "16": "icons/lamp-gray-16.png",
    "32": "icons/lamp-gray-32.png"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "web_accessible_resources": [
    {
      "resources": [
        "overlay.js",
        "overlay-frame.html",
        "overlay-frame.js",
        "i18n.js",
        "lamp.js"
      ],
      "matches": [
        "https://app.elektraweb.com/*",
        "https://*.elektraweb.com/*",
        "https://elektraweb.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://app.elektraweb.com/*",
        "https://*.elektraweb.com/*",
        "https://elektraweb.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://app.elektraweb.com/*",
        "https://*.elektraweb.com/*",
        "https://elektraweb.com/*"
      ],
      "js": ["injected.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": [
        "https://app.elektraweb.com/*",
        "https://*.elektraweb.com/*",
        "https://elektraweb.com/*"
      ],
      "js": ["overlay-boot.js"],
      "run_at": "document_idle",
      "all_frames": true,
      "match_about_blank": true
    }
  ]
}
