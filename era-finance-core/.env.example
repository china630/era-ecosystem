# Control plane (era-orchestrator API :4000). Finance API is :4100 — do not swap.
API_PORT=4100
NEXT_PUBLIC_API_URL=http://127.0.0.1:4100
CONTROL_PLANE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_CONTROL_PLANE_URL=http://127.0.0.1:4000
CONTROL_PLANE_SERVICE_TOKEN=dev-control-plane-token
# Orchestrator MDM FIN lookup + cross-deploy network docs (4_orchestrator)
ORCHESTRATOR_INTERNAL_URL=http://127.0.0.1:4000
ORCHESTRATOR_SERVICE_TOKEN=dev-control-plane-token
FINANCE_INTERNAL_SERVICE_TOKEN=dev-finance-internal-token
NETWORK_DOCUMENT_TRANSPORT=in_process

# Auth: legacy (Finance JWT) | control-plane (orchestrator JWT)
ERA_AUTH_MODE=legacy
# Proxy RBAC (join-org, access-requests, transfer-ownership) to orchestrator
ERA_CONTROL_PLANE_RBAC_PROXY=true
# Route sales invoice email via orchestrator Notifications Pack (staging: true)
# ERA_NOTIFICATIONS_PACK=true

# ERA Data Hub (reference data — FX, HS, calendar, banks, geo, UoM, tax)
ERA_DATA_HUB_ENABLED=true
ERA_DATA_HUB_URL=http://127.0.0.1:4200
# DATA_HUB_SERVICE_TOKEN=dev-data-hub-service-token
# Hub owns CBAR ingest — finance-side CBAR HTTP/cron removed (Phase 2)
ERA_DATA_HUB_FINANCE_CBAR_INGEST_DISABLED=true

# e-taxes / ASAN / HSM submission (Wave 1 seam ? see docs/adr/etaxes-hsm-asan-submission.md)
# E_TAXES_VAT_SUBMIT_URL=https://gateway.example/etaxes/vat
# E_TAXES_PROFIT_SUBMIT_URL=https://gateway.example/etaxes/profit
# E_TAXES_PAYROLL_SUBMIT_URL=https://gateway.example/etaxes/payroll
# E_TAXES_DSMF_SUBMIT_URL=https://gateway.example/dsmf/payroll
# E_TAXES_OTHER_SUBMIT_URL=https://gateway.example/etaxes/other
# E_TAXES_TAXPAYER_INFO_URL=https://new.e-taxes.gov.az/etaxes/services/taxpayer-info
# ERA_ETAXES_HSM_ENABLED=0
# ERA_HSM_URL=
# ERA_ASAN_GATEWAY_URL=
# Org ASAN ID is stored in Organization.settings.tax.asanUserId (settings UI).
# Super-Admin overrides: system_config keys integrations.etaxes.hsmUrl, integrations.asan.gatewayUrl

# ASAN ?mza / S?MA gov-payload signing (Wave 4 ? see docs/adr/asan-sima-gov-signature.md)
# ASAN_IMZA_API_URL=https://gateway.example/asan/sign
# SIMA_QR_PAYLOAD_URL=https://gateway.example/sima/qr
# ERA_ASAN_SIMA_LIVE=0
# SIGNATURE_GATEWAY_MOCK=1

# e-Qaim? S2S (Wave 4 ? server submit; RPA when disabled ? docs/adr/eqaime-s2s-submission.md)
# ERA_EQAIME_S2S_ENABLED=0
# E_TAXES_EQAIME_SUBMIT_URL=https://gateway.example/etaxes/eqaime

# ?MAS e-m?qavil? S2S (Wave 2 ? server push hire/transfer/terminate; RPA/Excel when disabled)
# ERA_EMAS_S2S_ENABLED=0
# EMAS_SUBMIT_URL=https://gateway.example/emas

# Flexible subconto (Wave 3 ? analytical dimensions on journal entry lines)
# ERA_SUBCONTO_ENABLED=false

# MHBS statutory statements + VAT deposit (Wave 4 ? no extra env; gated by tax_pro module entitlement)
# See docs/adr/mhbs-statement-mapping.md, docs/adr/vat-deposit-routing.md
