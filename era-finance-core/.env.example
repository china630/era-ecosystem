# Control plane (era-orchestrator API)
CONTROL_PLANE_URL=http://127.0.0.1:4000
NEXT_PUBLIC_CONTROL_PLANE_URL=http://127.0.0.1:4000
# CONTROL_PLANE_SERVICE_TOKEN=
# Orchestrator MDM FIN lookup + cross-deploy network docs (4_orchestrator)
ORCHESTRATOR_INTERNAL_URL=http://127.0.0.1:4000
ORCHESTRATOR_SERVICE_TOKEN=dev-control-plane-token
FINANCE_INTERNAL_SERVICE_TOKEN=dev-finance-internal-token
NETWORK_DOCUMENT_TRANSPORT=in_process

# Auth: legacy (Finance JWT) | control-plane (orchestrator JWT)
ERA_AUTH_MODE=legacy
# Proxy RBAC (join-org, access-requests, transfer-ownership) to orchestrator
ERA_CONTROL_PLANE_RBAC_PROXY=true
# Route sales invoice email via orchestrator Notifications Pack (staging: true)
# ERA_NOTIFICATIONS_PACK=true
