{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "channel": "preview",
      "autoIncrement": true,
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_CLINIC_URL": "https://clinic.era-365.online",
        "EXPO_PUBLIC_UPDATE_URL": "${EXPO_PUBLIC_UPDATE_URL}",
        "EXPO_PUBLIC_KIOSK_PIN": "${EXPO_PUBLIC_KIOSK_PIN}"
      }
    }
  }
}
