{
  "name": "@era/satellite-kit",
  "version": "0.0.1",
  "private": true,
  "description": "Shared helpers for ERA industry satellites — orchestrator gateway, DESIGN.md UI kit",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./orchestrator-gateway": {
      "types": "./dist/orchestrator-gateway.d.ts",
      "default": "./dist/orchestrator-gateway.js"
    },
    "./ui": {
      "types": "./dist/ui/index.d.ts",
      "default": "./dist/ui/index.js"
    },
    "./platform/industry-modules": {
      "types": "./dist/platform/industry-modules.d.ts",
      "default": "./dist/platform/industry-modules.js"
    },
    "./platform/workspace-system-catalog": {
      "types": "./dist/platform/workspace-system-catalog.d.ts",
      "default": "./dist/platform/workspace-system-catalog.js"
    },
    "./auth/sso-launch": {
      "types": "./dist/auth/sso-launch.d.ts",
      "default": "./dist/auth/sso-launch.js"
    },
    "./integration/finance-deep-links": {
      "types": "./dist/integration/finance-deep-links.d.ts",
      "default": "./dist/integration/finance-deep-links.js"
    },
    "./auth/middleware-edge": {
      "types": "./dist/auth/middleware-edge.d.ts",
      "default": "./dist/auth/middleware-edge.js"
    },
    "./auth/platform-super-admin": {
      "types": "./dist/auth/platform-super-admin.d.ts",
      "default": "./dist/auth/platform-super-admin.js"
    },

    "./tenancy": {
      "types": "./dist/tenancy/satellite-tenant-extension.d.ts",
      "default": "./dist/tenancy/satellite-tenant-extension.js"
    },
    "./tenancy/boot": {
      "types": "./dist/tenancy/organization-bind-core.d.ts",
      "default": "./dist/tenancy/organization-bind-core.js"
    },
    "./placement": {
      "types": "./dist/placement/slice-export.d.ts",
      "default": "./dist/placement/slice-export.js"
    },
    "./bff/voen-preview": {
      "types": "./dist/bff/voen-preview-route.d.ts",
      "default": "./dist/bff/voen-preview-route.js"
    },
    "./tailwind-content": "./tailwind-content.js",
    "./icd10/generate": "./icd10/generate-icd10.cjs"
  },
  "sideEffects": false,
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/tenancy/organization-bind-core.test.js dist/tenancy/satellite-tenant-extension.test.js dist/tenancy/satellite-tenant-context.test.js dist/auth/login-user.test.js dist/integration/org-entitlement-gate.test.js dist/placement/slice-export.test.js"
  },
  "dependencies": {
    "@era/fiscal": "file:../era-fiscal",
    "@era/i18n-common": "file:../i18n-common",
    "@era/contracts": "file:../era-contracts",
    "@era/storage": "file:../era-storage",
    "jose": "^6.0.11",
    "lucide-react": "^0.511.0",
    "sonner": "^2.0.3",
    "zod": "^3.25.36"
  },
  "peerDependencies": {
    "axios": "^1.7.0",
    "next": "^14.0.0 || ^15.0.0",
    "next-intl": "^4.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "axios": "^1.9.0",
    "next": "^15.3.3",
    "next-intl": "^4.12.0",
    "react": "^19.1.0",
    "typescript": "^5.7.3"
  }
}
