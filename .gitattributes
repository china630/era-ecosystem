# Normalize line endings & guard against Windows UTF-16LE drift. Text = UTF-8 + LF.
* text=auto eol=lf

*.ts     text eol=lf
*.tsx    text eol=lf
*.js     text eol=lf
*.cjs    text eol=lf
*.mjs    text eol=lf
*.jsx    text eol=lf
*.json   text eol=lf
*.jsonc  text eol=lf
*.md     text eol=lf
*.mdc    text eol=lf
*.css    text eol=lf
*.scss   text eol=lf
*.html   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.prisma text eol=lf
*.sql    text eol=lf
*.sh     text eol=lf
*.env    text eol=lf
*.ps1    text eol=lf

*.bat    text eol=crlf
*.cmd    text eol=crlf

# Binary assets (never touch encoding)
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.webp binary
*.ico  binary
*.pdf  binary
*.woff  binary
*.woff2 binary
*.ttf  binary
*.eot  binary
