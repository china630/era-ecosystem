// era-fb-pos domain — floor, tickets, menu, POS shifts (see doc/02-domain-model.md).
// Folio / night audit remain in era-hotel-pms (bridge API only).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TableStatus {
  FREE
  OCCUPIED
  RESERVED
  DIRTY
}

enum TicketStatus {
  OPEN
  HELD
  PENDING_HUB
  CLOSED
  VOID
}

enum TicketLineKitchenStatus {
  NEW
  FIRED
  IN_PREP
  DONE
  VOID
}

enum PosShiftStatus {
  OPEN
  CLOSED
}

model Outlet {
  id                 String   @id @default(cuid())
  organizationId String @map("organization_id")
  code               String
  name               String
  revenueCenterCode  String   @default("FOOD") @map("revenue_center_code")
  propertyCode       String?  @map("property_code")
  active             Boolean  @default(true)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")
  tables             PosTable[]
  tickets            Ticket[]
  shifts             PosShift[]
  menuCategories     MenuCategory[]
  dailyMenuEntries   DailyMenuEntry[]

  @@map("outlets")
  @@unique([organizationId, code])
  @@index([organizationId])
}

model DeliveryInboxOrder {
  id           String   @id @default(cuid())
  organizationId String @map("organization_id")
  externalRef  String @map("external_ref")
  channel      String   @default("aggregator")
  status       String   @default("NEW")
  payloadJson  String?  @map("payload_json")
  ticketId     String?  @map("ticket_id")
  createdAt    DateTime @default(now()) @map("created_at")

  @@map("delivery_inbox_orders")
  @@unique([organizationId, externalRef])
  @@index([organizationId])
}

model PosTable {
  id              String      @id @default(cuid())
  organizationId String @map("organization_id")
  outletId        String      @map("outlet_id")
  code            String
  name            String
  seats           Int         @default(4)
  zone            String?
  status          TableStatus @default(FREE)
  currentTicketId String?     @unique @map("current_ticket_id")
  createdAt       DateTime    @default(now()) @map("created_at")
  updatedAt       DateTime    @updatedAt @map("updated_at")
  outlet          Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  tickets         Ticket[]    @relation("TableTickets")
  reservations    TableReservation[]

  @@unique([outletId, code])
  @@map("pos_tables")
  @@index([organizationId])
}

model TableReservation {
  id         String   @id @default(cuid())
  organizationId String @map("organization_id")
  tableId    String   @map("table_id")
  startAt    DateTime @map("start_at")
  endAt      DateTime @map("end_at")
  guestName  String?  @map("guest_name")
  partySize  Int      @default(2) @map("party_size")
  createdAt  DateTime @default(now()) @map("created_at")
  table      PosTable @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@index([tableId, startAt])
  @@map("table_reservations")
  @@index([organizationId])
}

model MenuCategory {
  id        String     @id @default(cuid())
  organizationId String @map("organization_id")
  outletId  String     @map("outlet_id")
  name      String
  sortOrder Int        @default(0) @map("sort_order")
  items     MenuItem[]
  outlet    Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@map("menu_categories")
  @@index([organizationId])
}

model MenuItem {
  id         String          @id @default(cuid())
  organizationId String @map("organization_id")
  categoryId String          @map("category_id")
  plu        String
  name       String
  priceAzn   Decimal         @map("price_azn") @db.Decimal(12, 2)
  active     Boolean         @default(true)
  recipeSku  String?         @map("recipe_sku")
  imageUrl   String?         @map("image_url")
  category   MenuCategory    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  lines      TicketLine[]
  dailyEntries DailyMenuEntry[]
  priceHistory MenuItemPrice[]

  @@unique([categoryId, plu])
  @@map("menu_items")
  @@index([organizationId])
}

/// Selling-price journal for menu reporting (catalog history; TicketLine still snapshots sale price).
model MenuItemPrice {
  id            String    @id @default(cuid())
  menuItemId    String    @map("menu_item_id")
  priceAzn      Decimal   @map("price_azn") @db.Decimal(12, 2)
  effectiveFrom DateTime  @map("effective_from")
  effectiveTo   DateTime? @map("effective_to")
  reason        String?
  createdBy     String?   @map("created_by")
  createdAt     DateTime  @default(now()) @map("created_at")
  menuItem      MenuItem  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@index([menuItemId, effectiveFrom])
  @@map("menu_item_prices")
}

model DailyMenuEntry {
  id         String   @id @default(cuid())
  outletId   String   @map("outlet_id")
  menuItemId String   @map("menu_item_id")
  boardDate  DateTime @map("board_date") @db.Date
  sortOrder  Int      @default(0) @map("sort_order")
  isFeatured Boolean  @default(false) @map("is_featured")
  outlet     Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([outletId, menuItemId, boardDate])
  @@index([outletId, boardDate])
  @@map("daily_menu_entries")
}

model Ticket {
  id                      String       @id @default(cuid())
  organizationId String @map("organization_id")
  outletId                String       @map("outlet_id")
  tableId                 String?      @map("table_id")
  status                  TicketStatus @default(OPEN)
  waiterLabel             String?      @map("waiter_label")
  covers                  Int          @default(1)
  guestName               String?      @map("guest_name")
  serviceChannel          String?      @map("service_channel")
  walkInLabel             String?      @map("walk_in_label")
  beoId                   String?      @map("beo_id")
  roomChargeReservationId String?      @map("room_charge_reservation_id")
  settlementPendingId     String?      @map("settlement_pending_id")
  hubFiscalReceiptId      String?      @map("hub_fiscal_receipt_id")
  subtotalAzn             Decimal      @default(0) @map("subtotal_azn") @db.Decimal(12, 2)
  discountPercent         Decimal      @default(0) @map("discount_percent") @db.Decimal(5, 2)
  totalAzn                Decimal      @default(0) @map("total_azn") @db.Decimal(12, 2)
  openedAt                DateTime     @default(now()) @map("opened_at")
  closedAt                DateTime?    @map("closed_at")
  externalRef             String?      @map("external_ref")
  outlet                  Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  table                   PosTable?    @relation("TableTickets", fields: [tableId], references: [id])
  lines                   TicketLine[]

  @@index([outletId, status])
  @@index([beoId])
  @@unique([organizationId, externalRef])
  @@map("tickets")
  @@index([organizationId])
}

model TicketLine {
  id             String                  @id @default(cuid())
  ticketId       String                  @map("ticket_id")
  menuItemId     String?                 @map("menu_item_id")
  description    String
  qty            Int                     @default(1)
  unitPriceAzn   Decimal                 @map("unit_price_azn") @db.Decimal(12, 2)
  kitchenStatus  TicketLineKitchenStatus @default(NEW) @map("kitchen_status")
  courseNumber   Int                     @default(1) @map("course_number")
  scheduledFireAt DateTime?              @map("scheduled_fire_at")
  notes          String?
  ticket         Ticket                  @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  menuItem       MenuItem?               @relation(fields: [menuItemId], references: [id])

  @@index([ticketId])
  @@map("ticket_lines")
}

model PosShift {
  id          String         @id @default(cuid())
  organizationId String @map("organization_id")
  outletId    String         @map("outlet_id")
  status      PosShiftStatus @default(OPEN)
  openedAt    DateTime       @default(now()) @map("opened_at")
  closedAt    DateTime?      @map("closed_at")
  openingCash Decimal        @default(0) @map("opening_cash") @db.Decimal(12, 2)
  outlet      Outlet           @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@index([outletId, status])
  @@map("pos_shifts")
  @@index([organizationId])
}

model StaffRoster {
  id             String   @id @default(cuid())
  organizationId String @map("organization_id")
  staffCode      String @map("staff_code")
  fullName       String   @map("full_name")
  pinHash        String   @map("pin_hash")
  globalPersonId String?  @map("global_person_id")
  financeEmployeeId String? @map("finance_employee_id")
  cpEmploymentId  String? @unique @map("cp_employment_id")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("staff_rosters")
  @@unique([organizationId, staffCode])
  @@index([organizationId])
}

model PinClockEvent {
  id        String   @id @default(cuid())
  organizationId String @map("organization_id")
  staffCode String   @map("staff_code")
  eventType String   @map("event_type")
  clockedAt DateTime @default(now()) @map("clocked_at")

  @@index([staffCode, clockedAt])
  @@map("pin_clock_events")
  @@index([organizationId])
}

model Role {
  id              String @id @default(cuid())
  organizationId String @map("organization_id")
  code            String
  name            String
  permissionsJson String @default("[]") @map("permissions_json")
  users           User[]

  @@map("roles")
  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id                String    @id @default(cuid())
  organizationId String @map("organization_id")
  login             String
  email             String?
  phone             String?   
  fullName          String    @map("full_name")
  passwordHash      String    @map("password_hash")
  roleId            String    @map("role_id")
  role              Role      @relation(fields: [roleId], references: [id])
  globalPersonId    String?   @map("global_person_id")
  financeEmployeeId String?   @map("finance_employee_id")
  cpEmploymentId    String?   @unique @map("cp_employment_id")
  status            String    @default("ACTIVE")
  isCrossSystem     Boolean   @default(false) @map("is_cross_system")
  lastLoginAt       DateTime? @map("last_login_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  @@map("users")
  @@unique([organizationId, login])
  @@unique([organizationId, phone])
  @@index([organizationId])
}

model SatelliteAuditLog {
  id            String   @id @default(cuid())
  organizationId String @map("organization_id")
  userId        String?  @map("user_id")
  entityType    String   @map("entity_type")
  entityId      String   @map("entity_id")
  action        String
  changesJson   String   @default("{}") @map("changes_json")
  ipAddress     String?  @map("ip_address")
  integrityHash String?  @map("integrity_hash")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("satellite_audit_logs")
  @@index([organizationId])
}
