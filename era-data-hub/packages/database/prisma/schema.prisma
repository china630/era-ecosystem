generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum CbarRateStatus {
  PRELIMINARY
  FINAL
}

enum CounterpartyLegalForm {
  LLC
  JSC
  INDIVIDUAL_ENTREPRENEUR
  BRANCH
  REPRESENTATION
  OTHER
}

enum UnitOfMeasureKind {
  PIECE
  WEIGHT
  LENGTH
  VOLUME
  AREA
  TIME
  OTHER
}

enum TaxRateKind {
  VAT
  EXCISE
  SIMPLIFIED
  OTHER
}

/// Production calendar (hub-owned; not in finance core).
model CalendarDay {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  country   String   @default("AZ") @db.Char(2)
  date      DateTime @db.Date
  isWorking Boolean  @map("is_working")
  dayType   String   @map("day_type")
  labelAz   String?  @map("label_az")
  labelRu   String?  @map("label_ru")
  labelEn   String?  @map("label_en")
  source    String   @default("era-data-hub")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([country, date])
  @@index([country, isWorking])
  @@map("calendar_days")
}

model CbarOfficialRate {
  id           String         @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  rateDate     DateTime       @map("rate_date") @db.Date
  currencyCode String         @map("currency_code")
  value        Decimal        @db.Decimal(19, 4)
  nominal      Int
  rate         Decimal        @db.Decimal(19, 8)
  status       CbarRateStatus @default(PRELIMINARY)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")

  @@unique([rateDate, currencyCode])
  @@index([rateDate, status])
  @@map("cbar_official_rates")
}

model GlobalCompanyDirectory {
  id           String                  @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  taxId        String                  @unique @map("tax_id")
  name         String
  legalForm    CounterpartyLegalForm?  @map("legal_form")
  legalAddress String?                 @map("legal_address")
  phone        String?
  directorName String?                 @map("director_name")
  createdAt    DateTime                @default(now()) @map("created_at")
  updatedAt    DateTime                @updatedAt @map("updated_at")

  @@map("global_company_directory")
}

model BankGlossary {
  id                String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  nameAz            String       @map("name_az")
  voen              String       @unique
  code              String       @unique @db.Char(2)
  correspondentIban String?      @unique @map("correspondent_iban")
  swift             String?
  headPhones        String[]     @default([]) @map("head_phones")
  headAddress       String?      @map("head_address")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")
  branches          BankBranch[]

  @@map("bank_glossary")
}

model BankBranch {
  id           String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  bankId       String       @map("bank_id") @db.Uuid
  branchCode   String       @map("branch_code")
  name         String
  swift        String?
  address      String?
  phones       String[]     @default([])
  isHeadOffice Boolean      @default(false) @map("is_head_office")
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  bank         BankGlossary @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@unique([bankId, branchCode])
  @@index([bankId])
  @@map("bank_branches")
}

model CustomsTariffRate {
  id              String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  hsCode          String    @map("hs_code")
  description     String?
  dutyRatePercent Decimal   @map("duty_rate_percent") @db.Decimal(7, 4)
  vatRatePercent  Decimal   @map("vat_rate_percent") @db.Decimal(7, 4)
  excisePercent   Decimal   @default(0) @map("excise_percent") @db.Decimal(7, 4)
  effectiveFrom   DateTime  @map("effective_from") @db.Date
  effectiveTo     DateTime? @map("effective_to") @db.Date
  notes           String?
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@unique([hsCode, effectiveFrom])
  @@map("customs_tariff_rates")
}

model UnitOfMeasure {
  id        String            @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code      String            @unique
  kind      UnitOfMeasureKind
  baseCode  String?           @map("base_code")
  factor    Decimal           @default(1) @db.Decimal(19, 6)
  nameAz    String            @map("name_az")
  nameRu    String            @map("name_ru")
  nameEn    String            @map("name_en")
  isActive  Boolean           @default(true) @map("is_active")
  sortOrder Int               @default(0) @map("sort_order")
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")

  @@map("units_of_measure")
}

/// ISO 4217 currency catalog (SoR). Distinct from CbarOfficialRate (FX rates on a date).
model Currency {
  id        String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code      String   @unique @db.VarChar(3)
  symbol    String
  decimals  Int      @default(2)
  nameAz    String   @map("name_az")
  nameRu    String   @map("name_ru")
  nameEn    String   @map("name_en")
  isActive  Boolean  @default(true) @map("is_active")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("currencies")
}

model Country {
  id           String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  iso2         String   @unique @db.Char(2)
  iso3         String?  @db.Char(3)
  dialingCode  String?  @map("dialing_code")
  currencyCode String?  @map("currency_code")
  nameAz       String   @map("name_az")
  nameRu       String   @map("name_ru")
  nameEn       String   @map("name_en")
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  cities       City[]

  @@map("countries")
}

model City {
  id          String   @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code        String   @unique
  countryIso2 String   @map("country_iso2") @db.Char(2)
  region      String?
  isCapital   Boolean  @default(false) @map("is_capital")
  nameAz      String   @map("name_az")
  nameRu      String   @map("name_ru")
  nameEn      String   @map("name_en")
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  country     Country  @relation(fields: [countryIso2], references: [iso2], onDelete: Cascade)

  @@index([countryIso2, sortOrder])
  @@map("cities")
}

model TaxRate {
  id            String      @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code          String      @unique
  kind          TaxRateKind
  region        String      @default("AZ")
  percent       Decimal     @db.Decimal(7, 4)
  effectiveFrom DateTime    @map("effective_from") @db.Date
  effectiveTo   DateTime?   @map("effective_to") @db.Date
  nameAz        String      @map("name_az")
  nameRu        String      @map("name_ru")
  nameEn        String      @map("name_en")
  sortOrder     Int         @default(0) @map("sort_order")
  isActive      Boolean     @default(true) @map("is_active")
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")

  @@index([kind, region, effectiveFrom])
  @@map("tax_rates")
}
