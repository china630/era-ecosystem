{
  "name": "era-data-hub",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -o -- npm run start:dev -w @era/data-hub-api",
    "build": "npm run build -w @era/data-hub-database && npm run build -w @era/data-hub-api",
    "db:generate": "npm run db:generate -w @era/data-hub-database",
    "db:migrate": "npm run db:migrate -w @era/data-hub-database",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @era/data-hub-database",
    "db:seed": "npm run db:seed -w @era/data-hub-database",
    "db:sync-from-finance": "dotenv -e .env -o -- npm run db:sync-from-finance -w @era/data-hub-database"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
