# ERA Data Hub — local / Docker
API_PORT=4200
NODE_ENV=development

# Phase 1 system of record (era_data_hub)
DATABASE_URL=postgresql://era:era_dev_password@127.0.0.1:5432/era_data_hub?schema=public

# Phase 0 read-only finance replica (D1 — never use primary finance URL for external DaaS reads)
FINANCE_RO_DATABASE_URL=postgresql://era_finance_ro:era_dev_password@127.0.0.1:5432/era_finance?schema=public

# finance_ro | hub (default finance_ro until cutover)
ERA_DATA_HUB_DATA_SOURCE=finance_ro

REDIS_URL=redis://127.0.0.1:6379/4

# Internal ERA services (era-network)
DATA_HUB_SERVICE_TOKEN=dev-data-hub-service-token
CONTROL_PLANE_URL=http://127.0.0.1:4000
CONTROL_PLANE_SERVICE_TOKEN=dev-control-plane-token

# External API keys validated via orchestrator (Wave 7)
PLATFORM_REFERENCE_DATA_MODE=mvp
CONTROL_PLANE_URL=http://127.0.0.1:4000
CONTROL_PLANE_SERVICE_TOKEN=dev-control-plane-token
DATA_HUB_DEV_API_KEYS=dev-data-hub-key

# CBAR ingest (Phase 1 hub SoR)
CBAR_EXTERNAL_FETCH_ENABLED=true
DATA_HUB_FX_DASHBOARD_CODES=["USD","EUR","GBP","RUB"]
DATA_HUB_FX_CBAR_CHECK_CODES=["USD","EUR"]

# Catalog JSON (default: packages/database/catalog in repo)
# DATA_HUB_FINANCE_CATALOG_ROOT=
