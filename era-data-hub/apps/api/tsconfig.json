{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": false,
    "baseUrl": "./",
    "paths": {
      "@era/satellite-kit/time": ["../../../packages/satellite-kit/dist/time/baku"]
    },
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
