{
  "version": 1,
  "hooks": {
    "beforeShellExecution": [
      {
        "command": "node .cursor/hooks/before-shell.mjs",
        "failClosed": true
      }
    ],
    "beforeSubmitPrompt": [
      {
        "command": "node .cursor/hooks/stop-closeout.mjs --baseline"
      }
    ],
    "stop": [
      {
        "command": "node .cursor/hooks/stop-closeout.mjs",
        "loop_limit": 1
      }
    ]
  }
}
