model IntangibleAsset {
  id                   String                       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId       String                       @map("organization_id") @db.Uuid
  name                 String
  inventoryNumber      String                       @map("inventory_number")
  purchaseDate         DateTime                     @map("purchase_date") @db.Date
  purchasePrice        Decimal                      @map("purchase_price") @db.Decimal(19, 4)
  usefulLifeMonths     Int                          @map("useful_life_months")
  salvageValue         Decimal                      @default(0) @map("salvage_value") @db.Decimal(19, 4)
  depreciationMethod   FixedAssetDepreciationMethod @default(STRAIGHT_LINE) @map("depreciation_method")
  status               FixedAssetStatus             @default(ACTIVE)
  bookedAmortization   Decimal                      @default(0) @map("booked_amortization") @db.Decimal(19, 4)
  createdAt            DateTime                     @default(now()) @map("created_at")
  updatedAt            DateTime                     @updatedAt @map("updated_at")
  amortizationMonths   IntangibleAmortizationMonth[]
  organization         Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deletedAt            DateTime?                    @map("deleted_at") @db.Timestamptz(6)
  deletedByUserId      String?                      @map("deleted_by_user_id") @db.Uuid
  deletedReason        String?                      @map("deleted_reason")

  @@unique([organizationId, inventoryNumber])
  @@index([organizationId, purchaseDate])
  @@index([organizationId, deletedAt], map: "intangible_assets_org_deleted_at_idx")
  @@map("intangible_assets")
}

model SubcontoType {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  code           String
  name           String
  kind           SubcontoKind
  isSystem       Boolean      @default(false) @map("is_system")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  accountConfigs AccountSubcontoConfig[]
  dimensions     JournalEntryDimension[]

  @@unique([organizationId, code])
  @@index([organizationId, kind])
  @@map("subconto_types")
}

model AccountSubcontoConfig {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String       @map("organization_id") @db.Uuid
  accountId      String       @map("account_id") @db.Uuid
  subcontoTypeId String       @map("subconto_type_id") @db.Uuid
  sortOrder      Int          @map("sort_order")
  required       Boolean      @default(false)
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  account        Account      @relation(fields: [accountId], references: [id], onDelete: Cascade)
  subcontoType   SubcontoType @relation(fields: [subcontoTypeId], references: [id], onDelete: Cascade)

  @@unique([accountId, sortOrder])
  @@unique([accountId, subcontoTypeId])
  @@index([organizationId, accountId])
  @@map("account_subconto_configs")
}

model JournalEntryDimension {
  id             String       @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  journalEntryId String       @map("journal_entry_id") @db.Uuid
  subcontoTypeId String       @map("subconto_type_id") @db.Uuid
  valueId        String?      @map("value_id") @db.Uuid
  valueRef       String?      @map("value_ref")
  createdAt      DateTime     @default(now()) @map("created_at")
  journalEntry   JournalEntry @relation(fields: [journalEntryId], references: [id], onDelete: Cascade)
  subcontoType   SubcontoType @relation(fields: [subcontoTypeId], references: [id], onDelete: Cascade)

  @@index([journalEntryId])
  @@index([subcontoTypeId, valueId])
  @@map("journal_entry_dimensions")
}

model StatReportDefinition {
  id          String               @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  code        String               @unique
  name        String
  periodKind  StatReportPeriodKind @map("period_kind")
  version     Int                  @default(1)
  mappingJson Json                 @default("{}") @map("mapping_json")
  isActive    Boolean              @default(true) @map("is_active")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")
  exports     StatReportExport[]

  @@index([isActive, code])
  @@map("stat_report_definitions")
}

model ProfitTaxAdjustment {
  id             String                    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  organizationId String                    @map("organization_id") @db.Uuid
  year           Int
  kind           ProfitTaxAdjustmentKind
  code           String
  description    String
  amount         Decimal                   @db.Decimal(19, 4)
  source         ProfitTaxAdjustmentSource
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")
  deletedAt      DateTime?                 @map("deleted_at") @db.Timestamptz(6)
  organization   Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, year])
  @@index([organizationId, deletedAt], map: "profit_tax_adjustments_org_deleted_at_idx")
  @@map("profit_tax_adjustments")
}

enum EqaimeStatus {
  DRAFT
  SUBMITTED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum SubcontoKind {
  COUNTERPARTY
  PROJECT
  COST_CENTER
  ITEM
  EMPLOYEE
  CUSTOM
}

enum TaxDeclarationType {
  SIMPLIFIED_TAX
  VAT
  PROFIT_TAX
  PAYROLL_WITHHOLDING
}
