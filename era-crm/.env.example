DATABASE_URL=postgresql://era:era_dev_password@localhost:5432/era_crm?schema=public
PORT=3303
ORCHESTRATOR_EVENT_URL=http://127.0.0.1:4000
SATELLITE_EVENT_SERVICE_TOKEN=dev-satellite-event-token
# Leave unset so Sync/DB bind wins. Never demo-org.
# ERA_SATELLITE_ORGANIZATION_ID=
AUTH_JWT_SECRET=change-me-min-16-chars
ERA_SSO_SHARED_SECRET=dev-sso-shared-secret
ORCHESTRATOR_URL=http://127.0.0.1:4000
# Integrations (TZ): AES-256-GCM key for tenant secrets — required to enable connections.
# CRM_INTEGRATIONS_KEK=base64-or-hex-32-bytes-minimum
PUBLIC_BASE_URL=http://127.0.0.1:3207
# Optional BullMQ / rate-limit Redis for integration-outbound / integration-inbound
# REDIS_URL=redis://127.0.0.1:6379
# Meta OAuth (Instagram / Messenger / WA Cloud page tokens) — platform only
# META_APP_ID=
# META_APP_SECRET=
# Google OAuth (Gmail + Calendar) — platform only
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# Microsoft Entra OAuth (Graph mail + calendar) — platform only
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
