generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  organizationId String @map("organization_id")
  code String
  name      String
  createdAt DateTime @default(now())
  outlets   Outlet[]
  @@unique([organizationId, code])
  @@index([organizationId])
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadChannel {
  whatsapp
  instagram
  visit
  phone
  other
}

enum PartyKind {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum ProspectType {
  CUSTOMER
  PARTNER
  OTHER
}

/// T1 SatAdmin pick-lists — ADR managed-lists-vs-enums A5
enum CrmLookupKind {
  CHANNEL
  PROSPECT_TYPE
  ACTIVITY_SECTOR
  TASK_TYPE
}

model CrmLookup {
  id        String        @id @default(cuid())
  organizationId String @map("organization_id")
  kind      CrmLookupKind
  code      String
  name      String
  active    Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([organizationId, kind, code])
  @@index([kind, active, sortOrder])
  @@index([organizationId])
}

enum ImportBatchStatus {
  PENDING
  COMPLETED
  FAILED
}

model Outlet {
  id        String   @id @default(cuid())
  organizationId String @map("organization_id")
  tenantId  String
  code      String
  name      String
  preset    String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
  @@index([organizationId])
}

model Lead {
  id              String             @id @default(cuid())
  organizationId String @map("organization_id")
  stage           LeadStage          @default(NEW)
  title           String
  contactRef      String
  channel         LeadChannel        @default(other)
  partyKind       PartyKind          @default(LEGAL_ENTITY)
  taxId           String?
  companyName     String?
  contactPhone    String?
  contactEmail    String?
  globalPersonId  String?
  activitySector  String?
  prospectType    ProspectType       @default(CUSTOMER)
  addressLabel    String?
  sourceRef       String?
  importBatchId   String?
  estimatedAmount Decimal?           @db.Decimal(12, 2)
  counterpartyId  String?
  ownerId         String?
  nextContactAt   DateTime?
  score           Int                @default(0)
  scoreUpdatedAt  DateTime?
  owner           User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  importBatch     ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  visits          Visit[]
  stageHistory    LeadStageHistory[]
  inboxThreads       InboxThread[]
  selectionPackages  SelectionPackage[]
  warrantyCases      WarrantyCase[]
  conversations      Conversation[]
  calls              Call[]
  tasks              Task[]
  activities         Activity[]
  isUnsorted         Boolean            @default(false) @map("is_unsorted")
  pipelineId         String?            @map("pipeline_id")
  stageId            String?            @map("stage_id")
  customJson         String             @default("{}") @map("custom_json")
  pipeline           Pipeline?          @relation(fields: [pipelineId], references: [id], onDelete: SetNull)
  pipelineStage      PipelineStage?     @relation(fields: [stageId], references: [id], onDelete: SetNull)
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  convertedAt        DateTime?

  @@index([ownerId])
  @@index([taxId])
  @@index([prospectType])
  @@index([importBatchId])
  @@index([contactPhone])
  @@index([organizationId])
  @@index([isUnsorted])
  @@index([pipelineId])
}

enum SelectionPackageStatus {
  OPEN
  APPROVED
  CLOSED
}

model SelectionPackage {
  id             String                 @id @default(cuid())
  organizationId String                 @map("organization_id")
  leadId         String
  status         SelectionPackageStatus @default(OPEN)
  allowance      Decimal?               @db.Decimal(12, 2)
  financeContractId String?             @map("finance_contract_id")
  notes          String?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt
  lead           Lead                   @relation(fields: [leadId], references: [id], onDelete: Cascade)
  items          SelectionItem[]

  @@index([organizationId])
  @@index([leadId])
}

model SelectionItem {
  id         String           @id @default(cuid())
  packageId  String
  code       String
  label      String
  status     String           @default("PENDING")
  amount     Decimal?         @db.Decimal(12, 2)
  createdAt  DateTime         @default(now())
  package    SelectionPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)

  @@index([packageId])
}

enum WarrantyCaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
  CLOSED
}

model WarrantyCase {
  id                   String             @id @default(cuid())
  organizationId       String             @map("organization_id")
  leadId               String
  subject              String
  status               WarrantyCaseStatus @default(OPEN)
  partyRef             String?
  constructionProjectId String?           @map("construction_project_id")
  notes                String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
  lead                 Lead               @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([leadId])
}

model ImportBatch {
  id          String            @id @default(cuid())
  organizationId String @map("organization_id")
  fileName    String
  createdBy   String?
  status      ImportBatchStatus @default(PENDING)
  reportJson  String            @default("{}")
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  leads       Lead[]

  @@index([createdAt])
  @@index([organizationId])
}

model LeadStageHistory {
  id        String     @id @default(cuid())
  organizationId String @map("organization_id")
  leadId    String
  fromStage LeadStage?
  toStage   LeadStage
  changedAt DateTime   @default(now())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([organizationId])
}

model PipelineRule {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  name           String
  /// STAGE_ENTER | MESSAGE_IN | NO_ACTIVITY_X_HOURS | FIELD_CHANGED | SCHEDULE
  triggerType    String     @default("STAGE_ENTER") @map("trigger_type")
  triggerStage   LeadStage?
  targetStage    LeadStage
  /// Extra trigger params (hours, field keys, cron, …)
  configJson     String     @default("{}") @map("config_json")
  /// Actions beyond stage move (assign, task, tag, …) — lite executor
  actionJson     String     @default("{}") @map("action_json")
  delayMinutes   Int        @default(0) @map("delay_minutes")
  active         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  @@index([organizationId, triggerType, active])
}

model Visit {
  id           String   @id @default(cuid())
  organizationId String @map("organization_id")
  leadId       String
  notes        String?
  addressLabel String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  visitedAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
  @@index([organizationId])
}

model Role {
  id              String   @id @default(cuid())
  organizationId String @map("organization_id")
  code String
  name            String
  permissionsJson String   @default("[]")
  /// System package seeded by `ensureSystemRoles`; cannot be renamed or deleted.
  isSystem                 Boolean @default(false) @map("is_system")
  cloneFromCode            String? @map("clone_from_code")
  /// 0 = pre-matrix row; its `[]` is the column default and takes a template once.
  permissionCatalogVersion Int     @default(0) @map("permission_catalog_version")
  users           User[]
  @@unique([organizationId, code])
  @@index([organizationId])
}

model User {
  id              String    @id @default(cuid())
  organizationId String @map("organization_id")
  login String
  email           String?
  phone           String?   
  fullName        String
  passwordHash    String
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  status          String    @default("ACTIVE")
  isCrossSystem   Boolean   @default(false) @map("is_cross_system")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  ownedLeads      Lead[]
  @@unique([organizationId, login])
  @@unique([organizationId, phone])
  @@index([organizationId])
}

enum InboxChannel {
  whatsapp
  instagram
}

model InboxThread {
  id            String       @id @default(cuid())
  organizationId String @map("organization_id")
  channel       InboxChannel
  externalRef   String
  leadId        String?
  preview       String?
  lastMessageAt DateTime     @default(now())
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([leadId])
  @@index([lastMessageAt])
  @@index([organizationId])
}

model SatelliteAuditLog {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id")
  action         String
  changesJson    String   @default("{}") @map("changes_json")
  ipAddress      String?  @map("ip_address")
  integrityHash  String?  @map("integrity_hash")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("satellite_audit_logs")
}

// --- Integrations layer (ADR docs/adr/crm/01-integrations-architecture.md) ---

enum IntegrationCategory {
  MESSENGER
  SMS
  EMAIL
  TELEPHONY
  LEAD_FORM
  WEB_CHAT
  CALENDAR
  ANALYTICS
  ADS
  PAYMENT
  AI
  STORAGE
  OTHER
}

enum IntegrationStatus {
  DRAFT
  TESTING
  ACTIVE
  ERROR
  DISABLED
}

model IntegrationConnection {
  id             String              @id @default(cuid())
  organizationId String              @map("organization_id")
  providerKey    String              @map("provider_key")
  category       IntegrationCategory
  displayName    String              @map("display_name")
  publicId       String              @unique @default(cuid()) @map("public_id")
  status         IntegrationStatus   @default(DRAFT)
  enabled        Boolean             @default(false)
  configJson     String              @default("{}") @map("config_json")
  secretsEnc     String?             @map("secrets_enc")
  secretsKeyVer  Int                 @default(1) @map("secrets_key_ver")
  webhookSecret  String?             @map("webhook_secret")
  scopesJson     String              @default("[]") @map("scopes_json")
  oauthExpiresAt DateTime?           @map("oauth_expires_at")
  lastTestAt     DateTime?           @map("last_test_at")
  lastTestOk     Boolean?            @map("last_test_ok")
  lastError      String?             @map("last_error")
  lastEventAt    DateTime?           @map("last_event_at")
  rateLimitJson  String              @default("{}") @map("rate_limit_json")
  defaultOwnerId String?             @map("default_owner_id")
  routingJson    String              @default("{}") @map("routing_json")
  createdBy      String?             @map("created_by")
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")
  conversations  Conversation[]
  calls          Call[]
  inboundEvents  InboundEvent[]
  outbox         IntegrationOutbox[]
  extensions     UserTelephonyExtension[]

  @@index([organizationId, category])
  @@index([organizationId, providerKey])
}

enum ConversationStatus {
  OPEN
  PENDING
  CLOSED
}

model Conversation {
  id             String             @id @default(cuid())
  organizationId String             @map("organization_id")
  connectionId   String             @map("connection_id")
  channel        String
  externalChatId String             @map("external_chat_id")
  contactName    String?            @map("contact_name")
  contactPhone   String?            @map("contact_phone")
  contactHandle  String?            @map("contact_handle")
  leadId         String?            @map("lead_id")
  assigneeId     String?            @map("assignee_id")
  status         ConversationStatus @default(OPEN)
  unreadCount    Int                @default(0) @map("unread_count")
  lastMessageAt  DateTime           @default(now()) @map("last_message_at")
  lastInboundAt  DateTime?          @map("last_inbound_at")
  createdAt      DateTime           @default(now()) @map("created_at")
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id])
  lead           Lead?              @relation(fields: [leadId], references: [id], onDelete: SetNull)
  messages       Message[]

  @@unique([connectionId, externalChatId])
  @@index([organizationId, status, lastMessageAt])
  @@index([leadId])
}

enum MessageDirection {
  IN
  OUT
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED
}

model Message {
  id             String           @id @default(cuid())
  organizationId String           @map("organization_id")
  conversationId String           @map("conversation_id")
  direction      MessageDirection
  type           String
  text           String?
  mediaKey       String?          @map("media_key")
  mediaMime      String?          @map("media_mime")
  templateName   String?          @map("template_name")
  payloadJson    String           @default("{}") @map("payload_json")
  externalId     String?          @map("external_id")
  status         MessageStatus
  error          String?
  authorUserId   String?          @map("author_user_id")
  sentAt         DateTime         @default(now()) @map("sent_at")
  conversation   Conversation     @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, externalId])
  @@index([organizationId, sentAt])
}

enum CallDirection {
  INBOUND
  OUTBOUND
  INTERNAL
}

enum CallStatus {
  RINGING
  ANSWERED
  COMPLETED
  MISSED
  BUSY
  FAILED
  NO_ANSWER
}

model Call {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  connectionId   String        @map("connection_id")
  externalCallId String        @map("external_call_id")
  direction      CallDirection
  status         CallStatus
  fromNumber     String?       @map("from_number")
  toNumber       String?       @map("to_number")
  extension      String?
  userId         String?       @map("user_id")
  leadId         String?       @map("lead_id")
  startedAt      DateTime?     @map("started_at")
  answeredAt     DateTime?     @map("answered_at")
  endedAt        DateTime?     @map("ended_at")
  durationSec    Int?          @map("duration_sec")
  talkSec        Int?          @map("talk_sec")
  recordingUrl   String?       @map("recording_url")
  recordingKey   String?       @map("recording_key")
  transcript     String?
  rawJson        String        @default("{}") @map("raw_json")
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id])
  lead           Lead?         @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@unique([connectionId, externalCallId])
  @@index([organizationId, startedAt])
  @@index([leadId])
}

model InboundEvent {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  connectionId   String   @map("connection_id")
  idempotencyKey String   @map("idempotency_key")
  eventType      String?  @map("event_type")
  headersJson    String   @default("{}") @map("headers_json")
  rawBody        String   @map("raw_body")
  status         String   @default("RECEIVED")
  error          String?
  receivedAt     DateTime @default(now()) @map("received_at")
  processedAt    DateTime? @map("processed_at")
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, idempotencyKey])
  @@index([status, receivedAt])
}

model IntegrationOutbox {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  connectionId   String   @map("connection_id")
  kind           String
  idempotencyKey String   @map("idempotency_key")
  payloadJson    String   @map("payload_json")
  status         String   @default("PENDING")
  attempts       Int      @default(0)
  nextAttemptAt  DateTime @default(now()) @map("next_attempt_at")
  lastError      String?  @map("last_error")
  resultJson     String?  @map("result_json")
  createdAt      DateTime @default(now()) @map("created_at")
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, idempotencyKey])
  @@index([status, nextAttemptAt])
}

model UserTelephonyExtension {
  id             String @id @default(cuid())
  organizationId String @map("organization_id")
  connectionId   String @map("connection_id")
  userId         String @map("user_id")
  extension      String
  connection     IntegrationConnection @relation(fields: [connectionId], references: [id])

  @@unique([connectionId, extension])
  @@index([organizationId])
}

// --- Product hygiene (tasks, timeline, pipelines, scope) ---

model Pipeline {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  name           String
  isDefault      Boolean         @default(false) @map("is_default")
  createdAt      DateTime        @default(now()) @map("created_at")
  stages         PipelineStage[]
  leads          Lead[]

  @@index([organizationId])
}

enum PipelineStageKind {
  OPEN
  WON
  LOST
}

model PipelineStage {
  id                String            @id @default(cuid())
  organizationId    String            @map("organization_id")
  pipelineId        String            @map("pipeline_id")
  name              String
  sortOrder         Int               @default(0) @map("sort_order")
  color             String?
  kind              PipelineStageKind @default(OPEN)
  requiredFieldsJson String           @default("[]") @map("required_fields_json")
  legacyStage       LeadStage?        @map("legacy_stage")
  pipeline          Pipeline          @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  leads             Lead[]

  @@index([pipelineId, sortOrder])
  @@index([organizationId])
}

model Task {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  leadId         String?   @map("lead_id")
  assigneeId     String?   @map("assignee_id")
  type           String    @default("FOLLOW_UP")
  title          String
  dueAt          DateTime? @map("due_at")
  doneAt         DateTime? @map("done_at")
  result         String?
  createdAt      DateTime  @default(now()) @map("created_at")
  lead           Lead?     @relation(fields: [leadId], references: [id], onDelete: SetNull)

  @@index([organizationId, dueAt])
  @@index([assigneeId, doneAt])
  @@index([leadId])
}

model Activity {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  leadId         String   @map("lead_id")
  type           String
  payloadJson    String   @default("{}") @map("payload_json")
  authorId       String?  @map("author_id")
  createdAt      DateTime @default(now()) @map("created_at")
  lead           Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId, createdAt])
  @@index([organizationId])
}

model UserGroup {
  id             String          @id @default(cuid())
  organizationId String          @map("organization_id")
  name           String
  members        UserGroupMember[]

  @@unique([organizationId, name])
}

model UserGroupMember {
  id      String    @id @default(cuid())
  groupId String    @map("group_id")
  userId  String    @map("user_id")
  group   UserGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

model Tag {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  leadTags       LeadTag[]

  @@unique([organizationId, name])
}

model LeadTag {
  id     String @id @default(cuid())
  leadId String @map("lead_id")
  tagId  String @map("tag_id")
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([leadId, tagId])
}

model CustomFieldDef {
  id                 String @id @default(cuid())
  organizationId     String @map("organization_id")
  entity             String @default("LEAD")
  key                String
  label              String
  fieldType          String @map("field_type")
  optionsJson        String @default("[]") @map("options_json")
  requiredOnStageIds String @default("[]") @map("required_on_stage_ids")

  @@unique([organizationId, entity, key])
}

model SalesGoal {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String?  @map("user_id")
  groupId        String?  @map("group_id")
  periodStart    DateTime @map("period_start")
  periodEnd      DateTime @map("period_end")
  metric         String
  targetValue    Decimal  @map("target_value") @db.Decimal(14, 2)

  @@index([organizationId, periodStart])
}

model WebhookSubscription {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  url            String
  eventsJson     String   @default("[]") @map("events_json")
  secretEnc      String   @map("secret_enc")
  active         Boolean  @default(true)
  failCount      Int      @default(0) @map("fail_count")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([organizationId, active])
}

model TenantApiKey {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  name           String
  keyHash        String    @map("key_hash")
  scopesJson     String    @default("[]") @map("scopes_json")
  expiresAt      DateTime? @map("expires_at")
  createdAt      DateTime  @default(now()) @map("created_at")

  @@index([organizationId])
  @@unique([organizationId, keyHash])
}

/// Per-org CRM settings (convert side-effects, etc.).
model CrmOrgSettings {
  organizationId           String   @id @map("organization_id")
  convertSideEffectsJson   String   @default("{}") @map("convert_side_effects_json")
  updatedAt                DateTime @updatedAt @map("updated_at")
}

/// Platform-wide CRM KV (KEK, etc.) — not per-org.
model CrmSystemConfig {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("crm_system_config")
}

/// P1-3 scaffold: Contact / Company separate from deal (Lead). MDM/Finance remain SoR for legal identity.
model Company {
  id             String    @id @default(cuid())
  organizationId String    @map("organization_id")
  taxId          String?   @map("tax_id")
  name           String
  createdAt      DateTime  @default(now()) @map("created_at")
  contacts       Contact[]

  @@index([organizationId, taxId])
}

model Contact {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  companyId      String?  @map("company_id")
  fullName       String   @map("full_name")
  phone          String?
  email          String?
  globalPersonId String?  @map("global_person_id")
  createdAt      DateTime @default(now()) @map("created_at")
  company        Company? @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([organizationId, phone])
}
