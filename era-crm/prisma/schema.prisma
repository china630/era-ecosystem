generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id        String   @id @default(cuid())
  code      String   @unique
  name      String
  createdAt DateTime @default(now())
  outlets   Outlet[]
}

enum LeadStage {
  NEW
  CONTACTED
  QUALIFIED
  PROPOSAL
  WON
  LOST
}

enum LeadChannel {
  whatsapp
  instagram
  visit
  phone
  other
}

enum PartyKind {
  INDIVIDUAL
  LEGAL_ENTITY
}

enum ProspectType {
  CUSTOMER
  PARTNER
  OTHER
}

/// T1 SatAdmin pick-lists — ADR managed-lists-vs-enums A5
enum CrmLookupKind {
  CHANNEL
  PROSPECT_TYPE
  ACTIVITY_SECTOR
}

model CrmLookup {
  id        String        @id @default(cuid())
  kind      CrmLookupKind
  code      String
  name      String
  active    Boolean       @default(true)
  sortOrder Int           @default(0)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  @@unique([kind, code])
  @@index([kind, active, sortOrder])
}

enum ImportBatchStatus {
  PENDING
  COMPLETED
  FAILED
}

model Outlet {
  id        String   @id @default(cuid())
  tenantId  String
  code      String
  name      String
  preset    String?
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@unique([tenantId, code])
}

model Lead {
  id              String             @id @default(cuid())
  stage           LeadStage          @default(NEW)
  title           String
  contactRef      String
  channel         LeadChannel        @default(other)
  partyKind       PartyKind          @default(LEGAL_ENTITY)
  taxId           String?
  companyName     String?
  contactPhone    String?
  contactEmail    String?
  globalPersonId  String?
  activitySector  String?
  prospectType    ProspectType       @default(CUSTOMER)
  addressLabel    String?
  sourceRef       String?
  importBatchId   String?
  estimatedAmount Decimal?           @db.Decimal(12, 2)
  counterpartyId  String?
  ownerId         String?
  nextContactAt   DateTime?
  score           Int                @default(0)
  scoreUpdatedAt  DateTime?
  owner           User?              @relation(fields: [ownerId], references: [id], onDelete: SetNull)
  importBatch     ImportBatch?       @relation(fields: [importBatchId], references: [id], onDelete: SetNull)
  visits          Visit[]
  stageHistory    LeadStageHistory[]
  inboxThreads    InboxThread[]
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt
  convertedAt     DateTime?

  @@index([ownerId])
  @@index([taxId])
  @@index([prospectType])
  @@index([importBatchId])
  @@index([contactPhone])
}

model ImportBatch {
  id          String            @id @default(cuid())
  fileName    String
  createdBy   String?
  status      ImportBatchStatus @default(PENDING)
  reportJson  String            @default("{}")
  createdAt   DateTime          @default(now())
  completedAt DateTime?
  leads       Lead[]

  @@index([createdAt])
}

model LeadStageHistory {
  id        String     @id @default(cuid())
  leadId    String
  fromStage LeadStage?
  toStage   LeadStage
  changedAt DateTime   @default(now())
  lead      Lead       @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model PipelineRule {
  id            String   @id @default(cuid())
  name          String
  triggerStage  LeadStage?
  targetStage   LeadStage
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
}

model Visit {
  id           String   @id @default(cuid())
  leadId       String
  notes        String?
  addressLabel String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  visitedAt    DateTime @default(now())
  lead         Lead     @relation(fields: [leadId], references: [id], onDelete: Cascade)

  @@index([leadId])
}

model Role {
  id              String   @id @default(cuid())
  code            String   @unique
  name            String
  permissionsJson String   @default("[]")
  users           User[]
}

model User {
  id              String    @id @default(cuid())
  login           String    @unique
  email           String?
  phone           String?   @unique
  fullName        String
  passwordHash    String
  roleId          String
  role            Role      @relation(fields: [roleId], references: [id])
  status          String    @default("ACTIVE")
  isCrossSystem   Boolean   @default(false) @map("is_cross_system")
  lastLoginAt     DateTime? @map("last_login_at")
  createdAt       DateTime  @default(now()) @map("created_at")
  ownedLeads      Lead[]
}

enum InboxChannel {
  whatsapp
  instagram
}

model InboxThread {
  id            String       @id @default(cuid())
  channel       InboxChannel
  externalRef   String
  leadId        String?
  preview       String?
  lastMessageAt DateTime     @default(now())
  lead          Lead?        @relation(fields: [leadId], references: [id], onDelete: SetNull)
  createdAt     DateTime     @default(now())

  @@index([leadId])
  @@index([lastMessageAt])
}
