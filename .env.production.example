# Production / staging on DigitalOcean (pull-only from GHCR).
# cp .env.production.example .env  && fill secrets  && set IMAGE_TAG from deploy workflow

# --- GHCR (required for docker-compose.prod.yml) ---
GHCR_IMAGE_PREFIX=ghcr.io/your-github-owner/era-ecosystem
IMAGE_TAG=dev-latest

# --- PostgreSQL ---
POSTGRES_USER=era
POSTGRES_PASSWORD=change-me-strong-password_!@19372846
POSTGRES_DB=era

ORCHESTRATOR_DB=era_orchestrator
MDM_DB=era_mdm
FINANCE_DB=era_finance
DATA_HUB_DB=era_data_hub
HOTEL_DB=era_hotel_pms
FNB_POS_DB=era_fnb_pos
RETAIL_POS_DB=era_retail_pos
LOGISTICS_DB=era_logistics
CONSTRUCTION_DB=era_construction
CRM_DB=era_crm
AUTO_SERVICE_DB=era_auto_service
WHOLESALE_DB=era_wholesale
CLINIC_DB=era_clinic

# --- Control plane / SSO ---
# These two must be the same value. Finance SSO provision calls Orch MDM
# with CONTROL_PLANE_SERVICE_TOKEN; Orch checks ORCHESTRATOR_INTERNAL_SERVICE_TOKEN.
CONTROL_PLANE_SERVICE_TOKEN=change-me-control-plane-token_!@19372846
ORCHESTRATOR_INTERNAL_SERVICE_TOKEN=change-me-control-plane-token_!@19372846
ERA_JWT_SECRET=change-me-shared-hs256-secret-min-32-chars_!@19372846
JWT_SECRET=change-me-shared-hs256-secret-min-32-chars_!@19372846
ERA_JWT_ISSUER=era-orchestrator
ERA_JWT_AUDIENCE_FINANCE=era-finance-core
ERA_SSO_SHARED_SECRET=change-me-sso-hmac-secret_!@19372846
ERA_AUTH_MODE=legacy

SATELLITE_EVENT_SERVICE_TOKEN=change-me-satellite-event-token_!@19372846
DATA_HUB_SERVICE_TOKEN=change-me-data-hub-service-token_!@19372846
DATA_HUB_DEV_API_KEYS=
ERA_DATA_HUB_ENABLED=false

# --- Canonical origins (prod) ---
ERA_APP_ORIGIN=https://app.era-365.online
ERA_API_ORIGIN=https://api.era-365.online
ERA_FINANCE_ORIGIN=https://finance-core.era-365.online
ERA_FINANCE_API_ORIGIN=https://finance-api.era-365.online

ERA_HOTEL_PMS_ORIGIN=https://hotel-pms.era-365.online
ERA_FNB_POS_ORIGIN=https://fnb-pos.era-365.online
ERA_CLINIC_ORIGIN=https://clinic.era-365.online
ERA_RETAIL_ORIGIN=https://retail-pos.era-365.online
ERA_LOGISTICS_ORIGIN=https://logistics.era-365.online
ERA_CONSTRUCTION_ORIGIN=https://construction.era-365.online
ERA_CRM_ORIGIN=https://crm.era-365.online
ERA_AUTO_SERVICE_ORIGIN=https://auto-service.era-365.online
ERA_WHOLESALE_ORIGIN=https://wholesale.era-365.online

NEXT_PUBLIC_ORCH_API_URL=https://api.era-365.online
NEXT_PUBLIC_ORCH_WEB_URL=https://app.era-365.online
NEXT_PUBLIC_FINANCE_WEB_URL=https://finance-core.era-365.online
FINANCE_WEB_URL=https://finance-core.era-365.online

POS_BRIDGE_SECRET=change-me-pos-bridge-secret_!@19372846
# Shared staff-provision header x-satellite-bridge-secret (orch + clinic/hotel/fnb).
SATELLITE_BRIDGE_SECRET=change-me-satellite-bridge-secret_!@19372846
# Hotel → clinic lifecycle (x-clinic-bridge-secret). May match SATELLITE_BRIDGE_SECRET.
CLINIC_BRIDGE_SECRET=change-me-clinic-bridge-secret_!@19372846
# Compose overrides these with docker-internal URLs on the orchestrator service.
# Keep public origins on ERA_CLINIC_ORIGIN / launcher registry — not here for fan-out.
CLINIC_API_URL=http://clinic:3203
HOTEL_PMS_API_URL=http://hotel-pms:3201
FNB_POS_API_URL=http://fnb-pos:3202
HOTEL_PMS_URL=https://hotel-pms.era-365.online
RETAIL_POS_URL=https://retail-pos.era-365.online
ERA_FISCAL_PROVIDER=mock
ERA_GUEST_QR_SECRET=change-me-guest-qr-hmac-secret_!@19372846
# Orchestrator → clinic lifecycle fan-out (per-org rows override via admin API)
SATELLITE_FANOUT_TIMEOUT_MS=15000
FNB_POS_WEBHOOK_SECRET=change-me-fnb-pos-webhook-secret_!@19372846
AUTH_JWT_SECRET=change-me-min-32-chars-for-satellites_!@19372846

# Hotel Elektraweb live bridge (HOT-06) — process kill switch. Per-org hotel ids on Super-Admin policy + Sync.
ELEKTRAWEB_BRIDGE_ENABLED=1

DEFAULT_LOCALE=az
ACME_EMAIL=ops@era-365.online
