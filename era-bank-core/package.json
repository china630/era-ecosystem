{
  "name": "era-bank-core",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "dotenv -e .env -o -- npm run start:dev -w @era/bank-core-api",
    "build": "npm run build -w @era/bank-core-database && npm run build -w @era/bank-core-api",
    "test": "npm run test -w @era/bank-core-api",
    "db:generate": "npm run db:generate -w @era/bank-core-database",
    "db:migrate": "npm run db:migrate -w @era/bank-core-database",
    "db:migrate:deploy": "npm run db:migrate:deploy -w @era/bank-core-database",
    "db:seed": "npm run db:seed -w @era/bank-core-database",
    "ref-data:load": "node packages/ref-data-snapshot/load.mjs"
  },
  "devDependencies": {
    "dotenv-cli": "^8.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
