enum AtmTerminalStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AtmTxnStatus {
  PENDING
  AUTHORIZED
  DECLINED
  SETTLED
}

enum SchemeOutboxStatus {
  QUEUED
  SENT
  FAILED
}

enum MarketsBookStatus {
  DRAFT
  BOOKED
  CANCELLED
}

enum BrokerageOrderStatus {
  DRAFT
  SUBMITTED
  FILLED
  CANCELLED
}

enum CsdAccountStatus {
  ACTIVE
  SUSPENDED
}

enum MetalPositionStatus {
  ACTIVE
  CLOSED
}

enum PensionContributionStatus {
  PENDING
  POSTED
}

enum PsaAccountStatus {
  ACTIVE
  CLOSED
}

enum AgencyLinkStatus {
  ACTIVE
  SUSPENDED
}

enum MisReportJobStatus {
  QUEUED
  RUNNING
  COMPLETED
  FAILED
}

enum BpmProcessStatus {
  DRAFT
  ACTIVE
}

enum DmsDocumentStatus {
  DRAFT
  ARCHIVED
}

model AtmTerminal {
  id             String            @id @default(cuid())
  organizationId String            @default("unbound") @map("organization_id")
  bankOrgId      String            @map("bank_org_id")
  terminalId     String            @map("terminal_id")
  branchId       String            @map("branch_id")
  locationName   String            @map("location_name")
  status         AtmTerminalStatus @default(ACTIVE)
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  transactions AtmTxn[]

  @@unique([bankOrgId, terminalId])
  @@index([bankOrgId, status])
  @@index([organizationId])
  @@map("atm_terminals")
}

model AtmTxn {
  id             String       @id @default(cuid())
  organizationId String       @default("unbound") @map("organization_id")
  bankOrgId      String       @map("bank_org_id")
  atmTerminalId  String       @map("atm_terminal_id")
  cardId         String?      @map("card_id")
  amountMinor    BigInt       @map("amount_minor")
  currency       String       @default("AZN")
  txnType        String       @map("txn_type")
  status         AtmTxnStatus @default(PENDING)
  authCode       String?      @map("auth_code")
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  terminal AtmTerminal @relation(fields: [atmTerminalId], references: [id])

  @@index([bankOrgId, status])
  @@index([organizationId])
  @@map("atm_txns")
}

model SchemeMessageOutbox {
  id             String             @id @default(cuid())
  organizationId String             @default("unbound") @map("organization_id")
  bankOrgId      String             @map("bank_org_id")
  messageType    String             @map("message_type")
  direction      String
  payloadJson    Json               @map("payload_json")
  status         SchemeOutboxStatus @default(QUEUED)
  sentAt         DateTime?          @map("sent_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  @@index([bankOrgId, status])
  @@index([organizationId])
  @@map("scheme_message_outbox")
}

