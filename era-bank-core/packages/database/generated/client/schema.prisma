generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

// ─── Kernel enums ───────────────────────────────────────────────────────────

enum GlAccountType {
  ASSET
  LIABILITY
  EQUITY
  INCOME
  EXPENSE
  OFF_BALANCE
}

enum BranchStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum CustomerType {
  NATURAL
  LEGAL
}

enum RiskRating {
  LOW
  MEDIUM
  HIGH
}

enum KycStatus {
  PENDING
  VERIFIED
  REJECTED
  REVIEW
}

enum TrustTier {
  SELF_DECLARED
  DOCUMENT_SCANNED
  GOVERNMENT_VERIFIED
}

enum CustomerStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AccountStatus {
  ACTIVE
  DORMANT
  BLOCKED
  CLOSED
}

enum HoldReason {
  CARD_AUTH
  LEGAL_ARREST
  MANUAL
  PAYMENT_PENDING
}

enum HoldStatus {
  ACTIVE
  RELEASED
  CAPTURED
}

enum TxnType {
  DEPOSIT
  WITHDRAWAL
  TRANSFER
  INTERBRANCH
  INTEREST
  FEE
  FX
  PAYMENT
  REVERSAL
  OPENING
  CONTINGENT
}

enum TxnStatus {
  PENDING
  POSTED
  REJECTED
  REVERSED
}

enum ProductKind {
  CURRENT
  TERM_DEPOSIT
  SAVINGS
  LOAN_ANNUITY
  LOAN_DIFF
  CARD
  CALL_DEPOSIT
  STRUCTURED_DEPOSIT
  LOAN_LINE
  LOAN_MORTGAGE
  LOAN_LEASE
  LOAN_FACTORING
  LOAN_MFI
  LOAN_TRADE
  LOAN_SYNDICATED
  LOAN_PROJECT
  MURABAHA
  MUDARABAH
}

enum ProductStatus {
  DRAFT
  ACTIVE
  RETIRED
}

enum EodStatus {
  RUNNING
  COMPLETED
  FAILED
}

// ─── Payments enums ─────────────────────────────────────────────────────────

enum PaymentRail {
  INTERNAL
  AZIPS
  XOHKS
  AOS
  SWIFT
}

enum PaymentOrderStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SUBMITTED
  SETTLED
  REJECTED
  FAILED
}

// ─── Deposits / loans enums ─────────────────────────────────────────────────

enum DepositStatus {
  ACTIVE
  MATURED
  CLOSED
  EARLY_CLOSED
  PENDING_PRICING_APPROVAL
}

enum LoanStatus {
  DRAFT
  APPROVED
  DISBURSED
  ACTIVE
  OVERDUE
  CLOSED
  WRITTEN_OFF
  PENDING_PRICING_APPROVAL
}

enum InstallmentStatus {
  SCHEDULED
  DUE
  PAID
  OVERDUE
  WAIVED
}

// ─── AML / reg reporting enums ──────────────────────────────────────────────

enum AmlAlertStatus {
  OPEN
  UNDER_REVIEW
  CLOSED
  ESCALATED
}

enum AmlSeverity {
  LOW
  MEDIUM
  HIGH
}

enum FmnReportStatus {
  DRAFT
  FILED
  REJECTED
}

enum RegReportStatus {
  GENERATED
  VALIDATED
  EXPORTED
}

enum FatcaCrsClass {
  US_PERSON
  REPORTABLE
  NON_REPORTABLE
}

// ─── DBO enums ──────────────────────────────────────────────────────────────

enum CredentialStatus {
  ACTIVE
  LOCKED
  DISABLED
}

enum SignatoryRole {
  PRIMARY
  SECONDARY
}

enum SignatoryStatus {
  ACTIVE
  REVOKED
}

// ─── Cards enums ────────────────────────────────────────────────────────────

enum CardScheme {
  VISA
  MASTERCARD
  LOCAL
}

enum CardType {
  DEBIT
  CREDIT_PREPAID
}

enum CardStatus {
  ACTIVE
  BLOCKED
  EXPIRED
  CLOSED
}

enum CardTxnType {
  AUTH
  CAPTURE
  REVERSAL
  REFUND
}

enum CardTxnStatus {
  APPROVED
  DECLINED
  PENDING
  SETTLED
  REVERSED
}

// ─── Treasury enums ─────────────────────────────────────────────────────────

enum CounterpartyType {
  BANK
  CBAR
  BROKER_STUB
}

enum ActiveStatus {
  ACTIVE
  INACTIVE
}

enum NostroDirection {
  NOSTRO
  VOSTRO
}

enum FxDealType {
  SPOT
  FORWARD_STUB
}

enum FxDealStatus {
  BOOKED
  SETTLED
  CANCELLED
}

enum PlacementStatus {
  ACTIVE
  MATURED
  BROKEN
}

enum PositionStatus {
  ACTIVE
  MATURED
  SOLD
}

// ─── Kernel L1 models ───────────────────────────────────────────────────────

model GlAccount {
  id             String        @id @default(cuid())
  organizationId String        @default("unbound") @map("organization_id")
  bankOrgId      String        @map("bank_org_id")
  code           String
  name           String
  type           GlAccountType
  currency       String?
  isPostable     Boolean       @default(true) @map("is_postable")
  parentId       String?       @map("parent_id")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@unique([bankOrgId, code])
  @@index([bankOrgId])
  @@index([organizationId])
  @@map("gl_accounts")
}

/// Bank-wide system GL mapping (nostro, FX transit, MFR, etc.). Product GL lives in ProductTemplate.paramsJson.
model SystemGlConfig {
  id             String   @id @default(cuid())
  organizationId String   @default("unbound") @map("organization_id")
  bankOrgId      String   @map("bank_org_id")
  key            String
  glCode         String   @map("gl_code")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([bankOrgId, key])
  @@index([bankOrgId])
  @@index([organizationId])
  @@map("system_gl_configs")
}

model Branch {
  id             String       @id @default(cuid())
  organizationId String       @default("unbound") @map("organization_id")
  bankOrgId      String       @map("bank_org_id")
  code           String
  name           String
  parentId       String?      @map("parent_id")
  isHeadOffice   Boolean      @default(false) @map("is_head_office")
  status         BranchStatus @default(ACTIVE)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")

  @@unique([bankOrgId, code])
  @@index([bankOrgId])
  @@index([organizationId])
  @@map("branches")
}

model BranchLimit {
  id             String   @id @default(cuid())
  organizationId String   @default("unbound") @map("organization_id")
  bankOrgId      String   @map("bank_org_id")
  branchId       String   @map("branch_id")
  limitCode      String   @map("limit_code")
  amountMinor    BigInt   @map("amount_minor")
  currency       String   @default("AZN")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([bankOrgId, branchId, limitCode])
  @@index([bankOrgId, branchId])
  @@index([organizationId])
  @@map("branch_limits")
}

model BankCustomer {
  id                 String         @id @default(cuid())
  organizationId     String         @default("unbound") @map("organization_id")
  bankOrgId          String         @map("bank_org_id")
  globalPersonId     String?        @map("global_person_id")
  voen               String?
  customerType       CustomerType   @map("customer_type")
  riskRating         RiskRating     @default(LOW) @map("risk_rating")
  pepFlag            Boolean        @default(false) @map("pep_flag")
  /// CAP-AML-ML placeholder score (lab only).
  mlScorePlaceholder Int?           @map("ml_score_placeholder")
  kycStatus          KycStatus      @default(PENDING) @map("kyc_status")
  kycTrustTier       TrustTier      @default(SELF_DECLARED) @map("kyc_trust_tier")
  sourceOfFunds      String?        @map("source_of_funds")
  homeBranchId       String         @map("home_branch_id")
  status             CustomerStatus @default(ACTIVE)
  createdAt          DateTime       @default(now()) @map("created_at")
  updatedAt          DateTime       @updatedAt @map("updated_at")

  beneficialOwners BeneficialOwner[]

  @@index([bankOrgId])
  @@index([globalPersonId])
  @@index([voen])
  @@index([organizationId])
  @@map("bank_customers")
}

model BeneficialOwner {
  id             String   @id @default(cuid())
  organizationId String   @default("unbound") @map("organization_id")
  bankOrgId      String   @map("bank_org_id")
  customerId     String   @map("customer_id")
  globalPersonId String   @map("global_person_id")
  sharePercent   Decimal  @map("share_percent") @db.Decimal(7, 4)
  createdAt      DateTime @default(now()) @map("created_at")

  customer BankCustomer @relation(fields: [customerId], references: [id])

  @@index([customerId])
  @@index([organizationId])
  @@map("beneficial_owners")
}

model Account {
  id                    String        @id @default(cuid())
  organizationId        String        @default("unbound") @map("organization_id")
  bankOrgId             String        @map("bank_org_id")
  iban                  String
  customerId            String        @map("customer_id")
  branchId              String        @map("branch_id")
  glAccountId           String        @map("gl_account_id")
  productId             String?       @map("product_id")
  currency              String
  status                AccountStatus @default(ACTIVE)
  ledgerBalanceMinor    BigInt        @default(0) @map("ledger_balance_minor")
  availableBalanceMinor BigInt        @default(0) @map("available_balance_minor")
  overdraftLimitMinor   BigInt        @default(0) @map("overdraft_limit_minor")
  dailyDebitLimitMinor  BigInt        @default(0) @map("daily_debit_limit_minor")
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")

  holds AccountHold[]

  @@unique([organizationId, iban])
  @@index([bankOrgId])
  @@index([customerId])
  @@index([branchId])
  @@index([organizationId])
  @@map("accounts")
}

model AccountHold {
  id             String     @id @default(cuid())
  organizationId String     @default("unbound") @map("organization_id")
  bankOrgId      String     @map("bank_org_id")
  accountId      String     @map("account_id")
  amountMinor    BigInt     @map("amount_minor")
  reason         HoldReason
  status         HoldStatus @default(ACTIVE)
  reference      String?
  authorityCode  String?    @map("authority_code")
  expiresAt      DateTime?  @map("expires_at")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  account Account @relation(fields: [accountId], references: [id])

  @@index([accountId, status])
  @@index([organizationId])
  @@map("account_holds")
}

model JournalTransaction {
  id             String    @id @default(cuid())
  organizationId String    @default("unbound") @map("organization_id")
  bankOrgId      String    @map("bank_org_id")
  reference      String
  idempotencyKey String    @map("idempotency_key")
  valueDate      DateTime  @map("value_date")
  bookingDate    DateTime  @map("booking_date")
  branchId       String?   @map("branch_id")
  type           TxnType
  status         TxnStatus @default(PENDING)
  makerUserId    String    @map("maker_user_id")
  checkerUserId  String?   @map("checker_user_id")
  reversesId     String?   @map("reverses_id")
  createdAt      DateTime  @default(now()) @map("created_at")

  entries JournalEntry[]

  @@unique([bankOrgId, reference])
  @@unique([organizationId, idempotencyKey])
  @@index([bankOrgId, status])
  @@index([organizationId])
  @@map("journal_transactions")
}

model JournalEntry {
  id             String   @id @default(cuid())
  organizationId String   @default("unbound") @map("organization_id")
  bankOrgId      String   @map("bank_org_id")
  transactionId  String   @map("transaction_id")
  accountId      String?  @map("account_id")
  glAccountId    String   @map("gl_account_id")
  branchId       String   @map("branch_id")
  debitMinor     BigInt   @default(0) @map("debit_minor")
  creditMinor    BigInt   @default(0) @map("credit_minor")
  currency       String
  createdAt      DateTime @default(now()) @map("created_at")

  transaction JournalTransaction @relation(fields: [transactionId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@index([organizationId])
  @@map("journal_entries")
}

model ProductTemplate {
  id             String        @id @default(cuid())
  organizationId String        @default("unbound") @map("organization_id")
  bankOrgId      String        @map("bank_org_id")
  moduleKey      String        @map("module_key")
  kind           ProductKind
  name           String
  currency       String
  paramsJson     Json          @map("params_json")
  status         ProductStatus @default(DRAFT)
  effectiveFrom  DateTime      @map("effective_from")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  @@index([bankOrgId, moduleKey, status])
  @@index([organizationId])
  @@map("product_templates")
}

model EodRun {
  id             String    @id @default(cuid())
  organizationId String    @default("unbound") @map("organization_id")
  bankOrgId      String    @map("bank_org_id")
  businessDate   DateTime  @map("business_date")
  status         EodStatus @default(RUNNING)
  steps          Json      @default("{}")
  balancedAt     DateTime? @map("balanced_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@unique([bankOrgId, businessDate])
  @@index([organizationId])
  @@map("eod_runs")
}

model AuditLogEntry {
  id             String   @id @default(cuid())
  organizationId String   @default("unbound") @map("organization_id")
  bankOrgId      String   @map("bank_org_id")
  entity         String
  entityId       String   @map("entity_id")
  action         String
  beforeJson     Json?    @map("before_json")
  afterJson      Json?    @map("after_json")
  actorUserId    String   @map("actor_user_id")
  at             DateTime @default(now())

  @@index([bankOrgId, entity, entityId])
  @@index([organizationId])
  @@map("audit_log_entries")
}

// ─── Payments L2 ────────────────────────────────────────────────────────────

model PaymentOrder {
  id                   String             @id @default(cuid())
  organizationId       String             @default("unbound") @map("organization_id")
  bankOrgId            String             @map("bank_org_id")
  debtorAccountId      String?            @map("debtor_account_id")
  creditorIban         String             @map("creditor_iban")
  creditorName         String?            @map("creditor_name")
  amountMinor          BigInt             @map("amount_minor")
  currency             String             @default("AZN")
  rail                 PaymentRail        @default(INTERNAL)
  status               PaymentOrderStatus @default(DRAFT)
  idempotencyKey       String             @map("idempotency_key")
  journalTransactionId String?            @map("journal_transaction_id")
  narrative            String?
  createdByUserId      String             @map("created_by_user_id")
  createdAt            DateTime           @default(now()) @map("created_at")
  updatedAt            DateTime           @updatedAt @map("updated_at")

  railMessages PaymentRailMessage[]

  @@unique([organizationId, idempotencyKey])
  @@index([bankOrgId, status])
  @@index([organizationId])
  @@map("payment_orders")
}

model PaymentRailMessage {
  id             String      @id @default(cuid())
  organizationId String      @default("unbound") @map("organization_id")
  bankOrgId      String      @map("bank_org_id")
  paymentOrderId String      @map("payment_order_id")
  direction      String
  rail           PaymentRail
  payloadJson    Json        @map("payload_json")
  createdAt      DateTime    @default(now()) @map("created_at")

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id])

  @@index([paymentOrderId])
  @@index([organizationId])
  @@map("payment_rail_messages")
}

// ─── Deposits L2 ────────────────────────────────────────────────────────────

model DepositContract {
  id                     String        @id @default(cuid())
  organizationId         String        @default("unbound") @map("organization_id")
  bankOrgId              String        @map("bank_org_id")
  accountId              String        @map("account_id")
  customerId             String        @map("customer_id")
  productTemplateId      String        @map("product_template_id")
  principalMinor         BigInt        @map("principal_minor")
  accruedInterestMinor   BigInt        @default(0) @map("accrued_interest_minor")
  /// Contract rate locked at open (annual fraction). EOD accrual uses this, not live product params.
  rateAnnual             Decimal       @default(0) @map("rate_annual") @db.Decimal(9, 6)
  dayCountConvention     String        @default("ACT_365") @map("day_count_convention")
  rateType               String        @default("FIXED") @map("rate_type")
  indexKey               String?       @map("index_key")
  spreadBps              Int?          @map("spread_bps")
  nextResetDate          DateTime?     @map("next_reset_date")
  lastAccrualDate        DateTime?     @map("last_accrual_date")
  currency               String        @default("AZN")
  openedAt               DateTime      @map("opened_at")
  maturityDate           DateTime?     @map("maturity_date")
  status                 DepositStatus @default(ACTIVE)
  adifTagged             Boolean       @default(false) @map("adif_tagged")
  indexLinkKey           String?       @map("index_link_key")
  callNoticeDays         Int?          @map("call_notice_days")
  makerUserId            String?       @map("maker_user_id")
  pricingExceptionReason String?       @map("pricing_exception_reason")
  createdAt              DateTime      @default(now()) @map("created_at")
  updatedAt              DateTime      @updatedAt @map("updated_at")

  @@index([bankOrgId, customerId])
  @@index([accountId])
  @@index([bankOrgId, status])
  @@index([organizationId])
  @@map("deposit_contracts")
}

// ─── Loans L2 ───────────────────────────────────────────────────────────────

model LoanContract {
  id                     String     @id @default(cuid())
  organizationId         String     @default("unbound") @map("organization_id")
  bankOrgId              String     @map("bank_org_id")
  customerId             String     @map("customer_id")
  accountId              String?    @map("account_id")
  productTemplateId      String     @map("product_template_id")
  principalMinor         BigInt     @map("principal_minor")
  outstandingMinor       BigInt     @map("outstanding_minor")
  rateAnnual             Decimal    @default(0) @map("rate_annual") @db.Decimal(9, 6)
  dayCountConvention     String     @default("ACT_365") @map("day_count_convention")
  rateType               String     @default("FIXED") @map("rate_type")
  indexKey               String?    @map("index_key")
  spreadBps              Int?       @map("spread_bps")
  nextResetDate          DateTime?  @map("next_reset_date")
  termMonths             Int?       @map("term_months")
  currency               String     @default("AZN")
  status                 LoanStatus @default(DRAFT)
  ifrs9Stage             Int        @default(1) @map("ifrs9_stage")
  akbScore               Int?       @map("akb_score")
  collateralRef          String?    @map("collateral_ref")
  assetRef               String?    @map("asset_ref")
  invoiceRef             String?    @map("invoice_ref")
  tradeRef               String?    @map("trade_ref")
  projectRef             String?    @map("project_ref")
  participationPct       Decimal?   @map("participation_pct") @db.Decimal(7, 4)
  leadBankName           String?    @map("lead_bank_name")
  disbursedAt            DateTime?  @map("disbursed_at")
  makerUserId            String?    @map("maker_user_id")
  pricingExceptionReason String?    @map("pricing_exception_reason")
  createdAt              DateTime   @default(now()) @map("created_at")
  updatedAt              DateTime   @updatedAt @map("updated_at")

  installments LoanScheduleInstallment[]

  @@index([bankOrgId, customerId])
  @@index([bankOrgId, status])
  @@index([organizationId])
  @@map("loan_contracts")
}

model LoanScheduleInstallment {
  id                 String            @id @default(cuid())
  organizationId     String            @default("unbound") @map("organization_id")
  bankOrgId          String            @map("bank_org_id")
  loanId             String            @map("loan_id")
  sequenceNo         Int               @map("sequence_no")
  dueDate            DateTime          @map("due_date")
  principalMinor     BigInt            @map("principal_minor")
  interestMinor      BigInt            @map("interest_minor")
  paidPrincipalMinor BigInt            @default(0) @map("paid_principal_minor")
  paidInterestMinor  BigInt            @default(0) @map("paid_interest_minor")
  status             InstallmentStatus @default(SCHEDULED)
  paidAt             DateTime?         @map("paid_at")

  loan LoanContract @relation(fields: [loanId], references: [id])

  @@unique([loanId, sequenceNo])
  @@index([organizationId])
  @@map("loan_schedule_installments")
}

// ─── Risk ECL L2 (stage flat-rate MVP — not certified IFRS 9) ────────────────

enum EclRunStatus {
  RUNNING
  COMPLETED
  FAILED
  PENDING_PROVISION_APPROVAL
}

model EclCalculationRun {
  id                  String       @id @default(cuid())
  organizationId      String       @default("unbound") @map("organization_id")
  bankOrgId           String       @map("bank_org_id")
  asOfDate            DateTime     @map("as_of_date")
  status              EclRunStatus @default(RUNNING)
  totalEadMinor       BigInt       @default(0) @map("total_ead_minor")
  totalEclMinor       BigInt       @default(0) @map("total_ecl_minor")
  provisionDeltaMinor BigInt       @default(0) @map("provision_delta_minor")
  postingTxnId        String?      @map("posting_txn_id")
  makerUserId         String?      @map("maker_user_id")
  checkerUserId       String?      @map("checker_user_id")
  methodology         String       @default("STAGE_FLAT") @map("methodology")
  note                String?
  createdAt           DateTime     @default(now()) @map("created_at")
  completedAt         DateTime?    @map("completed_at")

  results EclResult[]

  @@index([bankOrgId, asOfDate])
  @@index([bankOrgId, status])
  @@index([organizationId])
  @@map("ecl_calculation_runs")
}

model EclResult {
  id              String @id @default(cuid())
  organizationId  String @default("unbound") @map("organization_id")
  bankOrgId       String @map("bank_org_id")
  runId           String @map("run_id")
  loanId          String @map("loan_id")
  stage           Int
  eadMinor        BigInt @map("ead_minor")
  eclMinor        BigInt @map("ecl_minor")
  stageRate       Float  @map("stage_rate")
  pd              Float? @map("pd")
  lgd             Float? @map("lgd")
  collateralMinor BigInt @default(0) @map("collateral_minor")

  run EclCalculationRun @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([runId])
  @@index([bankOrgId, loanId])
  @@index([organizationId])
  @@map("ecl_results")
}

model RateIndexQuote {
  id             String   @id @default(cuid())
  organizationId String   @default("unbound") @map("organization_id")
  bankOrgId      String   @map("bank_org_id")
  indexKey       String   @map("index_key")
  asOfDate       DateTime @map("as_of_date")
  rateAnnual     Decimal  @map("rate_annual") @db.Decimal(9, 6)
  source         String   @default("STUB")
  createdAt      DateTime @default(now()) @map("created_at")

  @@unique([bankOrgId, indexKey, asOfDate])
  @@index([bankOrgId, indexKey])
  @@index([organizationId])
  @@map("rate_index_quotes")
}

model RwaSnapshot {
  id             String   @id @default(cuid())
  organizationId String   @default("unbound") @map("organization_id")
  bankOrgId      String   @map("bank_org_id")
  asOfDate       DateTime @map("as_of_date")
  totalRwaMinor  BigInt   @map("total_rwa_minor")
  creditRwaMinor BigInt   @default(0) @map("credit_rwa_minor")
  detailsJson    Json?    @map("details_json")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([bankOrgId, asOfDate])
  @@index([organizationId])
  @@map("rwa_snapshots")
}

model CapitalAdequacySnapshot {
  id                String   @id @default(cuid())
  organizationId    String   @default("unbound") @map("organization_id")
  bankOrgId         String   @map("bank_org_id")
  asOfDate          DateTime @map("as_of_date")
  tier1CapitalMinor BigInt   @map("tier1_capital_minor")
  totalCapitalMinor BigInt   @map("total_capital_minor")
  rwaMinor          BigInt   @map("rwa_minor")
  carRatio          Float    @map("car_ratio")
  tier1Ratio        Float    @map("tier1_ratio")
