# ERA Bank Core — local / Docker
API_PORT=4300
NODE_ENV=development

# Single bank org for this deployment
ERA_BANK_ORGANIZATION_ID=demo-bank-org-001

DATABASE_URL=postgresql://era:era_dev_password@127.0.0.1:5432/era_bank_core?schema=public
REDIS_URL=redis://127.0.0.1:6379/5

# Internal service auth (era-bank satellite → engine)
BANK_CORE_SERVICE_TOKEN=dev-bank-core-service-token
SATELLITE_EVENT_SERVICE_TOKEN=dev-satellite-event-token

# Orchestrator SSO (optional JWT verification)
ERA_JWT_ISSUER=http://127.0.0.1:4000
ERA_JWT_SECRET=dev-jwt-secret-change-in-production

# Reference data
ERA_DATA_HUB_URL=http://127.0.0.1:4200/registry/v1
ERA_DATA_HUB_ONPREM=false
CONTROL_PLANE_URL=http://127.0.0.1:4000

# DBO customer JWT (era-bank-dbo channel; must match era-bank-dbo/.env)
BANK_DBO_JWT_SECRET=change-me-bank-dbo-session-secret-min-32
DEV_OTP_CODE=123456
DBO_DEMO_API_KEY=dbo-demo-api-key-change-in-prod

# Optional module gates (comma-separated; omit = all enabled in dev)
# BANKING_ENABLED_MODULES=banking_core,banking_payments,banking_dbo,banking_aml,banking_regreporting

# PII keys (on-prem bank-held)
PII_ENCRYPTION_KEY=dev-pii-encryption-key-32chars!!
PII_BLIND_INDEX_KEY=dev-pii-blind-index-key-32chars!
