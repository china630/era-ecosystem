# CI / nightly smoke (docker-compose.prod.yml pull-only).
# Used by GitHub Actions: cp .env.ci.example .env.ci
#
# migrate-all.sh already applied schema; skip boot migrate on orchestrator.
SKIP_PRISMA_MIGRATE=1

GHCR_IMAGE_PREFIX=ghcr.io/your-github-owner/era-ecosystem
IMAGE_TAG=dev

POSTGRES_USER=era
POSTGRES_PASSWORD=ci-postgres-password
POSTGRES_DB=era

ORCHESTRATOR_DB=era_orchestrator
MDM_DB=era_mdm
FINANCE_DB=era_finance
DATA_HUB_DB=era_data_hub
HOTEL_DB=era_hotel_pms
FNB_POS_DB=era_fnb_pos
RETAIL_POS_DB=era_retail_pos
LOGISTICS_DB=era_logistics
CONSTRUCTION_DB=era_construction
CRM_DB=era_crm
AUTO_SERVICE_DB=era_auto_service
WHOLESALE_DB=era_wholesale
CLINIC_DB=era_clinic
BANK_CORE_DB=era_bank_core
BANK_SATELLITE_DB=era_bank
BANK_DBO_DB=era_bank_dbo

BANK_CORE_SERVICE_TOKEN=ci-bank-core-service-token
ERA_BANK_ORGANIZATION_ID=demo-bank-org-001
# Hotel/clinic design + bootstrap must not inherit the bank org as tenant context.
ERA_HOTEL_ORGANIZATION_ID=nafta-sanatorium-org
ERA_CLINIC_ORGANIZATION_ID=nafta-sanatorium-org
PII_ENCRYPTION_KEY=ci-pii-encryption-key-32-chars-long!!
PII_BLIND_INDEX_KEY=ci-pii-blind-index-key-32-chars-long!
DBO_JWT_SECRET=ci-dbo-jwt-secret-min-32-characters

CONTROL_PLANE_SERVICE_TOKEN=ci-control-plane-token
ERA_JWT_SECRET=ci-jwt-secret-min-32-characters-long
JWT_SECRET=ci-jwt-secret-min-32-characters-long
ERA_JWT_ISSUER=era-orchestrator
ERA_JWT_AUDIENCE_FINANCE=era-finance-core
ERA_SSO_SHARED_SECRET=ci-sso-hmac-secret-min-32-chars
ERA_AUTH_MODE=legacy
SATELLITE_EVENT_SERVICE_TOKEN=ci-satellite-event-token
DATA_HUB_SERVICE_TOKEN=ci-data-hub-service-token
ERA_DATA_HUB_ENABLED=false

ERA_APP_ORIGIN=http://127.0.0.1:3000
ERA_API_ORIGIN=http://127.0.0.1:4000
ERA_FINANCE_ORIGIN=http://127.0.0.1:3100
NEXT_PUBLIC_ORCH_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_ORCH_WEB_URL=http://127.0.0.1:3000
NEXT_PUBLIC_FINANCE_WEB_URL=http://127.0.0.1:3100
FINANCE_WEB_URL=http://127.0.0.1:3100

POS_BRIDGE_SECRET=ci-pos-bridge-secret
FNB_POS_WEBHOOK_SECRET=ci-fnb-pos-webhook-secret
AUTH_JWT_SECRET=ci-auth-jwt-secret-min-32-chars

DEFAULT_LOCALE=az
