# ERA Ecosystem — root Docker Compose
# cp .env.example .env
# Canonical URLs: docs/ECOSYSTEM_URLS.md

# --- PostgreSQL ---
POSTGRES_USER=era
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=era
POSTGRES_PUBLISH_PORT=5432
ORCHESTRATOR_WEB_PUBLISH_PORT=3000
ORCHESTRATOR_API_PUBLISH_PORT=4000
FINANCE_WEB_PUBLISH_PORT=3100
FINANCE_API_PUBLISH_PORT=4100

# Dev-only module unlock (orchestrator API snapshot — no DB write)
# Local npm dev: ERA_DEV_UNLOCK_ALL_MODULES=true (NODE_ENV=development)
# Local docker UAT: also set ERA_ALLOW_DEV_UNLOCK_IN_PRODUCTION=true
ERA_DEV_UNLOCK_ALL_MODULES=false
ERA_ALLOW_DEV_UNLOCK_IN_PRODUCTION=false

ORCHESTRATOR_DB=era_orchestrator
MDM_DB=era_mdm
FINANCE_DB=era_finance
HOTEL_DB=era_hotel_pms
FNB_POS_DB=era_fnb_pos
RETAIL_POS_DB=era_retail_pos
LOGISTICS_DB=era_logistics
CONSTRUCTION_DB=era_construction
CRM_DB=era_crm
AUTO_SERVICE_DB=era_auto_service
WHOLESALE_DB=era_wholesale
CLINIC_DB=era_clinic
BANK_CORE_DB=era_bank_core
BANK_SATELLITE_DB=era_bank
BANK_DBO_DB=era_bank_dbo

# Legacy DB env (one release)
# FNB_POS_DB=era_fnb_pos
# CRM_DB=era_crm
# AUTO_SERVICE_DB=era_auto_service

# --- Redis ---
REDIS_PUBLISH_PORT=6379

# --- Control plane ↔ data plane (internal) ---
CONTROL_PLANE_SERVICE_TOKEN=dev-control-plane-token
# MDM + FIN lookup (4_orchestrator)
ORCHESTRATOR_INTERNAL_URL=http://orchestrator:4000
ORCHESTRATOR_SERVICE_TOKEN=dev-control-plane-token
ORCHESTRATOR_INTERNAL_SERVICE_TOKEN=dev-control-plane-token
MDM_DATABASE_URL=postgresql://era:change-me-strong-password@postgres:5432/era_mdm
# Finance ↔ orchestrator network docs
FINANCE_INTERNAL_SERVICE_TOKEN=dev-finance-internal-token
NETWORK_DOCUMENT_TRANSPORT=in_process

# --- SSO (HS256 phase A; RS256/JWKS phase A+) ---
ERA_JWT_SECRET=change-me-shared-hs256-secret-min-32-chars
ERA_JWT_ISSUER=era-orchestrator
ERA_JWT_AUDIENCE_FINANCE=era-finance-core
ERA_JWT_ACCESS_EXPIRES=12h
ERA_SSO_SHARED_SECRET=change-me-sso-hmac-secret
ERA_AUTH_MODE=legacy

# --- Platform super-admin bootstrap (dev only; use secrets in prod) ---
PLATFORM_SUPER_ADMIN_EMAILS=inaram84@gmail.com,shirinov.chingiz@gmail.com,chingiz@era.com
PLATFORM_SUPER_ADMIN_BOOTSTRAP_PASSWORD=12345678

# --- Satellite event bus (orchestrator → BullMQ → finance-core) ---
SATELLITE_EVENT_SERVICE_TOKEN=dev-satellite-event-token
SATELLITE_EVENT_REDIS_URL=redis://127.0.0.1:6379/0
# Orchestrator fan-out to clinic (registry fallback when no SatelliteEndpoint row)
CLINIC_API_URL=http://127.0.0.1:3203
CLINIC_BRIDGE_SECRET=dev-clinic-bridge-secret
# SATELLITE_FANOUT_WORKER_DISABLED=1
SATELLITE_FANOUT_TIMEOUT_MS=15000
ERA_EVENT_GATEWAY_MODE=legacy
ORCHESTRATOR_EVENT_URL=http://orchestrator:4000
ERA_SATELLITE_ORGANIZATION_ID=
# Preferred on appliance: Super-admin «Sync satellite bindings» → POST /api/internal/v1/organization/bind
# (persists without editing this env). Optional file override: ERA_ORG_BIND_FILE=
# Nafta sanatorium — legacy per-satellite env aliases (fallback: ERA_SATELLITE_ORGANIZATION_ID)
ERA_HOTEL_ORGANIZATION_ID=
ERA_FB_ORGANIZATION_ID=
ERA_CLINIC_ORGANIZATION_ID=
ERA_RETAIL_ORGANIZATION_ID=
SATELLITE_DEFAULT_COUNTERPARTY_ID=
SATELLITE_GL_RECEIVABLE=201
SATELLITE_GL_REVENUE=601
SATELLITE_GL_WIP=111

# --- Ecosystem i18n (all web nodes) ---
DEFAULT_LOCALE=az

# --- Canonical origins (prod / local hosts) ---
# Local Docker (direct ports): use http://127.0.0.1 — prod: https://*.era-365.online
ERA_APP_ORIGIN=http://127.0.0.1:3000
ERA_API_ORIGIN=http://127.0.0.1:4000
ERA_FINANCE_ORIGIN=http://127.0.0.1:3100
ERA_FINANCE_API_ORIGIN=http://127.0.0.1:4100
ERA_FINANCE_API_INTERNAL_URL=http://finance-core:4100
ERA_FINANCE_API_PUBLIC=false

ERA_HOTEL_PMS_ORIGIN=https://hotel-pms.era-365.online
ERA_FNB_POS_ORIGIN=https://fnb-pos.era-365.online
ERA_CLINIC_ORIGIN=https://clinic.era-365.online
ERA_RETAIL_ORIGIN=https://retail-pos.era-365.online
ERA_LOGISTICS_ORIGIN=https://logistics.era-365.online
ERA_CONSTRUCTION_ORIGIN=https://construction.era-365.online
ERA_CRM_ORIGIN=https://crm.era-365.online
ERA_AUTO_SERVICE_ORIGIN=https://auto-service.era-365.online
ERA_WHOLESALE_ORIGIN=https://wholesale.era-365.online

# --- ERA Data Hub (reference data SoR) ---
ERA_DATA_HUB_URL=http://127.0.0.1:4200
ERA_DATA_HUB_ENABLED=false
ERA_DATA_HUB_DATA_SOURCE=finance_ro
ERA_DATA_HUB_FINANCE_CBAR_INGEST_DISABLED=false
DATA_HUB_SERVICE_TOKEN=dev-data-hub-service-token

# --- Bank CBS (era-bank-core + era-bank + era-bank-dbo) ---
ERA_BANK_ORGANIZATION_ID=demo-bank-org-001
BANK_CORE_SERVICE_TOKEN=dev-bank-core-service-token
BANK_CORE_API_PUBLISH_PORT=4300
BANK_SATELLITE_PUBLISH_PORT=3210
BANK_DBO_PUBLISH_PORT=3211
ERA_BANK_ORIGIN=http://127.0.0.1:3210
ERA_BANK_DBO_ORIGIN=http://127.0.0.1:3211
ERA_BANK_CORE_URL=http://127.0.0.1:4300
BANK_DBO_JWT_SECRET=change-me-dbo-jwt-secret-min-32-chars
# Legacy alias still accepted by docker-compose if BANK_DBO_JWT_SECRET unset:
# DBO_JWT_SECRET=change-me-dbo-jwt-secret-min-32-chars
DEV_OTP_CODE=123456
ERA_DATA_HUB_ONPREM=false
BANK_CORE_RUN_SEED=true
BANK_RUN_SEED=true
BANK_DBO_RUN_SEED=true

# --- Orchestrator web (launcher) — local Docker defaults ---
NEXT_PUBLIC_ORCH_API_URL=http://127.0.0.1:4000
NEXT_PUBLIC_ORCH_WEB_URL=http://127.0.0.1:3000
NEXT_PUBLIC_FINANCE_WEB_URL=http://127.0.0.1:3100
FINANCE_WEB_URL=http://127.0.0.1:3100

# --- Industry satellite deep links (Orch launcher) ---
NEXT_PUBLIC_SATELLITE_RETAIL_URL=https://retail-pos.era-365.online
NEXT_PUBLIC_SATELLITE_HOTEL_URL=https://hotel-pms.era-365.online
NEXT_PUBLIC_SATELLITE_FNB_POS_URL=https://fnb-pos.era-365.online
NEXT_PUBLIC_SATELLITE_LOGISTICS_URL=https://logistics.era-365.online
NEXT_PUBLIC_SATELLITE_CONSTRUCTION_URL=https://construction.era-365.online
NEXT_PUBLIC_SATELLITE_CRM_URL=https://crm.era-365.online
NEXT_PUBLIC_SATELLITE_AUTO_URL=https://auto-service.era-365.online
NEXT_PUBLIC_SATELLITE_CLINIC_URL=https://clinic.era-365.online
NEXT_PUBLIC_SATELLITE_WHOLESALE_URL=https://wholesale.era-365.online
NEXT_PUBLIC_SATELLITE_BANK_URL=http://127.0.0.1:3210

# Legacy satellite URLs (one release)
# NEXT_PUBLIC_SATELLITE_FNB_POS_URL=https://fnb-pos.era-365.online

# --- Hotel PMS ↔ F&B POS bridge ---
POS_BRIDGE_SECRET=dev-pos-bridge-secret
FNB_POS_WEBHOOK_SECRET=dev-fnb-pos-webhook-secret
AUTH_JWT_SECRET=change-me-min-32-chars-for-hotel-pms

# --- Platform storage add-on (@era/storage) ---
PLATFORM_STORAGE_ENABLED=false
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# S3 (prod): STORAGE_DRIVER=s3, S3_BUCKET=, S3_REGION=, AWS_ACCESS_KEY_ID=, AWS_SECRET_ACCESS_KEY=

# --- Local hosts file ---
# 127.0.0.1 era-365.online app.era-365.online api.era-365.online finance-core.era-365.online finance-api.era-365.online
# 127.0.0.1 hotel-pms.era-365.online fnb-pos.era-365.online clinic.era-365.online retail-pos.era-365.online
# 127.0.0.1 logistics.era-365.online construction.era-365.online crm.era-365.online auto-service.era-365.online wholesale.era-365.online
